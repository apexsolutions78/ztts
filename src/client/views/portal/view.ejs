<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Zahabia Customer Portal</title>
  <link rel="icon" type="image/png" href="/brand/LOGO123.png">
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<body style="background-color: var(--bg-main);">
  <div style="background: var(--bg-dark); color: #fff; padding: 1rem 1.5rem;" class="btn-no-print">
    <div style="max-width: 1000px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <img src="/brand/Golden_airplane_circling_globe_20260914222838.gif" alt="Zahabia Airplane" style="height: 40px; border-radius: 8px;" onerror="this.src='/brand/LOGO123.png';">
        <div>
          <h2 style="color: var(--accent-gold); font-size: 1rem; margin: 0;">ZAHABIA TRAVEL & TOURISM</h2>
          <span style="font-size: 0.65rem; color: #a0aec0; text-transform: uppercase;">Customer Travel Portal</span>
        </div>
      </div>
      <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
        <select onchange="location.href='?currency=' + this.value" style="padding: 0.25rem 0.5rem; border-radius: 6px; font-size: 0.8rem; font-weight: 700; background: var(--bg-dark); color: #fff; border: 1px solid var(--accent-gold); cursor: pointer;">
          <option value="PKR" <%= (typeof activeCurrency !== 'undefined' && activeCurrency === 'PKR') ? 'selected' : '' %>>PKR (Rs)</option>
          <option value="USD" <%= (typeof activeCurrency !== 'undefined' && activeCurrency === 'USD') ? 'selected' : '' %>>USD ($)</option>
          <option value="AED" <%= (typeof activeCurrency !== 'undefined' && activeCurrency === 'AED') ? 'selected' : '' %>>AED</option>
          <option value="EUR" <%= (typeof activeCurrency !== 'undefined' && activeCurrency === 'EUR') ? 'selected' : '' %>>EUR</option>
          <option value="GBP" <%= (typeof activeCurrency !== 'undefined' && activeCurrency === 'GBP') ? 'selected' : '' %>>GBP</option>
          <option value="SAR" <%= (typeof activeCurrency !== 'undefined' && activeCurrency === 'SAR') ? 'selected' : '' %>>SAR</option>
        </select>
        <% if (typeof flight !== 'undefined' && flight && flight.ticket_status === 'ticketed') { %>
          <button onclick="window.print()" class="btn btn-accent btn-sm">Print E-Ticket</button>
          <a href="/t/<%= token %>/flight-pdf" target="_blank" class="btn btn-accent btn-sm" style="background: #805ad5; color: #fff;">Download PDF</a>
        <% } %>
      </div>
    </div>
  </div>


  <main class="app-container" style="max-width: 1000px; margin-top: 2rem;">
    <!-- Welcome Header -->
    <div class="card" style="margin-bottom: 2rem; background: linear-gradient(135deg, #ffffff 0%, #f4f8f7 100%);">
      <p class="eyebrow">Zahabia Travel & Tourism</p>
      <h1>Welcome, <%= customer ? customer.full_name : 'Valued Passenger' %></h1>
      <p class="muted">Your travel booking information confirmed by Zahabia Travel & Tourism.</p>
    </div>

    <!-- ========== FLIGHT SECTION — STATUS-GATED ========== -->
    <% if (typeof flight !== 'undefined' && flight) { %>

      <% if (flight.ticket_status === 'ticketed') { %>
      <!-- ===== TICKETED — FULL E-TICKET RECEIPT ===== -->
      <div class="ticket-wrapper">
        <div class="ticket-header">
          <div class="ticket-airline-brand">
            <img src="/brand/LOGO123.png" alt="Airline Brand" style="height: 55px;" onerror="this.src='/brand/Golden_airplane_circling_globe_20260914222838.gif';">
            <div>
              <h2 style="color: var(--accent-gold);"><%= flight.airline %></h2>
              <span style="font-size: 0.8rem; color: #e2ece9; text-transform: uppercase;">ELECTRONIC TICKET RECEIPT</span>
            </div>
          </div>

          <div style="text-align: right;">
            <span style="font-size: 0.75rem; text-transform: uppercase; color: #a0aec0;">PNR / Booking Ref</span>
            <div style="font-family: var(--font-heading); font-size: 2.2rem; font-weight: 800; color: var(--accent-gold);"><%= flight.booking_ref %></div>
          </div>
        </div>

        <div class="ticket-body">
          <% if (typeof liveStatus !== 'undefined' && liveStatus) { %>
            <div style="background: #edf4f2; padding: 0.85rem 1.25rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;" class="btn-no-print">
              <div>
                <span style="font-size: 0.72rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted);">FLIGHT STATUS</span>
                <div style="font-weight: 800; font-size: 1rem; color: var(--primary);">STATUS: <span class="badge badge-<%= liveStatus.statusClass %>"><%= liveStatus.status %></span></div>
              </div>
              <% if (liveStatus.terminal !== 'TBA' || liveStatus.gate !== 'TBA') { %>
              <div style="display: flex; gap: 1.25rem; font-size: 0.85rem;">
                <% if (liveStatus.terminal !== 'TBA') { %><div><strong>Terminal:</strong> <%= liveStatus.terminal %></div><% } %>
                <% if (liveStatus.gate !== 'TBA') { %><div><strong>Gate:</strong> <%= liveStatus.gate %></div><% } %>
                <% if (liveStatus.baggage && liveStatus.baggage !== 'TBA') { %><div><strong>Baggage:</strong> <%= liveStatus.baggage %></div><% } %>
              </div>
              <% } %>
            </div>
          <% } %>

          <div class="flight-route">
            <div>
              <div class="airport-code"><%= flight.origin %></div>
              <div class="airport-name">Departure Airport</div>
            </div>
            <div class="route-divider">
              <div style="font-weight: 700; font-size: 1rem; color: var(--primary);"><%= flight.flight_number %></div>
              <div class="route-line"></div>
              <div style="font-size: 0.82rem; color: var(--text-muted); font-weight: 600;"><%= flight.cabin_class %> Class</div>
            </div>
            <div style="text-align: right;">
              <div class="airport-code"><%= flight.destination %></div>
              <div class="airport-name">Destination Airport</div>
            </div>
          </div>

          <div class="ticket-grid">
            <div class="ticket-field">
              <label>Passenger Name</label>
              <val><%= flight.customer_name %></val>
            </div>
            <div class="ticket-field">
              <label>E-Ticket Number</label>
              <val style="font-family: monospace; font-weight: 700; color: var(--primary);"><%= flight.ticket_number || 'N/A' %></val>
            </div>
            <div class="ticket-field">
              <label>Passport Number</label>
              <val><%= flight.passport_number || 'N/A' %></val>
            </div>
            <div class="ticket-field">
              <label>Departure Date & Time</label>
              <val><%= new Date(flight.departure_date).toLocaleString() %></val>
            </div>
            <div class="ticket-field">
              <label>Arrival Date & Time</label>
              <val><%= flight.arrival_date ? new Date(flight.arrival_date).toLocaleString() : 'TBA' %></val>
            </div>
            <div class="ticket-field">
              <label>Ticket Status</label>
              <val><span class="badge badge-<%= flight.ticket_status %>"><%= flight.ticket_status %></span></val>
            </div>
            <div class="ticket-field">
              <label>Total Fare Paid</label>
              <val><%= formatPrice(flight.total_amount) %></val>
            </div>
          </div>

          <% if (flight.customer_notes) { %>
          <div style="margin-top: 1rem; padding: 0.85rem 1.25rem; background: #fefcbf; border-radius: var(--radius-sm); border: 1px solid #d69e2e;">
            <div style="font-size: 0.72rem; text-transform: uppercase; font-weight: 700; color: #975a16; margin-bottom: 0.3rem;">Your Notes</div>
            <div style="font-size: 0.9rem; color: #744210;"><%= flight.customer_notes %></div>
          </div>
          <% } %>

          <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1.5rem; padding: 1rem; background: #f0f4f8; border-radius: var(--radius-sm); border: 1px dashed #cbd5e0;" class="btn-no-print">
            <div>
              <div style="font-size: 0.72rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted);">E-Ticket Verification</div>
              <div style="font-family: monospace; font-size: 0.9rem; font-weight: 700; color: var(--primary);"><%= token %></div>
              <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.2rem;">Scan to reopen this portal</div>
            </div>
            <img src="/t/<%= token %>/qr" alt="Portal QR Code" style="width: 110px; height: 110px; border: 2px solid var(--primary); border-radius: 8px; padding: 4px; background: #fff;">
          </div>
        </div>
      </div>

      <% } else if (flight.ticket_status === 'confirmed') { %>
      <!-- ===== CONFIRMED — AWAITING TICKET ISSUANCE ===== -->
      <div class="card" style="padding: 2rem; margin-bottom: 1.5rem;">
        <div style="text-align: center; margin-bottom: 1.5rem;">
          <div style="font-size: 3rem; margin-bottom: 0.5rem;">&#9989;</div>
          <h2 style="margin: 0;">Booking Confirmed</h2>
          <p class="muted">Your booking has been confirmed and payment verified.</p>
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; max-width: 500px; margin: 0 auto;">
          <div>
            <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Route</div>
            <div style="font-weight: 700; font-size: 1.1rem;"><%= flight.origin %> &rarr; <%= flight.destination %></div>
          </div>
          <div>
            <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Booking Reference</div>
            <div style="font-weight: 700; font-size: 1.1rem; font-family: monospace;"><%= flight.booking_ref %></div>
          </div>
          <div>
            <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Departure</div>
            <div style="font-weight: 600;"><%= new Date(flight.departure_date).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) %></div>
          </div>
          <div>
            <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Cabin</div>
            <div style="font-weight: 600;"><%= flight.cabin_class %></div>
          </div>
        </div>
        <% if (typeof paymentSummary !== 'undefined' && paymentSummary && paymentSummary.totalAmount > 0) { %>
        <div style="margin-top: 1.5rem; padding: 1rem; background: #f0f4f8; border-radius: var(--radius-sm);">
          <div style="display: flex; justify-content: space-around; text-align: center;">
            <div>
              <div style="font-size: 0.7rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Total Fare</div>
              <div style="font-size: 1.2rem; font-weight: 800; color: var(--primary);"><%= formatPrice(paymentSummary.totalAmount) %></div>
            </div>
            <div>
              <div style="font-size: 0.7rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Paid</div>
              <div style="font-size: 1.2rem; font-weight: 800; color: #38a169;"><%= formatPrice(paymentSummary.totalPaid) %></div>
            </div>
            <div>
              <div style="font-size: 0.7rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Balance</div>
              <div style="font-size: 1.2rem; font-weight: 800; color: <%= paymentSummary.balance > 0 ? '#d69e2e' : '#38a169' %>;"><%= formatPrice(paymentSummary.balance) %></div>
            </div>
          </div>
        </div>
        <% } %>
        <div style="text-align: center; margin-top: 1.5rem; padding: 1rem; background: #edf7ed; border-radius: var(--radius-sm); border: 1px solid #c6f6d5;">
          <strong style="color: #22543d;">Your ticket is being issued.</strong>
          <p style="margin: 0.3rem 0 0; font-size: 0.85rem; color: #276749;">Our ticketing team is finalizing your e-ticket. You will receive it shortly.</p>
        </div>
      </div>

      <% } else if (flight.ticket_status === 'pending') { %>
      <!-- ===== INQUIRY — PENDING ===== -->
      <div class="card" style="padding: 2rem; margin-bottom: 1.5rem;">
        <div style="text-align: center; margin-bottom: 1.5rem;">
          <div style="font-size: 3rem; margin-bottom: 0.5rem;">&#128203;</div>
          <h2 style="margin: 0;">Flight Inquiry Received</h2>
          <p class="muted">Your request is being reviewed by our ticketing team.</p>
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; max-width: 500px; margin: 0 auto;">
          <div>
            <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Route</div>
            <div style="font-weight: 700; font-size: 1.1rem;"><%= flight.origin %> &rarr; <%= flight.destination %></div>
          </div>
          <div>
            <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Reference</div>
            <div style="font-weight: 700; font-size: 1.1rem; font-family: monospace;">REQ-<%= flight.id %></div>
          </div>
          <div>
            <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Departure</div>
            <div style="font-weight: 600;"><%= new Date(flight.departure_date).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) %></div>
          </div>
          <div>
            <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Cabin</div>
            <div style="font-weight: 600;"><%= flight.cabin_class %></div>
          </div>
        </div>
        <div style="text-align: center; margin-top: 1.5rem; padding: 1rem; background: #fefcbf; border-radius: var(--radius-sm); border: 1px solid #d69e2e;">
          <strong style="color: #975a16;">Our team is checking live fares and availability.</strong>
          <p style="margin: 0.3rem 0 0; font-size: 0.85rem; color: #975a16;">We will send you suitable flight options with verified pricing shortly.</p>
        </div>
      </div>

      <% } else if (flight.ticket_status === 'cancelled') { %>
      <!-- ===== CANCELLED ===== -->
      <div class="card" style="padding: 2rem; margin-bottom: 1.5rem;">
        <div style="text-align: center; margin-bottom: 1.5rem;">
          <div style="font-size: 3rem; margin-bottom: 0.5rem;">&#10060;</div>
          <h2 style="margin: 0;">Booking Cancelled</h2>
          <p class="muted">This flight booking has been cancelled.</p>
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; max-width: 500px; margin: 0 auto;">
          <div>
            <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Route</div>
            <div style="font-weight: 700; font-size: 1.1rem;"><%= flight.origin %> &rarr; <%= flight.destination %></div>
          </div>
          <div>
            <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Reference</div>
            <div style="font-weight: 700; font-size: 1.1rem; font-family: monospace;"><%= flight.booking_ref %></div>
          </div>
        </div>
        <div style="text-align: center; margin-top: 1.5rem; padding: 1rem; background: #fed7d7; border-radius: var(--radius-sm); border: 1px solid #fc8181;">
          <strong style="color: #9b2c2c;">This booking has been cancelled.</strong>
          <p style="margin: 0.3rem 0 0; font-size: 0.85rem; color: #9b2c2c;">Please contact support@zahabiatravel.com for assistance or to rebook.</p>
        </div>
      </div>
      <% } %>

    <% } %>

    <!-- Tour Package Reservation Details -->
    <% if (typeof tourBooking !== 'undefined' && tourBooking && typeof tourPackage !== 'undefined' && tourPackage) { %>
      <div class="ticket-wrapper" style="margin-top: 2rem;">
        <div class="ticket-header">
          <div class="ticket-airline-brand">
            <img src="/brand/LOGO123.png" alt="Zahabia Logo" style="height: 55px;" onerror="this.src='/brand/Golden_airplane_circling_globe_20260914222838.gif';">
            <div>
              <h2 style="color: var(--accent-gold);"><%= tourPackage.title %></h2>
              <span style="font-size: 0.8rem; color: #e2ece9; text-transform: uppercase;">TOUR RESERVATION CONFIRMED</span>
            </div>
          </div>
          <div style="text-align: right;">
            <span style="font-size: 0.75rem; text-transform: uppercase; color: #a0aec0;">Booking Reference</span>
            <div style="font-family: var(--font-heading); font-size: 2.2rem; font-weight: 800; color: var(--accent-gold);">TOUR-<%= tourBooking.id %></div>
          </div>
        </div>

        <div class="ticket-body">
          <div style="background: #edf4f2; padding: 0.85rem 1.25rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
            <div>
              <span style="font-size: 0.72rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted);">BOOKING STATUS</span>
              <div style="font-weight: 800; font-size: 1rem; color: var(--primary);">STATUS: <span class="badge badge-<%= tourBooking.status %>"><%= tourBooking.status.toUpperCase() %></span></div>
            </div>
            <div style="display: flex; gap: 1.5rem; font-size: 0.85rem;">
              <div><strong>Destination:</strong> <%= tourPackage.destination %></div>
              <div><strong>Duration:</strong> <%= tourPackage.duration_days %> Days</div>
            </div>
          </div>

          <div class="ticket-grid">
            <div class="ticket-field">
              <label>Passenger Name</label>
              <val><%= customer ? customer.full_name : tourBooking.customer_name %></val>
            </div>
            <div class="ticket-field">
              <label>Destination</label>
              <val><%= tourPackage.destination %></val>
            </div>
            <div class="ticket-field">
              <label>Travel Date</label>
              <val><%= new Date(tourBooking.travel_date).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></val>
            </div>
            <div class="ticket-field">
              <label>Number of Travelers</label>
              <val><%= tourBooking.total_travelers %> Person<%= tourBooking.total_travelers > 1 ? 's' : '' %></val>
            </div>
            <div class="ticket-field">
              <label>Total Tour Cost</label>
              <val style="font-size: 1.3rem; color: var(--primary); font-weight: 800;"><%= formatPrice(tourBooking.total_amount) %></val>
            </div>
            <div class="ticket-field">
              <label>Package Inclusions</label>
              <val>Hotel, Transport, Guided Tours, Visa Assistance</val>
            </div>
          </div>

          <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1.5rem; padding: 1rem; background: #f0f4f8; border-radius: var(--radius-sm); border: 1px dashed #cbd5e0;" class="btn-no-print">
            <div>
              <div style="font-size: 0.72rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted);">Tour Booking QR Code</div>
              <div style="font-family: monospace; font-size: 0.9rem; font-weight: 700; color: var(--primary);"><%= token %></div>
              <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.2rem;">Scan to reopen this portal</div>
            </div>
            <img src="/t/<%= token %>/qr" alt="Portal QR Code" style="width: 110px; height: 110px; border: 2px solid var(--primary); border-radius: 8px; padding: 4px; background: #fff;">
          </div>
        </div>
      </div>
    <% } %>
  </main>

  <footer>
    <p>&copy; 2026 Zahabia Travel & Tourism. For customer support, contact support@zahabiatravel.com.</p>
  </footer>
</body>
</html>
