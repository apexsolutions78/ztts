<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Zahabia Travel & Tourism</title>
  <link rel="icon" type="image/png" href="/brand/LOGO123.png">
  <link rel="stylesheet" href="/static/css/app.css">
  <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
  <meta name="csrf-token" content="<%= csrfToken %>">
  <% } %>
</head>
<body>
  <% if (typeof user !== 'undefined' && user) { %>
    <nav class="navbar">
      <a href="<%= user.role === 'guide' ? '/guide' : '/admin' %>" class="brand-logo">
        <img src="/brand/LOGO123.png" alt="Zahabia Travel" onerror="this.onerror=null; this.src='/brand/Golden_airplane_circling_globe_20260914222838.gif';">
        <div>
          <span class="logo-title">ZAHABIA</span>
          <span class="logo-sub">Travel & Tourism</span>
        </div>
      </a>

      <button class="hamburger" onclick="document.getElementById('navMenu').classList.toggle('open')" aria-label="Toggle menu">&#9776;</button>

      <ul class="nav-links" id="navMenu">
        <% if (user.role === 'guide') { %>
          <li><a href="/guide" class="nav-link <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/guide')) ? 'active' : '' %>">My Groups</a></li>
        <% } else { %>
          <li><a href="/admin" class="nav-link <%= (typeof currentPath !== 'undefined' && currentPath === '/admin') ? 'active' : '' %>">Dashboard</a></li>
          <li><a href="/admin/flights" class="nav-link <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/admin/flights')) ? 'active' : '' %>">Flights</a></li>
          <li><a href="/admin/tours" class="nav-link <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/admin/tours')) ? 'active' : '' %>">Tours</a></li>
          <li><a href="/admin/tours/groups" class="nav-link <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/admin/tours/groups') || currentPath.startsWith('/admin/tours/group/')) ? 'active' : '' %>">Groups</a></li>
          <li><a href="/admin/chat" class="nav-link <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/admin/chat')) ? 'active' : '' %>" style="color: var(--accent-gold);">🤖 AI Chat</a></li>
          <li><a href="/admin/customers" class="nav-link <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/admin/customers')) ? 'active' : '' %>">Customers</a></li>
          <li><a href="/admin/finance" class="nav-link <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/admin/finance')) ? 'active' : '' %>">Finance</a></li>
          <% if (user.role === 'admin') { %>
            <li><a href="/admin/audit-logs" class="nav-link <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/admin/audit-logs')) ? 'active' : '' %>">Audit</a></li>
            <li><a href="/admin/settings/rates" class="nav-link <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/admin/settings')) ? 'active' : '' %>">Rates</a></li>
            <li><a href="/admin/users" class="nav-link <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/admin/users')) ? 'active' : '' %>">Users</a></li>
          <% } %>
        <% } %>
      </ul>

      <div class="nav-right">
        <div class="currency-switcher">
          <label>Currency:</label>
          <select onchange="location.href='?currency=' + this.value">
            <option value="PKR" <%= (typeof activeCurrency !== 'undefined' && activeCurrency === 'PKR') ? 'selected' : '' %>>PKR (Rs)</option>
            <option value="USD" <%= (typeof activeCurrency !== 'undefined' && activeCurrency === 'USD') ? 'selected' : '' %>>USD ($)</option>
            <option value="AED" <%= (typeof activeCurrency !== 'undefined' && activeCurrency === 'AED') ? 'selected' : '' %>>AED</option>
            <option value="EUR" <%= (typeof activeCurrency !== 'undefined' && activeCurrency === 'EUR') ? 'selected' : '' %>>EUR</option>
            <option value="GBP" <%= (typeof activeCurrency !== 'undefined' && activeCurrency === 'GBP') ? 'selected' : '' %>>GBP</option>
            <option value="SAR" <%= (typeof activeCurrency !== 'undefined' && activeCurrency === 'SAR') ? 'selected' : '' %>>SAR</option>
          </select>
        </div>

        <div class="user-badge">
          <span><%= user.name %></span>
          <span class="role-pill"><%= user.role %></span>
          <form method="post" action="/auth/logout" style="margin: 0;">
            <button class="btn btn-secondary btn-sm" type="submit">Sign Out</button>
          </form>
        </div>
      </div>
    </nav>
  <% } %>

  <main class="app-container">
    <%- body %>
  </main>

  <footer>
    <p>&copy; 2026 Zahabia Travel & Tourism. Powered by Apex Solutions.</p>
  </footer>

  <script>
    (function() {
      const meta = document.querySelector('meta[name="csrf-token"]');
      if (!meta) return;
      const token = meta.getAttribute('content');
      const origFetch = window.fetch;
      window.fetch = function(url, opts) {
        if (opts && opts.method && opts.method !== 'GET' && opts.method !== 'HEAD') {
          opts.headers = opts.headers || {};
          if (typeof opts.headers.set === 'function') {
            opts.headers.set('X-CSRF-Token', token);
          } else {
            opts.headers['X-CSRF-Token'] = token;
          }
        }
        return origFetch.call(this, url, opts);
      };
      document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('form[method="post"], form[method="POST"]').forEach(function(form) {
          if (form.querySelector('input[name="_csrf"]')) return;
          var input = document.createElement('input');
          input.type = 'hidden';
          input.name = '_csrf';
          input.value = token;
          form.appendChild(input);
        });
      });
    })();
  </script>
</body>
</html>
