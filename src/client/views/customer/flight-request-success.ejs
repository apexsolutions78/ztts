<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Flight Request Submitted | Zahabia Travel</title>
  <link rel="icon" type="image/png" href="/brand/LOGO123.png">
  <link rel="stylesheet" href="/static/css/app.css">
  <style>
    .account-nav {
      background: var(--bg-dark); color: #fff; padding: 0.7rem 1.5rem;
      display: flex; align-items: center; justify-content: space-between;
      position: sticky; top: 0; z-index: 100; flex-wrap: wrap; gap: 0.5rem;
    }
    .account-nav .brand { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; color: #fff; }
    .account-nav .brand img { height: 36px; border-radius: 8px; }
    .account-nav .brand span { font-family: var(--font-heading); font-weight: 800; font-size: 1.1rem; }
    .account-nav .nav-links { display: flex; gap: 0.25rem; list-style: none; }
    .account-nav .nav-links a {
      color: #a0aec0; text-decoration: none; padding: 0.4rem 0.8rem;
      border-radius: var(--radius-sm); font-size: 0.85rem; font-weight: 600; transition: all 0.2s;
    }
    .account-nav .nav-links a:hover, .account-nav .nav-links a.active { color: #fff; background: rgba(255,255,255,0.1); }
    .account-nav .nav-right { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
    .account-nav .currency-switcher select {
      padding: 0.25rem 0.5rem; border-radius: 6px; font-size: 0.78rem; font-weight: 700;
      background: var(--bg-dark); color: #fff; border: 1px solid var(--accent-gold); cursor: pointer;
    }
    .account-nav .currency-switcher label {
      font-size: 0.7rem; text-transform: uppercase; color: var(--accent-gold); font-weight: 700;
    }
    .account-nav .user-info { display: flex; align-items: center; gap: 0.6rem; }
    .account-nav .user-info span { font-size: 0.85rem; color: #a0aec0; }
    .account-nav .signout {
      background: rgba(255,255,255,0.1); color: #a0aec0; border: none;
      padding: 0.35rem 0.7rem; border-radius: var(--radius-sm); font-size: 0.78rem; font-weight: 600; cursor: pointer;
    }
    .account-nav .signout:hover { background: rgba(255,255,255,0.15); color: #fff; }
    .success-container { max-width: 600px; margin: 3rem auto; padding: 0 1.5rem; text-align: center; }
    .success-icon { font-size: 4rem; margin-bottom: 1rem; }
    .success-container h1 { font-size: 1.8rem; margin: 0 0 0.5rem; color: var(--primary-dark); }
    .success-container .subtitle { color: var(--text-muted); font-size: 0.95rem; margin-bottom: 2rem; }
    .success-card {
      background: #fff; border: 1px solid var(--border-light); border-radius: var(--radius-lg);
      padding: 2rem; box-shadow: var(--shadow-sm); text-align: left; margin-bottom: 2rem;
    }
    .success-card h2 { font-size: 1.1rem; margin: 0 0 1rem; color: var(--primary-dark); }
    .step { display: flex; gap: 1rem; margin-bottom: 1.2rem; align-items: flex-start; }
    .step-num {
      width: 32px; height: 32px; border-radius: 50%; background: var(--primary);
      color: #fff; display: flex; align-items: center; justify-content: center;
      font-weight: 800; font-size: 0.85rem; flex-shrink: 0;
    }
    .step-text { font-size: 0.9rem; line-height: 1.5; }
    .step-text strong { color: var(--primary-dark); }
    .btn-row { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }
    .btn-primary-custom {
      display: inline-block; padding: 0.8rem 1.5rem; background: var(--primary);
      color: #fff; border: none; border-radius: var(--radius-sm); font-size: 0.9rem;
      font-weight: 700; text-decoration: none; cursor: pointer; transition: background 0.2s;
    }
    .btn-primary-custom:hover { background: var(--primary-dark); }
    .btn-secondary-custom {
      display: inline-block; padding: 0.8rem 1.5rem; background: transparent;
      color: var(--primary); border: 2px solid var(--primary); border-radius: var(--radius-sm);
      font-size: 0.9rem; font-weight: 700; text-decoration: none; transition: all 0.2s;
    }
    .btn-secondary-custom:hover { background: var(--primary); color: #fff; }
  </style>
</head>
<body>
  <nav class="account-nav">
    <a href="/" class="brand">
      <img src="/brand/LOGO123.png" alt="Zahabia" onerror="this.style.display='none'">
      <span>ZAHABIA</span>
    </a>
    <ul class="nav-links">
      <li><a href="/account">Dashboard</a></li>
      <li><a href="/account/tours">Tours</a></li>
      <li><a href="/account/flights/request" class="active">Flights</a></li>
    </ul>
    <div class="nav-right">
      <div class="currency-switcher">
        <label>Currency:</label>
        <select onchange="location.href='/account/flights/request/success?currency=' + this.value">
          <option value="PKR" <%= activeCurrency === 'PKR' ? 'selected' : '' %>>PKR (Rs)</option>
          <option value="USD" <%= activeCurrency === 'USD' ? 'selected' : '' %>>USD ($)</option>
          <option value="AED" <%= activeCurrency === 'AED' ? 'selected' : '' %>>AED</option>
          <option value="EUR" <%= activeCurrency === 'EUR' ? 'selected' : '' %>>EUR</option>
          <option value="GBP" <%= activeCurrency === 'GBP' ? 'selected' : '' %>>GBP</option>
          <option value="SAR" <%= activeCurrency === 'SAR' ? 'selected' : '' %>>SAR</option>
        </select>
      </div>
      <div class="user-info">
        <span><%= customer.name %></span>
        <form method="POST" action="/account/logout" style="margin:0">
          <button type="submit" class="signout">Sign Out</button>
        </form>
      </div>
    </div>
  </nav>

  <div class="success-container">
    <div class="success-icon">✓</div>
    <h1>Flight Request Submitted!</h1>
    <p class="subtitle">Your travel request has been received. Our team will review available options and get back to you shortly.</p>

    <div class="success-card">
      <h2>What Happens Next?</h2>
      <div class="step">
        <div class="step-num">1</div>
        <div class="step-text"><strong>Review:</strong> Our travel experts review your request and search for the best flight options matching your preferences.</div>
      </div>
      <div class="step">
        <div class="step-num">2</div>
        <div class="step-text"><strong>Quote:</strong> You'll receive a detailed quote with flight options, pricing, and itinerary via email and WhatsApp.</div>
      </div>
      <div class="step">
        <div class="step-num">3</div>
        <div class="step-text"><strong>Confirm:</strong> Once you approve the itinerary, we process your booking and issue your e-ticket.</div>
      </div>
      <div class="step">
        <div class="step-num">4</div>
        <div class="step-text"><strong>E-Ticket:</strong> Your e-ticket and travel documents are delivered to your dashboard and email.</div>
      </div>
    </div>

    <div class="btn-row">
      <a href="/account/flights/request" class="btn-primary-custom">Submit Another Request</a>
      <a href="/account" class="btn-secondary-custom">Back to Dashboard</a>
    </div>
  </div>
</body>
</html>
