<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Zahabia Travel</title>
  <link rel="icon" type="image/png" href="/brand/LOGO123.png">
  <link rel="stylesheet" href="/static/css/app.css">
  <style>
    .auth-page {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #f4f7f6 0%, #e8f0ed 100%);
      padding: 2rem 1rem;
    }
    .auth-card {
      width: 100%;
      max-width: 440px;
      background: #fff;
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lg);
      overflow: hidden;
    }
    .auth-header {
      background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary) 100%);
      color: #fff;
      padding: 2rem;
      text-align: center;
    }
    .auth-header img { height: 50px; border-radius: 10px; margin-bottom: 0.8rem; }
    .auth-header h1 { font-size: 1.5rem; margin: 0; }
    .auth-header p { font-size: 0.85rem; color: #a0d4c8; margin: 0.3rem 0 0; }
    .auth-body { padding: 2rem; }
    .auth-body .form-group { margin-bottom: 1.1rem; }
    .auth-body label {
      display: block;
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 0.35rem;
    }
    .auth-body .form-control {
      width: 100%;
      padding: 0.7rem 0.9rem;
      border: 1.5px solid var(--border-light);
      border-radius: var(--radius-sm);
      font-size: 0.92rem;
      font-family: inherit;
      transition: border-color 0.2s;
      background: #fafcfb;
    }
    .auth-body .form-control:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(5,68,59,0.08);
    }
    .auth-body .btn-primary {
      width: 100%;
      padding: 0.8rem;
      font-size: 0.95rem;
      margin-top: 0.5rem;
    }
    .auth-error {
      background: #fde8e8;
      color: #9b2c2c;
      padding: 0.7rem 1rem;
      border-radius: var(--radius-sm);
      font-size: 0.85rem;
      margin-bottom: 1.2rem;
      border-left: 4px solid #e53e3e;
    }
    .auth-footer {
      text-align: center;
      padding-top: 1rem;
      border-top: 1px solid var(--border-light);
      margin-top: 1rem;
      font-size: 0.85rem;
      color: var(--text-muted);
    }
    .auth-footer a {
      color: var(--primary);
      font-weight: 600;
      text-decoration: none;
    }
    .auth-footer a:hover { text-decoration: underline; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; }
  </style>
</head>
<body>
  <div class="auth-page">
    <div class="auth-card">
      <div class="auth-header">
        <img src="/brand/LOGO123.png" alt="Zahabia" onerror="this.style.display='none'">
        <h1>Create Account</h1>
        <p>Join Zahabia Travel & Tourism</p>
      </div>
      <div class="auth-body">
        <% if (error) { %>
          <div class="auth-error"><%= error %></div>
        <% } %>
        <form method="POST" action="/account/register">
          <div class="form-group">
            <label>Full Name *</label>
            <input type="text" name="full_name" class="form-control" placeholder="e.g. Ahmed Khan" value="<%= form.full_name || '' %>" required>
          </div>
          <div class="form-group">
            <label>Email Address *</label>
            <input type="email" name="email" class="form-control" placeholder="you@example.com" value="<%= form.email || '' %>" required>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>Password *</label>
              <input type="password" name="password" class="form-control" placeholder="Min 6 characters" required>
            </div>
            <div class="form-group">
              <label>Confirm Password *</label>
              <input type="password" name="confirm_password" class="form-control" placeholder="Re-enter password" required>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>Phone</label>
              <input type="tel" name="phone" class="form-control" placeholder="+92 300 1234567" value="<%= form.phone || '' %>">
            </div>
            <div class="form-group">
              <label>Nationality</label>
              <input type="text" name="nationality" class="form-control" placeholder="e.g. Pakistan" value="<%= form.nationality || '' %>">
            </div>
          </div>
          <button type="submit" class="btn btn-primary">Create Account</button>
        </form>
        <div class="auth-footer">
          Already have an account? <a href="/account/login">Sign In</a>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
