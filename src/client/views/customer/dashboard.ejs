<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Zahabia Travel</title>
  <link rel="icon" type="image/png" href="/brand/LOGO123.png">
  <link rel="stylesheet" href="/static/css/app.css">
  <style>
    .account-nav {
      background: var(--bg-dark);
      color: #fff;
      padding: 0.7rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 100;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .account-nav .brand { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; color: #fff; }
    .account-nav .brand img { height: 36px; border-radius: 8px; }
    .account-nav .brand span { font-family: var(--font-heading); font-weight: 800; font-size: 1.1rem; }
    .account-nav .nav-links { display: flex; gap: 0.25rem; list-style: none; }
    .account-nav .nav-links a {
      color: #a0aec0;
      text-decoration: none;
      padding: 0.4rem 0.8rem;
      border-radius: var(--radius-sm);
      font-size: 0.85rem;
      font-weight: 600;
      transition: all 0.2s;
    }
    .account-nav .nav-links a:hover, .account-nav .nav-links a.active { color: #fff; background: rgba(255,255,255,0.1); }
    .account-nav .nav-right { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
    .account-nav .currency-switcher select {
      padding: 0.25rem 0.5rem;
      border-radius: 6px;
      font-size: 0.78rem;
      font-weight: 700;
      background: var(--bg-dark);
      color: #fff;
      border: 1px solid var(--accent-gold);
      cursor: pointer;
    }
    .account-nav .currency-switcher label {
      font-size: 0.7rem;
      text-transform: uppercase;
      color: var(--accent-gold);
      font-weight: 700;
    }
    .account-nav .user-info { display: flex; align-items: center; gap: 0.6rem; }
    .account-nav .user-info span { font-size: 0.85rem; color: #a0aec0; }
    .account-nav .signout {
      background: rgba(255,255,255,0.1);
      color: #a0aec0;
      border: none;
      padding: 0.35rem 0.7rem;
      border-radius: var(--radius-sm);
      font-size: 0.78rem;
      font-weight: 600;
      cursor: pointer;
    }
    .account-nav .signout:hover { background: rgba(255,255,255,0.15); color: #fff; }
    .account-container { max-width: 1000px; margin: 2rem auto; padding: 0 1.5rem; }
    .account-grid { display: grid; grid-template-columns: 260px 1fr; gap: 1.5rem; }
    .sidebar-card { border-radius: var(--radius-md); background: #fff; border: 1px solid var(--border-light); padding: 1.5rem; text-align: center; }
    .sidebar-card .avatar {
      width: 72px; height: 72px; border-radius: 50%;
      background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
      color: #fff; display: flex; align-items: center; justify-content: center;
      font-size: 1.8rem; font-weight: 700; margin: 0 auto 0.8rem;
    }
    .sidebar-card h3 { font-size: 1rem; margin: 0 0 0.2rem; }
    .sidebar-card .email { font-size: 0.8rem; color: var(--text-muted); }
    .sidebar-card .member-since { font-size: 0.72rem; color: var(--text-muted); margin-top: 0.6rem; padding-top: 0.6rem; border-top: 1px solid var(--border-light); }
    .sidebar-links { margin-top: 0.8rem; text-align: left; }
    .sidebar-links a {
      display: block; padding: 0.55rem 0.8rem; color: var(--text-muted); text-decoration: none;
      border-radius: var(--radius-sm); font-size: 0.85rem; font-weight: 600; transition: all 0.2s;
    }
    .sidebar-links a:hover, .sidebar-links a.active { background: #f0f7f5; color: var(--primary); }
    .main-content .card { margin-bottom: 1.5rem; }
    .section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; padding-bottom: 0.8rem; border-bottom: 1px solid var(--border-light); }
    .section-header h2 { font-size: 1.15rem; margin: 0; }
    .tabs { display: flex; gap: 0; margin-bottom: 1.2rem; border-bottom: 2px solid var(--border-light); }
    .tabs button {
      padding: 0.6rem 1.2rem; border: none; background: none; font-size: 0.85rem;
      font-weight: 600; color: var(--text-muted); cursor: pointer; border-bottom: 2px solid transparent;
      margin-bottom: -2px; transition: all 0.2s;
    }
    .tabs button.active { color: var(--primary); border-bottom-color: var(--primary); }
    .tabs button:hover { color: var(--primary); }
    .tab-panel { display: none; }
    .tab-panel.active { display: block; }
    .booking-list { display: flex; flex-direction: column; gap: 0.7rem; }
    .booking-item {
      display: flex; justify-content: space-between; align-items: center;
      padding: 0.9rem 1rem; background: #f8fcfa; border-radius: var(--radius-sm); border: 1px solid var(--border-light);
    }
    .booking-item .booking-info h4 { font-size: 0.92rem; margin: 0 0 0.2rem; }
    .booking-item .booking-info p { font-size: 0.78rem; color: var(--text-muted); margin: 0; }
    .booking-item .booking-meta { text-align: right; }
    .booking-item .booking-meta .price { font-size: 0.95rem; font-weight: 700; color: var(--primary); }
    .booking-item .booking-meta .status { font-size: 0.72rem; margin-top: 0.2rem; }
    .profile-form .form-group { margin-bottom: 1rem; }
    .profile-form label { display: block; font-size: 0.82rem; font-weight: 700; margin-bottom: 0.3rem; }
    .profile-form .form-control {
      width: 100%; padding: 0.6rem 0.8rem; border: 1.5px solid var(--border-light);
      border-radius: var(--radius-sm); font-size: 0.88rem; font-family: inherit;
    }
    .profile-form .form-control:focus { outline: none; border-color: var(--primary); }
    .profile-form .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; }
    .empty-state { text-align: center; padding: 1.5rem; color: var(--text-muted); }
    .empty-state p { font-size: 0.88rem; }
    .empty-state a { color: var(--primary); font-weight: 600; text-decoration: none; }
    .action-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem; }
    .action-card {
      display: flex; align-items: center; gap: 0.8rem; padding: 1rem;
      background: linear-gradient(135deg, #f0f7f5, #e8f0ed); border-radius: var(--radius-md);
      text-decoration: none; color: var(--text-main); border: 1px solid var(--border-light); transition: all 0.2s;
    }
    .action-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
    .action-card .icon { font-size: 1.8rem; }
    .action-card .info h4 { font-size: 0.9rem; margin: 0 0 0.15rem; }
    .action-card .info p { font-size: 0.75rem; color: var(--text-muted); margin: 0; }
    @media (max-width: 768px) {
      .account-grid { grid-template-columns: 1fr; }
      .account-nav .nav-links { display: none; }
      .action-cards { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <nav class="account-nav">
    <a href="/" class="brand">
      <img src="/brand/LOGO123.png" alt="Zahabia" onerror="this.style.display='none'">
      <span>ZAHABIA</span>
    </a>
    <ul class="nav-links">
      <li><a href="/account" class="active">Dashboard</a></li>
      <li><a href="/account/tours">Tours</a></li>
      <li><a href="/account/flights/request">Flights</a></li>
    </ul>
    <div class="nav-right">
      <div class="currency-switcher">
        <label>Currency:</label>
        <select onchange="location.href='?currency=' + this.value">
          <option value="PKR" <%= activeCurrency === 'PKR' ? 'selected' : '' %>>PKR (Rs)</option>
          <option value="USD" <%= activeCurrency === 'USD' ? 'selected' : '' %>>USD ($)</option>
          <option value="AED" <%= activeCurrency === 'AED' ? 'selected' : '' %>>AED</option>
          <option value="EUR" <%= activeCurrency === 'EUR' ? 'selected' : '' %>>EUR</option>
          <option value="GBP" <%= activeCurrency === 'GBP' ? 'selected' : '' %>>GBP</option>
          <option value="SAR" <%= activeCurrency === 'SAR' ? 'selected' : '' %>>SAR</option>
        </select>
      </div>
      <div class="user-info">
        <span><%= customer.full_name %></span>
        <form method="POST" action="/account/logout" style="margin:0">
          <button type="submit" class="signout">Sign Out</button>
        </form>
      </div>
    </div>
  </nav>

  <div class="account-container">
    <% if (typeof updated !== 'undefined' && updated) { %>
      <div style="background: #e6ffed; color: #22543d; padding: 0.8rem 1.2rem; border-radius: var(--radius-sm); border-left: 4px solid #38a169; margin-bottom: 1rem; font-size: 0.88rem; font-weight: 600;">Profile updated successfully.</div>
    <% } %>
    <% if (typeof cancelled !== 'undefined' && cancelled) { %>
      <div style="background: #fef3cd; color: #975a16; padding: 0.8rem 1.2rem; border-radius: var(--radius-sm); border-left: 4px solid #d69e2e; margin-bottom: 1rem; font-size: 0.88rem; font-weight: 600;">Booking cancelled successfully.</div>
    <% } %>
    <div class="account-grid">
      <div>
        <div class="sidebar-card">
          <div class="avatar"><%= customer.full_name.charAt(0).toUpperCase() %></div>
          <h3><%= customer.full_name %></h3>
          <p class="email"><%= customer.email %></p>
          <p class="member-since">Member since <%= new Date(customer.created_at).toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) %></p>
        </div>
        <div class="sidebar-links">
          <a href="/account" class="active">My Dashboard</a>
          <a href="/account/tours">Browse Tours</a>
          <a href="/account/flights/request">Request Flight</a>
          <a href="#profile-section" onclick="document.getElementById('profile-section').scrollIntoView({behavior:'smooth'})">Edit Profile</a>
        </div>
      </div>

      <div class="main-content">
        <div class="action-cards">
          <a href="/account/tours" class="action-card">
            <div class="icon">🌴</div>
            <div class="info">
              <h4>Browse Tours</h4>
              <p>Explore curated travel packages</p>
            </div>
          </a>
          <a href="/account/flights/request" class="action-card">
            <div class="icon">✈</div>
            <div class="info">
              <h4>Request Flight</h4>
              <p>Book flights worldwide</p>
            </div>
          </a>
        </div>

        <div class="card">
          <div class="section-header">
            <h2>My Bookings</h2>
          </div>
          <div class="tabs">
            <button class="active" onclick="switchTab('tours')">Tour Bookings</button>
            <button onclick="switchTab('flights')">Flight Bookings</button>
          </div>
          <div class="tab-panel active" id="tab-tours">
            <% if (tourBookings && tourBookings.length > 0) { %>
              <div class="booking-list">
                <% tourBookings.forEach(b => { %>
                  <div class="booking-item">
                    <div class="booking-info">
                      <h4><%= b.tour_title %></h4>
                      <p>Travel: <%= new Date(b.travel_date).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) %> &middot; <%= b.total_travelers %> traveler<%= b.total_travelers > 1 ? 's' : '' %></p>
                      <% if (b.portalToken) { %>
                        <p style="margin-top: 0.3rem;"><a href="/t/<%= b.portalToken %>" target="_blank" style="color: var(--primary); font-weight: 600; font-size: 0.78rem;">🔗 Open Travel Portal →</a></p>
                      <% } %>
                      <% if (b.status === 'confirmed') { %>
                        <p style="margin-top: 0.3rem;"><form method="POST" action="/account/tours/<%= b.id %>/cancel" style="display:inline;" onsubmit="return confirm('Cancel this booking? This cannot be undone.')"><button type="submit" style="background:none;border:none;color:#e53e3e;font-size:0.78rem;font-weight:600;cursor:pointer;padding:0;text-decoration:underline;">Cancel Booking</button></form></p>
                      <% } %>
                    </div>
                    <div class="booking-meta">
                      <div class="price"><%= formatPrice(b.total_amount) %></div>
                      <div class="status">
                        <span class="badge badge-<%= b.status === 'confirmed' ? 'confirmed' : b.status === 'cancelled' ? 'cancelled' : 'pending' %>"><%= b.status %></span>
                      </div>
                    </div>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <div class="empty-state">
                <p>No tour bookings yet. <a href="/account/tours">Browse tours</a> to get started.</p>
              </div>
            <% } %>
          </div>
          <div class="tab-panel" id="tab-flights">
            <% if (flightBookings && flightBookings.length > 0) { %>
              <div class="booking-list">
                <% flightBookings.forEach(f => { %>
                  <div class="booking-item" style="flex-direction: column; align-items: stretch;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
                      <div class="booking-info" style="flex: 1; min-width: 200px;">
                        <h4><%= f.origin %> → <%= f.destination %></h4>
                        <p style="margin: 0.2rem 0; color: var(--text-muted); font-size: 0.85rem;">
                          Ref: <strong><%= f.booking_ref %></strong>
                          &middot; <%= f.trip_type === 'round_trip' ? 'Round Trip' : 'One Way' %>
                        </p>
                        <p style="margin: 0.2rem 0; font-size: 0.85rem;">
                          <strong>Departure:</strong> <%= new Date(f.departure_date).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) %>
                          <% if (f.return_date) { %>
                            &middot; <strong>Return:</strong> <%= new Date(f.return_date).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) %>
                          <% } %>
                        </p>
                        <p style="margin: 0.2rem 0; font-size: 0.85rem;">
                          <strong>Class:</strong> <%= f.cabin_class %>
                          &middot; <strong>Passengers:</strong> <%= f.passengers || 1 %>
                          <% if (f.adults || f.children || f.infants) { %>
                            (<%= f.adults || 1 %>A<% if (f.children) { %>/<%= f.children %>C<% } %><% if (f.infants) { %>/<%= f.infants %>I<% } %>)
                          <% } %>
                        </p>
                        <% if (f.airline || f.preferred_airline) { %>
                          <p style="margin: 0.2rem 0; font-size: 0.85rem;">
                            <strong>Airline:</strong> <%= f.airline || f.preferred_airline || 'Any' %>
                            <% if (f.flight_number) { %> &middot; <strong>Flight:</strong> <%= f.flight_number %><% } %>
                          </p>
                        <% } %>
                        <% if (f.pnr) { %>
                          <p style="margin: 0.2rem 0; font-size: 0.85rem;"><strong>PNR:</strong> <span style="font-family: monospace; color: var(--primary);"><%= f.pnr %></span></p>
                        <% } %>
                        <% if (f.ticket_number) { %>
                          <p style="margin: 0.2rem 0; font-size: 0.85rem;"><strong>E-Ticket:</strong> <span style="font-family: monospace;"><%= f.ticket_number %></span></p>
                        <% } %>
                        <% if (f.portalToken) { %>
                          <p style="margin-top: 0.4rem;"><a href="/t/<%= f.portalToken %>" target="_blank" style="color: var(--primary); font-weight: 600; font-size: 0.8rem; text-decoration: underline;">🔗 View E-Ticket Portal →</a></p>
                        <% } %>
                      </div>
                      <div class="booking-meta" style="text-align: right; min-width: 120px;">
                        <div class="price"><%= f.total_amount > 0 ? formatPrice(f.total_amount) : 'Pending' %></div>
                        <div class="status" style="margin-top: 0.3rem;">
                          <span class="badge badge-<%= f.ticket_status === 'ticketed' ? 'ticketed' : f.ticket_status === 'confirmed' ? 'confirmed' : 'pending' %>"><%= f.ticket_status %></span>
                        </div>
                        <% if (f.workflow_stage && f.workflow_stage !== 'legacy') { %>
                          <div style="margin-top: 0.3rem; font-size: 0.72rem; color: var(--text-muted);"><%= f.workflow_stage.replace(/_/g, ' ') %></div>
                        <% } %>
                      </div>
                    </div>
                    <% if (f.ticket_status === 'pending' && f.workflow_stage === 'quote_sent') { %>
                      <div style="margin-top: 1rem; padding: 1rem; background: #fffff0; border: 1px solid #d69e2e; border-radius: 8px;">
                        <p style="margin: 0 0 0.5rem; font-weight: 700; color: #975a16;">✈ Quote Available — Your flight options are ready!</p>
                        <p style="margin: 0 0 0.75rem; font-size: 0.85rem; color: #744210;">Please review the flight options sent to your email or contact us for details.</p>
                        <div style="display: flex; gap: 0.5rem;">
                          <form method="post" action="/account/flights/<%= f.id %>/approve" style="margin: 0;">
                            <button type="submit" class="btn btn-sm" style="background: #38a169; color: #fff; padding: 0.5rem 1.2rem; font-weight: 600;">✓ Approve & Confirm</button>
                          </form>
                          <form method="post" action="/account/flights/<%= f.id %>/decline" style="margin: 0;" onsubmit="return confirm('Decline this flight option?')">
                            <button type="submit" class="btn btn-sm" style="background: #e53e3e; color: #fff; padding: 0.5rem 1.2rem;">✕ Decline</button>
                          </form>
                        </div>
                      </div>
                    <% } %>
                    <% if (f.workflow_stage === 'customer_approved') { %>
                      <% var paxCount = (Number(f.adults) || 1) + (Number(f.children) || 0) + (Number(f.infants) || 0); %>
                      <div style="margin-top: 1rem; padding: 1.25rem; background: #ebf8ff; border: 1px solid #3182ce; border-radius: 8px;">
                        <p style="margin: 0 0 0.5rem; font-weight: 700; color: #2b6cb0;">✈ Please Provide Passenger Details</p>
                        <p style="margin: 0 0 1rem; font-size: 0.85rem; color: #2c5282;">Enter details for all <strong><%= paxCount %></strong> traveler(s) exactly as printed on their passports. This is required to issue your e-ticket.</p>
                        <form method="post" action="/account/flights/<%= f.id %>/passengers">
                          <% for (var i = 0; i < paxCount; i++) { %>
                            <div style="background: #fff; border: 1px solid #bee3f8; border-radius: 6px; padding: 1rem; margin-bottom: 0.75rem;">
                              <p style="margin: 0 0 0.75rem; font-weight: 600; color: #2b6cb0; font-size: 0.9rem;">Passenger <%= i + 1 %><%= i === 0 ? ' (Lead Passenger)' : (i < (Number(f.adults) || 1) ? '' : (i < (Number(f.adults) || 1) + (Number(f.children) || 0) ? ' (Child)' : ' (Infant)')) %></p>
                              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
                                <div style="grid-column: 1 / -1;">
                                  <label style="display: block; font-size: 0.78rem; font-weight: 600; color: #4a5568; margin-bottom: 0.25rem;">Full Name (as on passport) *</label>
                                  <input type="text" name="pax_name_<%= i %>" required maxlength="100" class="form-control" style="text-transform: uppercase;" placeholder="e.g. AHMAD HAMAD ALI" value="<%= i === 0 ? (f.customer_name || '') : '' %>">
                                </div>
                                <div>
                                  <label style="display: block; font-size: 0.78rem; font-weight: 600; color: #4a5568; margin-bottom: 0.25rem;">Passport Number *</label>
                                  <input type="text" name="pax_passport_<%= i %>" required maxlength="20" class="form-control" style="text-transform: uppercase;" placeholder="e.g. AB1234567" value="<%= i === 0 ? (f.passport_number || '') : '' %>">
                                </div>
                                <div>
                                  <label style="display: block; font-size: 0.78rem; font-weight: 600; color: #4a5568; margin-bottom: 0.25rem;">Nationality</label>
                                  <input type="text" name="pax_nationality_<%= i %>" maxlength="50" class="form-control" placeholder="e.g. Pakistani" value="<%= i === 0 ? (f.nationality || '') : '' %>">
                                </div>
                                <div>
                                  <label style="display: block; font-size: 0.78rem; font-weight: 600; color: #4a5568; margin-bottom: 0.25rem;">Date of Birth</label>
                                  <input type="date" name="pax_dob_<%= i %>" class="form-control">
                                </div>
                                <div>
                                  <label style="display: block; font-size: 0.78rem; font-weight: 600; color: #4a5568; margin-bottom: 0.25rem;">Gender</label>
                                  <select name="pax_gender_<%= i %>" class="form-control">
                                    <option value="">Select</option>
                                    <option value="male">Male</option>
                                    <option value="female">Female</option>
                                  </select>
                                </div>
                              </div>
                            </div>
                          <% } %>
                          <button type="submit" class="btn btn-sm" style="background: #1a3a2a; color: #d4a843; padding: 0.6rem 1.5rem; font-weight: 600; margin-top: 0.5rem;" onclick="return confirm('Submit passenger details for all <%= paxCount %> traveler(s)?')">Submit Passenger Details</button>
                        </form>
                      </div>
                    <% } %>
                    <% if (f.passenger_details) { %>
                      <% var parsedPax = typeof f.passenger_details === 'string' ? JSON.parse(f.passenger_details) : f.passenger_details; %>
                      <div style="margin-top: 1rem; padding: 1rem; background: #f0fff4; border: 1px solid #38a169; border-radius: 8px;">
                        <p style="margin: 0 0 0.5rem; font-weight: 700; color: #276749;">✓ Passenger Details Submitted</p>
                        <table style="width: 100%; border-collapse: collapse; font-size: 0.82rem;">
                          <thead>
                            <tr style="background: #c6f6d5;">
                              <th style="padding: 0.4rem 0.5rem; text-align: left; border-bottom: 1px solid #9ae6b4;">#</th>
                              <th style="padding: 0.4rem 0.5rem; text-align: left; border-bottom: 1px solid #9ae6b4;">Name</th>
                              <th style="padding: 0.4rem 0.5rem; text-align: left; border-bottom: 1px solid #9ae6b4;">Passport</th>
                              <th style="padding: 0.4rem 0.5rem; text-align: left; border-bottom: 1px solid #9ae6b4;">Nationality</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% parsedPax.forEach(function(p, idx) { %>
                              <tr>
                                <td style="padding: 0.4rem 0.5rem; border-bottom: 1px solid #e2e8f0;"><%= idx + 1 %></td>
                                <td style="padding: 0.4rem 0.5rem; border-bottom: 1px solid #e2e8f0; font-weight: 600;"><%= p.full_name %></td>
                                <td style="padding: 0.4rem 0.5rem; border-bottom: 1px solid #e2e8f0; font-family: monospace;"><%= p.passport_number %></td>
                                <td style="padding: 0.4rem 0.5rem; border-bottom: 1px solid #e2e8f0;"><%= p.nationality || '-' %></td>
                              </tr>
                            <% }); %>
                          </tbody>
                        </table>
                      </div>
                    <% } %>
                    <% if (f.customer_notes && f.ticket_status === 'pending' && (!f.airline || f.workflow_stage === 'inquiry')) { %>
                      <div style="margin-top: 0.75rem; padding: 0.75rem; background: #f7fafc; border-radius: 6px; font-size: 0.8rem; color: var(--text-muted);">
                        <strong>Status:</strong> Your request is being reviewed. Our team is searching for the best options.
                      </div>
                    <% } %>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <div class="empty-state">
                <p>No flight bookings yet. <a href="/account/flights/request">Request a flight</a> to get started.</p>
              </div>
            <% } %>
          </div>
        </div>

        <div class="card" id="profile-section">
          <div class="section-header">
            <h2>Edit Profile</h2>
          </div>
          <form method="POST" action="/account/profile" class="profile-form">
            <div class="form-group">
              <label>Full Name</label>
              <input type="text" name="full_name" class="form-control" value="<%= customer.full_name %>" required>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>Phone</label>
                <input type="tel" name="phone" class="form-control" value="<%= customer.phone || '' %>">
              </div>
              <div class="form-group">
                <label>Nationality</label>
                <input type="text" name="nationality" class="form-control" value="<%= customer.nationality || '' %>">
              </div>
            </div>
            <div class="form-group">
              <label>Passport Number</label>
              <input type="text" name="passport_number" class="form-control" value="<%= customer.passport_number || '' %>">
            </div>
            <button type="submit" class="btn btn-primary">Save Changes</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script>
    function switchTab(tab) {
      document.querySelectorAll('.tabs button').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      document.getElementById('tab-' + tab).classList.add('active');
      event.target.classList.add('active');
    }
  </script>
</body>
</html>
