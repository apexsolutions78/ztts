<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Zahabia Travel</title>
  <link rel="icon" type="image/png" href="/brand/LOGO123.png">
  <link rel="stylesheet" href="/static/css/app.css">
  <style>
    .account-nav {
      background: var(--bg-dark); color: #fff; padding: 0.7rem 1.5rem;
      display: flex; align-items: center; justify-content: space-between;
      position: sticky; top: 0; z-index: 100; flex-wrap: wrap; gap: 0.5rem;
    }
    .account-nav .brand { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; color: #fff; }
    .account-nav .brand img { height: 36px; border-radius: 8px; }
    .account-nav .brand span { font-family: var(--font-heading); font-weight: 800; font-size: 1.1rem; }
    .account-nav .nav-links { display: flex; gap: 0.25rem; list-style: none; }
    .account-nav .nav-links a {
      color: #a0aec0; text-decoration: none; padding: 0.4rem 0.8rem;
      border-radius: var(--radius-sm); font-size: 0.85rem; font-weight: 600; transition: all 0.2s;
    }
    .account-nav .nav-links a:hover, .account-nav .nav-links a.active { color: #fff; background: rgba(255,255,255,0.1); }
    .account-nav .nav-right { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
    .account-nav .currency-switcher select {
      padding: 0.25rem 0.5rem; border-radius: 6px; font-size: 0.78rem; font-weight: 700;
      background: var(--bg-dark); color: #fff; border: 1px solid var(--accent-gold); cursor: pointer;
    }
    .account-nav .currency-switcher label {
      font-size: 0.7rem; text-transform: uppercase; color: var(--accent-gold); font-weight: 700;
    }
    .account-nav .user-info { display: flex; align-items: center; gap: 0.6rem; }
    .account-nav .user-info span { font-size: 0.85rem; color: #a0aec0; }
    .account-nav .signout {
      background: rgba(255,255,255,0.1); color: #a0aec0; border: none;
      padding: 0.35rem 0.7rem; border-radius: var(--radius-sm); font-size: 0.78rem; font-weight: 600; cursor: pointer;
    }
    .account-nav .signout:hover { background: rgba(255,255,255,0.15); color: #fff; }
    .tours-container { max-width: 1100px; margin: 2rem auto; padding: 0 1.5rem; }
    .tours-header { text-align: center; margin-bottom: 2rem; }
    .tours-header h1 { font-size: 1.8rem; margin: 0 0 0.3rem; }
    .tours-header p { color: var(--text-muted); font-size: 0.95rem; }
    .tour-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem; }
    .tour-card {
      border-radius: var(--radius-md); overflow: hidden;
      border: 1px solid var(--border-light); background: #fff;
      transition: transform 0.3s, box-shadow 0.3s;
    }
    .tour-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(0,0,0,0.1); }
    .tour-card .card-img {
      width: 100%; display: flex; align-items: center; justify-content: center;
      font-size: 3rem; position: relative; background: linear-gradient(135deg, #e2ece9 0%, #c5d8d2 100%);
    }
    .tour-card .card-img img { width: 100%; height: auto; display: block; }
    .tour-card .card-img .duration-badge {
      position: absolute; top: 0.8rem; right: 0.8rem;
      background: rgba(16,42,39,0.88); color: #fff;
      padding: 0.3rem 0.7rem; border-radius: 16px; font-size: 0.72rem; font-weight: 700; backdrop-filter: blur(4px);
    }
    .tour-card .card-body { padding: 1.2rem; }
    .tour-card .dest-label { font-size: 0.72rem; color: var(--accent-gold); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.3rem; }
    .tour-card .card-body h3 { font-size: 1.05rem; margin: 0 0 0.4rem; line-height: 1.3; }
    .tour-card .card-desc {
      font-size: 0.82rem; color: var(--text-muted); line-height: 1.5;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-bottom: 0.8rem;
    }
    .tour-card .card-footer {
      display: flex; justify-content: space-between; align-items: flex-end;
      padding-top: 0.8rem; border-top: 1px solid var(--border-light);
    }
    .tour-card .price-label { font-size: 0.65rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; }
    .tour-card .price { font-family: var(--font-heading); font-size: 1.3rem; font-weight: 800; color: var(--primary); }
    .tour-card .per { font-size: 0.7rem; color: var(--text-muted); }
    .tour-card .card-btn {
      display: inline-flex; align-items: center; gap: 0.3rem;
      padding: 0.5rem 1rem; background: var(--primary); color: #fff;
      border: none; border-radius: var(--radius-sm); font-size: 0.82rem; font-weight: 600;
      cursor: pointer; text-decoration: none; transition: background 0.2s;
    }
    .tour-card .card-btn:hover { background: var(--primary-dark); }
    @media (max-width: 640px) { .tour-grid { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <nav class="account-nav">
    <a href="/" class="brand">
      <img src="/brand/LOGO123.png" alt="Zahabia" onerror="this.style.display='none'">
      <span>ZAHABIA</span>
    </a>
    <ul class="nav-links">
      <li><a href="/account">Dashboard</a></li>
      <li><a href="/account/tours" class="active">Tours</a></li>
      <li><a href="/account/flights/request">Flights</a></li>
    </ul>
    <div class="nav-right">
      <div class="currency-switcher">
        <label>Currency:</label>
        <select onchange="location.href='?currency=' + this.value">
          <option value="PKR" <%= activeCurrency === 'PKR' ? 'selected' : '' %>>PKR (Rs)</option>
          <option value="USD" <%= activeCurrency === 'USD' ? 'selected' : '' %>>USD ($)</option>
          <option value="AED" <%= activeCurrency === 'AED' ? 'selected' : '' %>>AED</option>
          <option value="EUR" <%= activeCurrency === 'EUR' ? 'selected' : '' %>>EUR</option>
          <option value="GBP" <%= activeCurrency === 'GBP' ? 'selected' : '' %>>GBP</option>
          <option value="SAR" <%= activeCurrency === 'SAR' ? 'selected' : '' %>>SAR</option>
        </select>
      </div>
      <div class="user-info">
        <span><%= customer.name %></span>
        <form method="POST" action="/account/logout" style="margin:0">
          <button type="submit" class="signout">Sign Out</button>
        </form>
      </div>
    </div>
  </nav>

  <div class="tours-container">
    <div class="tours-header">
      <h1>Explore Our Tour Packages</h1>
      <p>Discover curated travel experiences with Zahabia Travel & Tourism</p>
    </div>

    <% if (packages && packages.length > 0) { %>
      <div class="tour-grid">
        <% packages.forEach(p => { %>
          <div class="tour-card">
            <div class="card-img">
              <% if (p.image_url && p.image_url !== '/static/img/default_tour.jpg') { %>
                <img src="<%= p.image_url %>" alt="<%= p.title %>">
              <% } else { %>
                🌴
              <% } %>
              <span class="duration-badge"><%= p.duration_days %> Days</span>
            </div>
            <div class="card-body">
              <div class="dest-label">📍 <%= p.destination %></div>
              <h3><%= p.title %></h3>
              <p class="card-desc"><%= p.description || 'An amazing travel experience.' %></p>
              <div class="card-footer">
                <div>
                  <div class="price-label">Starting from</div>
                  <div class="price"><%= formatPrice(p.price) %></div>
                  <div class="per">per person</div>
                </div>
                <a href="/account/tours/<%= p.id %>" class="card-btn">View Details →</a>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="card" style="text-align: center; padding: 3rem;">
        <h3>No tours available right now</h3>
        <p style="color: var(--text-muted);">Check back soon for new packages!</p>
      </div>
    <% } %>
  </div>
</body>
</html>
