<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Zahabia Travel</title>
  <link rel="icon" type="image/png" href="/brand/LOGO123.png">
  <link rel="stylesheet" href="/static/css/app.css">
  <style>
    .auth-page { min-height: 100vh; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #f4f7f6 0%, #e8f0ed 100%); padding: 2rem 1rem; }
    .auth-card { width: 100%; max-width: 440px; background: #fff; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); overflow: hidden; }
    .auth-header { background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary) 100%); color: #fff; padding: 2rem; text-align: center; }
    .auth-header img { height: 50px; border-radius: 10px; margin-bottom: 0.8rem; }
    .auth-header h1 { font-size: 1.5rem; margin: 0; }
    .auth-header p { font-size: 0.85rem; color: #a0d4c8; margin: 0.3rem 0 0; }
    .auth-body { padding: 2rem; }
    .auth-body .form-group { margin-bottom: 1.1rem; }
    .auth-body label { display: block; font-size: 0.82rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.35rem; }
    .auth-body .form-control { width: 100%; padding: 0.7rem 0.9rem; border: 1.5px solid var(--border-light); border-radius: var(--radius-sm); font-size: 0.92rem; font-family: inherit; transition: border-color 0.2s; background: #fafcfb; }
    .auth-body .form-control:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px rgba(5,68,59,0.08); }
    .auth-body .btn-primary { width: 100%; padding: 0.8rem; font-size: 0.95rem; margin-top: 0.5rem; }
    .auth-error { background: #fde8e8; color: #9b2c2c; padding: 0.7rem 1rem; border-radius: var(--radius-sm); font-size: 0.85rem; margin-bottom: 1.2rem; border-left: 4px solid #e53e3e; }
    .auth-success { background: #e6ffed; color: #22543d; padding: 0.7rem 1rem; border-radius: var(--radius-sm); font-size: 0.85rem; margin-bottom: 1.2rem; border-left: 4px solid #38a169; }
    .code-input { font-size: 2rem; text-align: center; letter-spacing: 12px; font-weight: bold; padding: 0.9rem !important; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; }
    .back-link { display: inline-block; margin-top: 1rem; color: var(--text-muted); font-size: 0.85rem; text-decoration: none; cursor: pointer; }
    .back-link:hover { color: var(--primary); }
    .auth-footer { text-align: center; padding-top: 1rem; border-top: 1px solid var(--border-light); margin-top: 1rem; font-size: 0.85rem; color: var(--text-muted); }
  </style>
</head>
<body>
  <div class="auth-page">
    <div class="auth-card">
      <div class="auth-header">
        <img src="/brand/LOGO123.png" alt="Zahabia" onerror="this.style.display='none'">
        <h1><%= step === 'register' ? 'Create Account' : step === 'create-password' ? 'Create Password' : 'Welcome Back' %></h1>
        <p><%= step === 'register' ? 'Join Zahabia Travel & Tourism' : step === 'create-password' ? 'Set up your account security' : 'Sign in to manage your bookings' %></p>
      </div>
      <div class="auth-body">
        <% if (error) { %>
          <div class="auth-error"><%= error %></div>
        <% } %>
        <% if (message) { %>
          <div class="auth-success"><%= message %></div>
        <% } %>

        <% if (step === 'email') { %>
          <!-- Step 1: Enter email -->
          <form method="POST" action="/account/auth">
            <div class="form-group">
              <label>Email Address</label>
              <input type="email" name="email" class="form-control" placeholder="you@example.com" required value="<%= email %>">
            </div>
            <button type="submit" class="btn btn-primary">Continue</button>
          </form>
          <div class="auth-footer">
            New to Zahabia? Enter your email above — an account will be created automatically.
          </div>

        <% } else if (step === 'password') { %>
          <!-- Step 2a: Password login (customer has password) -->
          <form method="POST" action="/account/auth">
            <input type="hidden" name="email" value="<%= email %>">
            <div class="form-group">
              <label>Password</label>
              <input type="password" name="password" class="form-control" placeholder="Enter your password" required>
            </div>
            <button type="submit" class="btn btn-primary">Sign In</button>
          </form>
          <a class="back-link" onclick="history.back()">&#8592; Use a different email</a>

        <% } else if (step === 'code') { %>
          <!-- Step 2b: Auth code (no password yet) -->
          <form method="POST" action="/account/verify">
            <input type="hidden" name="email" value="<%= email %>">
            <div class="form-group">
              <label>Enter 6-Digit Code</label>
              <input type="text" name="code" class="form-control code-input" placeholder="000000" required maxlength="6" pattern="[0-9]{6}" inputmode="numeric" autocomplete="one-time-code">
            </div>
            <button type="submit" class="btn btn-primary">Verify Code</button>
          </form>
          <a class="back-link" onclick="history.back()">&#8592; Use a different email</a>

        <% } else if (step === 'register') { %>
          <!-- Step 3a: Registration (new customer) -->
          <form method="POST" action="/account/verify">
            <input type="hidden" name="email" value="<%= email %>">
            <input type="hidden" name="code" value="<%= code %>">
            <div class="form-group">
              <label>Full Name *</label>
              <input type="text" name="full_name" class="form-control" placeholder="e.g. Ahmed Khan" required>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>Phone</label>
                <input type="tel" name="phone" class="form-control" placeholder="+92 300 1234567">
              </div>
              <div class="form-group">
                <label>Nationality</label>
                <input type="text" name="nationality" class="form-control" placeholder="e.g. Pakistan">
              </div>
            </div>
            <button type="submit" class="btn btn-primary">Create Account</button>
          </form>

        <% } else if (step === 'create-password') { %>
          <!-- Step 4: Create password -->
          <form method="POST" action="/account/create-password">
            <input type="hidden" name="email" value="<%= email %>">
            <input type="hidden" name="code" value="<%= code %>">
            <div class="form-group">
              <label>Create Password</label>
              <input type="password" name="password" class="form-control" placeholder="Min 6 characters" required minlength="6">
            </div>
            <div class="form-group">
              <label>Confirm Password</label>
              <input type="password" name="confirm_password" class="form-control" placeholder="Re-enter password" required minlength="6">
            </div>
            <button type="submit" class="btn btn-primary">Create Password & Sign In</button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>
