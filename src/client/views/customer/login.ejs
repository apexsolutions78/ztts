<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Zahabia Travel</title>
  <link rel="icon" type="image/png" href="/brand/LOGO123.png">
  <link rel="stylesheet" href="/static/css/app.css">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Plus Jakarta Sans', sans-serif; min-height: 100vh; display: flex; align-items: center; justify-content: center; background: #050d0a; padding: 1rem; overflow: hidden; position: relative; }

    /* Animated background */
    .auth-bg { position: absolute; inset: 0; z-index: 0; }
    .auth-bg .orb { position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.3; }
    .auth-bg .orb-1 { width: 500px; height: 500px; background: #05443b; top: -20%; left: -10%; animation: orbFloat 12s ease-in-out infinite; }
    .auth-bg .orb-2 { width: 400px; height: 400px; background: rgba(212,175,55,0.15); bottom: -15%; right: -5%; animation: orbFloat 15s ease-in-out infinite reverse; }
    .auth-bg .orb-3 { width: 300px; height: 300px; background: #086b5e; top: 50%; left: 50%; transform: translate(-50%,-50%); animation: orbFloat 10s ease-in-out infinite 2s; }
    @keyframes orbFloat {
      0%, 100% { transform: translate(0, 0) scale(1); }
      33% { transform: translate(30px, -20px) scale(1.05); }
      66% { transform: translate(-20px, 15px) scale(0.95); }
    }

    /* Card */
    .auth-wrapper { position: relative; z-index: 1; width: 100%; max-width: 420px; }
    .auth-card {
      background: rgba(8,30,24,0.7); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
      border: 1px solid rgba(8,107,94,0.2); border-radius: 24px;
      overflow: hidden; box-shadow: 0 20px 60px rgba(0,0,0,0.4);
    }

    /* Avatar Section */
    .auth-avatar-section {
      padding: 2.5rem 2rem 1.5rem; text-align: center;
      background: linear-gradient(180deg, rgba(8,107,94,0.12) 0%, transparent 100%);
    }
    .auth-avatar {
      width: 90px; height: 90px; border-radius: 50%; margin: 0 auto 1.2rem;
      position: relative; display: flex; align-items: center; justify-content: center;
    }
    .auth-avatar-ring {
      position: absolute; inset: -4px; border-radius: 50%;
      border: 2.5px solid transparent;
      border-top-color: #d4af37; border-right-color: rgba(212,175,55,0.3);
      animation: ringSpin 3s linear infinite;
    }
    @keyframes ringSpin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    .auth-avatar-inner {
      width: 100%; height: 100%; border-radius: 50%;
      background: linear-gradient(135deg, #05443b 0%, #086b5e 100%);
      display: flex; align-items: center; justify-content: center;
      font-size: 2.2rem; color: #d4af37;
      box-shadow: 0 0 30px rgba(212,175,55,0.15);
    }
    .auth-avatar-initials {
      font-family: 'Outfit', sans-serif; font-weight: 800; font-size: 1.8rem; color: #d4af37;
    }
    .auth-card-title { font-family: 'Outfit', sans-serif; font-size: 1.5rem; font-weight: 700; color: #e8f0ed; margin-bottom: 0.3rem; }
    .auth-card-subtitle { font-size: 0.88rem; color: #7fa89e; }

    /* Form */
    .auth-form-body { padding: 1.5rem 2rem 2rem; }
    .auth-form-body .form-group { margin-bottom: 1.1rem; }
    .auth-form-body label { display: block; font-size: 0.78rem; font-weight: 600; color: #a0c4b8; margin-bottom: 0.4rem; text-transform: uppercase; letter-spacing: 0.5px; }
    .auth-form-body .form-control {
      width: 100%; padding: 0.75rem 1rem;
      background: rgba(5,13,10,0.5); border: 1.5px solid rgba(8,107,94,0.25);
      border-radius: 12px; font-size: 0.92rem; font-family: inherit;
      color: #e8f0ed; transition: all 0.25s;
    }
    .auth-form-body .form-control::placeholder { color: #4a6b63; }
    .auth-form-body .form-control:focus { outline: none; border-color: #d4af37; box-shadow: 0 0 0 3px rgba(212,175,55,0.1); background: rgba(5,13,10,0.7); }
    .auth-form-body .btn-primary {
      width: 100%; padding: 0.85rem; font-size: 0.95rem; font-weight: 700;
      background: linear-gradient(135deg, #d4af37 0%, #b89628 100%);
      color: #050d0a; border: none; border-radius: 12px; cursor: pointer;
      transition: all 0.3s; font-family: inherit; margin-top: 0.5rem;
    }
    .auth-form-body .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(212,175,55,0.3); }

    .auth-error { background: rgba(229,62,62,0.1); color: #fc8181; padding: 0.7rem 1rem; border-radius: 10px; font-size: 0.82rem; margin-bottom: 1rem; border-left: 3px solid #e53e3e; }
    .auth-success { background: rgba(56,161,105,0.1); color: #68d391; padding: 0.7rem 1rem; border-radius: 10px; font-size: 0.82rem; margin-bottom: 1rem; border-left: 3px solid #38a169; }
    .code-input { font-size: 2rem; text-align: center; letter-spacing: 12px; font-weight: bold; padding: 0.9rem !important; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; }
    .back-link { display: inline-flex; align-items: center; gap: 0.3rem; margin-top: 1rem; color: #7fa89e; font-size: 0.85rem; text-decoration: none; cursor: pointer; transition: color 0.2s; }
    .back-link:hover { color: #d4af37; }
    .auth-divider { text-align: center; padding: 1.2rem 0 0; border-top: 1px solid rgba(8,107,94,0.15); margin-top: 1rem; }
    .auth-divider p { font-size: 0.82rem; color: #5c7370; }
    .auth-divider a { color: #d4af37; text-decoration: none; font-weight: 600; }

    /* Step indicators */
    .auth-steps { display: flex; justify-content: center; gap: 0.5rem; margin-bottom: 1.5rem; }
    .auth-step-dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(8,107,94,0.3); transition: all 0.3s; }
    .auth-step-dot.active { background: #d4af37; width: 24px; border-radius: 4px; }

    /* Home link */
    .auth-home { position: absolute; top: 1.5rem; left: 1.5rem; z-index: 2; }
    .auth-home a { color: #5c7370; text-decoration: none; font-size: 0.85rem; display: flex; align-items: center; gap: 0.3rem; transition: color 0.2s; }
    .auth-home a:hover { color: #d4af37; }
  </style>
</head>
<body>
  <!-- Background Orbs -->
  <div class="auth-bg">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
  </div>

  <div class="auth-home">
    <a href="/">← Back to Home</a>
  </div>

  <div class="auth-wrapper">
    <div class="auth-card">
      <!-- Avatar + Header -->
      <div class="auth-avatar-section">
        <div class="auth-avatar">
          <div class="auth-avatar-ring"></div>
          <div class="auth-avatar-inner">
            <% if (step === 'register') { %>
              <span class="auth-avatar-initials">+</span>
            <% } else if (step === 'create-password') { %>
              <span class="auth-avatar-initials">🔑</span>
            <% } else { %>
              <span class="auth-avatar-initials">👤</span>
            <% } %>
          </div>
        </div>
        <h1 class="auth-card-title"><%= step === 'register' ? 'Create Account' : step === 'create-password' ? 'Set Password' : 'Welcome Back' %></h1>
        <p class="auth-card-subtitle"><%= step === 'register' ? 'Join Zahabia Travel & Tourism' : step === 'create-password' ? 'Secure your account' : 'Sign in to manage your bookings' %></p>
      </div>

      <!-- Form Body -->
      <div class="auth-form-body">
        <% if (error) { %>
          <div class="auth-error"><%= error %></div>
        <% } %>
        <% if (message) { %>
          <div class="auth-success"><%= message %></div>
        <% } %>

        <!-- Step indicators -->
        <div class="auth-steps">
          <div class="auth-step-dot <%= (step === 'email') ? 'active' : '' %>"></div>
          <div class="auth-step-dot <%= (step === 'password' || step === 'code' || step === 'register' || step === 'create-password') ? 'active' : '' %>"></div>
          <div class="auth-step-dot <%= (step === 'register' || step === 'create-password') ? 'active' : '' %>"></div>
        </div>

        <% if (step === 'email') { %>
          <form method="POST" action="/account/auth">
            <div class="form-group">
              <label>Email Address</label>
              <input type="email" name="email" class="form-control" placeholder="you@example.com" required value="<%= email %>">
            </div>
            <button type="submit" class="btn-primary">Continue →</button>
          </form>
          <div class="auth-divider"><p>New to Zahabia? Your account is created automatically.</p></div>

        <% } else if (step === 'password') { %>
          <form method="POST" action="/account/auth">
            <input type="hidden" name="email" value="<%= email %>">
            <div class="form-group">
              <label>Password</label>
              <input type="password" name="password" class="form-control" placeholder="Enter your password" required>
            </div>
            <button type="submit" class="btn-primary">Sign In</button>
          </form>
          <a class="back-link" onclick="history.back()">← Use a different email</a>

        <% } else if (step === 'code') { %>
          <form method="POST" action="/account/verify">
            <input type="hidden" name="email" value="<%= email %>">
            <div class="form-group">
              <label>Verification Code</label>
              <input type="text" name="code" class="form-control code-input" placeholder="000000" required maxlength="6" pattern="[0-9]{6}" inputmode="numeric">
            </div>
            <button type="submit" class="btn-primary">Verify Code</button>
          </form>
          <a class="back-link" onclick="history.back()">← Use a different email</a>

        <% } else if (step === 'register') { %>
          <form method="POST" action="/account/verify">
            <input type="hidden" name="email" value="<%= email %>">
            <input type="hidden" name="code" value="<%= code %>">
            <div class="form-group">
              <label>Full Name</label>
              <input type="text" name="full_name" class="form-control" placeholder="e.g. Ahmed Khan" required>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>Phone</label>
                <input type="tel" name="phone" class="form-control" placeholder="+92 300 1234567">
              </div>
              <div class="form-group">
                <label>Nationality</label>
                <input type="text" name="nationality" class="form-control" placeholder="e.g. Pakistan">
              </div>
            </div>
            <button type="submit" class="btn-primary">Create Account</button>
          </form>

        <% } else if (step === 'create-password') { %>
          <form method="POST" action="/account/create-password">
            <input type="hidden" name="email" value="<%= email %>">
            <input type="hidden" name="code" value="<%= code %>">
            <div class="form-group">
              <label>Create Password</label>
              <input type="password" name="password" class="form-control" placeholder="Min 6 characters" required minlength="6">
            </div>
            <div class="form-group">
              <label>Confirm Password</label>
              <input type="password" name="confirm_password" class="form-control" placeholder="Re-enter password" required minlength="6">
            </div>
            <button type="submit" class="btn-primary">Create Password & Sign In</button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>
