<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Zahabia Travel & Tourism</title>
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<body>
  <%- include('../../layout', { body: `
    <div style="margin-bottom: 2rem;">
      <a href="/admin/customers" class="btn btn-secondary btn-sm">← Back to Directory</a>
      <h1 style="margin-top: 0.5rem;">${customer.full_name}</h1>
      <p class="muted">Customer Profile & Booking History</p>
      <div style="margin-top: 0.5rem; display: flex; gap: 0.5rem;">
        <a href="/admin/customers/${customer.id}/edit" class="btn btn-primary btn-sm">Edit Customer</a>
        <form method="post" action="/admin/customers/${customer.id}/delete" style="margin: 0;" onsubmit="return confirm('Delete this customer? This will also remove all associated bookings.')">
          <button type="submit" class="btn btn-sm" style="background: #e53e3e; color: #fff;">Delete Customer</button>
        </form>
      </div>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 1.5rem;">
      <!-- Customer Information Card -->
      <div class="card">
        <h2>Passport & Contact Details</h2>
        <div style="margin-top: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
          <div>
            <span class="muted" style="font-size: 0.8rem; text-transform: uppercase;">Full Name</span>
            <div style="font-weight: 700; font-size: 1.1rem;">${customer.full_name}</div>
          </div>
          <div>
            <span class="muted" style="font-size: 0.8rem; text-transform: uppercase;">Passport Number</span>
            <div><code style="font-size: 1.1rem;">${customer.passport_number || 'N/A'}</code></div>
          </div>
          <div>
            <span class="muted" style="font-size: 0.8rem; text-transform: uppercase;">Nationality</span>
            <div style="font-weight: 600;">${customer.nationality || 'N/A'}</div>
          </div>
          <div>
            <span class="muted" style="font-size: 0.8rem; text-transform: uppercase;">Email</span>
            <div>${customer.email || 'N/A'}</div>
          </div>
          <div>
            <span class="muted" style="font-size: 0.8rem; text-transform: uppercase;">Phone Number</span>
            <div>${customer.phone || 'N/A'}</div>
          </div>
        </div>

        <div style="margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--border-light);">
          <a href="/admin/flights/new" class="btn btn-primary btn-sm" style="width: 100%;">+ Issue Flight for Passenger</a>
        </div>
      </div>

      <!-- Customer Flight Bookings History -->
      <div class="card">
        <h2>Flight Travel History</h2>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>PNR</th>
                <th>Airline / Flight</th>
                <th>Route</th>
                <th>Departure</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              ${flights.length > 0 ? flights.map(f => `
                <tr>
                  <td><strong>${f.booking_ref}</strong></td>
                  <td>${f.airline} (${f.flight_number})</td>
                  <td>${f.origin} → ${f.destination}</td>
                  <td>${new Date(f.departure_date).toLocaleDateString()}</td>
                  <td><span class="badge badge-${f.ticket_status}">${f.ticket_status}</span></td>
                  <td><a href="/admin/flights/${f.id}" class="btn btn-secondary btn-sm">View Ticket</a></td>
                </tr>
              `).join('') : '<tr><td colspan="6" class="muted">No flight history recorded.</td></tr>'}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Customer Tour Bookings History -->
      <div class="card" style="margin-top: 1.5rem;">
        <h2>Tour Booking History</h2>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Tour Package</th>
                <th>Travel Date</th>
                <th>Travelers</th>
                <th>Total Amount</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              ${tourBookings.length > 0 ? tourBookings.map(tb => `
                <tr>
                  <td><strong>${tb.tour_title}</strong></td>
                  <td>${tb.travel_date}</td>
                  <td>${tb.total_travelers} Persons</td>
                  <td><strong>${formatPrice(tb.total_amount)}</strong></td>
                  <td><span class="badge badge-${tb.status}">${tb.status}</span></td>
                </tr>
              `).join('') : '<tr><td colspan="5" class="muted">No tour bookings recorded.</td></tr>'}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  ` }) %>
</body>
</html>
