<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Zahabia Travel & Tourism</title>
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<body>
  <%- include('../../layout', { body: `
    <div style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: flex-start;">
      <div>
        <a href="/admin/tours" class="btn btn-secondary btn-sm">← Back to Tours</a>
        <h1 style="margin-top: 0.5rem;">${package.title}</h1>
        <p class="muted">📍 ${package.destination} • ${package.duration_days} Days</p>
      </div>
      <div style="display: flex; gap: 0.5rem;">
        <a href="/admin/tours/${package.id}/edit" class="btn btn-primary btn-sm">✏ Edit Package</a>
        <form method="post" action="/admin/tours/${package.id}/delete" style="margin: 0;" onsubmit="return confirm('Delete this tour package?')">
          <button type="submit" class="btn btn-sm" style="background: #c05621; color: #fff;">🗑 Delete</button>
        </form>
      </div>
    </div>

    <div style="display: grid; grid-template-columns: 3fr 2fr; gap: 1.5rem;">
      <!-- Package Details -->
      <div>
        <div class="card" style="margin-bottom: 1.5rem;">
          <h2>Package Overview</h2>
          <p style="font-size: 1.1rem; margin: 1rem 0; color: var(--text-muted);">${package.description}</p>

          <div style="margin-top: 2rem; padding: 1.5rem; background: #f7faf9; border-radius: var(--radius-md);">
            <h3>Package Inclusions</h3>
            <ul style="margin-left: 1.2rem; margin-top: 0.5rem; color: var(--text-muted);">
              <li>5-Star Hotel Accommodations with Breakfast</li>
              <li>Airport Pick-up & VIP Luxury Transport</li>
              <li>English / Arabic Speaking Guided Tours</li>
              <li>Visa Processing Assistance</li>
            </ul>
          </div>
        </div>

        <!-- Confirmed Date Ranges -->
        <div class="card">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <h2 style="margin: 0;">Confirmed Groups (Date Ranges)</h2>
          </div>

          ${dateRanges.length > 0 ? '<div style="display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1.5rem;">' + dateRanges.map((r, i) => `
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1rem; background: #f8fafc; border-radius: var(--radius-sm); border-left: 4px solid ${r.status === 'open' ? '#38a169' : '#d69e2e'};">
              <div>
                <div style="font-weight: 700; font-size: 0.9rem;">${i + 1}${['st','nd','rd'][i] || 'th'} Group: ${r.label}</div>
                <div style="font-size: 0.85rem; color: var(--text-muted);">Departs ${new Date(r.start_date).toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' })} — ${new Date(r.end_date).toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' })}</div>
                ${r.max_capacity ? '<div style="font-size: 0.8rem; color: var(--text-muted);">Capacity: ' + r.max_capacity + ' travelers</div>' : ''}
              </div>
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <span class="badge badge-${r.status}">${r.status}</span>
                <form method="post" action="/admin/tours/${package.id}/daterange/${r.id}/delete" style="margin: 0;" onsubmit="return confirm('Delete this date range?')">
                  <button type="submit" class="btn btn-sm" style="background: #c05621; color: #fff;">✕</button>
                </form>
              </div>
            </div>
          `).join('') + '</div>' : '<p class="muted" style="text-align: center; padding: 1.5rem; border: 1px dashed #e2e8f0; border-radius: var(--radius-sm); margin-bottom: 1.5rem;">No confirmed groups yet. Add date ranges below.</p>'}

          <!-- Add Date Range Form -->
          <h4 style="margin-bottom: 0.75rem;">Add Confirmed Group</h4>
          <form method="post" action="/admin/tours/${package.id}/daterange" style="display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 0.5rem; align-items: end;">
            <div class="form-group" style="margin: 0;">
              <label style="font-size: 0.82rem; font-weight: 700;">Label</label>
              <input type="text" name="label" class="form-control" required placeholder="e.g. First group">
            </div>
            <div class="form-group" style="margin: 0;">
              <label style="font-size: 0.82rem; font-weight: 700;">Start Date</label>
              <input type="date" name="start_date" class="form-control" required>
            </div>
            <div class="form-group" style="margin: 0;">
              <label style="font-size: 0.82rem; font-weight: 700;">End Date</label>
              <input type="date" name="end_date" class="form-control" required>
            </div>
            <div class="form-group" style="margin: 0;">
              <label style="font-size: 0.82rem; font-weight: 700;">Max Capacity</label>
              <input type="number" name="max_capacity" class="form-control" min="1" placeholder="Optional" style="width: 80px;">
            </div>
            <button type="submit" class="btn btn-accent" style="height: fit-content;">Add</button>
          </form>
        </div>
      </div>

      <!-- Book Customer Form -->
      <div class="card">
        <h2>Book Package for Customer</h2>
        <form method="post" action="/admin/tours/book">
          <input type="hidden" name="tour_package_id" value="${package.id}">

          <div class="form-group">
            <label for="customer_id">Select Customer</label>
            <select id="customer_id" name="customer_id" required>
              <option value="">-- Choose Customer --</option>
              ${customers.map(c => `<option value="${c.id}">${c.full_name} (${c.email || c.phone})</option>`).join('')}
            </select>
          </div>

          ${dateRanges.length > 0 ? `
          <div class="form-group">
            <label>Select Travel Dates</label>
            <div style="display: flex; flex-direction: column; gap: 0.5rem;">
              ${dateRanges.filter(r => r.status === 'open').map((r, i) => {
                const remaining = r.max_capacity ? r.max_capacity - (r.current_bookings || 0) : null;
                const isFull = remaining !== null && remaining <= 0;
                return `
                <label style="display: flex; align-items: flex-start; gap: 0.5rem; padding: 0.75rem; background: ${isFull ? '#fef3cd' : '#f8fafc'}; border-radius: var(--radius-sm); border: 1px solid ${isFull ? '#d69e2e' : 'var(--border-light)'}; cursor: ${isFull ? 'not-allowed' : 'pointer'}; opacity: ${isFull ? '0.7' : '1'};">
                  <input type="radio" name="tour_date_range_id" value="${r.id}" ${i === 0 && !isFull ? 'checked' : ''} ${isFull ? 'disabled' : ''} style="margin-top: 0.25rem;">
                  <div style="flex: 1;">
                    <div style="font-weight: 700; font-size: 0.9rem;">${r.label}</div>
                    <div style="font-size: 0.82rem; color: var(--text-muted);">${new Date(r.start_date).toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' })} — ${new Date(r.end_date).toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' })}</div>
                  </div>
                  <div style="text-align: right; font-size: 0.82rem;">
                    ${r.max_capacity ? (isFull ? '<span style="color: #c05621; font-weight: 700;">FULL</span>' : '<span style="color: #38a169; font-weight: 700;">' + remaining + ' seats left</span>') : '<span style="color: var(--text-muted);">Open</span>'}
                  </div>
                </label>`;
              }).join('')}
            </div>
          </div>
          ` : `
          <div class="form-group">
            <label for="travel_date">Travel Date</label>
            <input type="date" id="travel_date" name="travel_date" required class="form-control">
          </div>
          `}

          <div class="form-group">
            <label for="total_travelers">Number of Travelers</label>
            <input type="number" id="total_travelers" name="total_travelers" value="1" min="1" required class="form-control">
          </div>

          <div style="margin: 1.5rem 0; padding: 1rem; background: var(--bg-main); border-radius: var(--radius-sm);">
            <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--text-muted);">Package Price Per Person</div>
            <div style="font-family: var(--font-heading); font-size: 1.8rem; font-weight: 800; color: var(--primary);">${formatPrice(package.price)}</div>
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">1 USD = ${exchangeRates[activeCurrency]?.rate || 1} ${activeCurrency}</div>
          </div>

          <div style="background: #f8fafb; padding: 1.25rem; border-radius: var(--radius-md); border: 1px solid var(--border-light); margin-bottom: 1rem;">
            <h4 style="margin-bottom: 0.75rem; font-size: 0.95rem;">Initial Payment (Optional)</h4>
            <div class="form-group">
              <label for="tour_pay_now">Record Payment Now?</label>
              <select id="tour_pay_now" name="pay_now" onchange="toggleTourPayFields()">
                <option value="no">No — Record Later</option>
                <option value="cash">Yes — Cash</option>
                <option value="bank_transfer">Yes — Bank Deposit / Transfer</option>
                <option value="cheque">Yes — Cheque</option>
                <option value="credit_card">Yes — Credit Card</option>
                <option value="debit_card">Yes — Debit Card</option>
                <option value="online">Yes — Online Payment</option>
                <option value="other">Yes — Other</option>
              </select>
            </div>
            <div id="tourPayAmountGroup" style="display: none;">
              <div class="form-group">
                <label for="tour_pay_amount">Amount Paid (${exchangeRates[activeCurrency]?.symbol || '$'} ${activeCurrency})</label>
                <input type="number" step="0.01" id="tour_pay_amount" name="pay_amount" placeholder="0.00" class="form-control">
                <input type="hidden" id="tour_pay_amount_usd" name="pay_amount_usd">
              </div>
              <div class="form-group">
                <label for="tour_pay_reference">Reference / Cheque No.</label>
                <input type="text" id="tour_pay_reference" name="pay_reference" placeholder="e.g. Transfer Ref" class="form-control">
              </div>
            </div>
          </div>

          <button type="submit" class="btn btn-accent" style="width: 100%;">Confirm Tour Reservation</button>
        </form>
      </div>
    </div>

    <script>
      const EXCHANGE_RATES = ${JSON.stringify(exchangeRates)};
      const ACTIVE_CURRENCY = '${activeCurrency}';
      const rate = EXCHANGE_RATES[ACTIVE_CURRENCY]?.rate || 1;

      function toUSD(localAmount) {
        return (Number(localAmount) / rate).toFixed(6);
      }

      function toggleTourPayFields() {
        const method = document.getElementById('tour_pay_now').value;
        const show = method !== 'no';
        document.getElementById('tourPayAmountGroup').style.display = show ? 'block' : 'none';
      }

      document.querySelector('form[action="/admin/tours/book"]').addEventListener('submit', function() {
        const payAmt = document.getElementById('tour_pay_amount').value;
        if (payAmt) document.getElementById('tour_pay_amount_usd').value = toUSD(payAmt);
      });
    </script>
  ` }) %>
</body>
</html>
