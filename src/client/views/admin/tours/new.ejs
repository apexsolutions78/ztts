<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Zahabia Travel & Tourism</title>
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<body>
  <%- include('../../layout', { body: `
    <div style="margin-bottom: 2rem;">
      <a href="/admin/tours" class="btn btn-secondary btn-sm">← Back to Tours</a>
      <h1 style="margin-top: 0.5rem;">Create New Tour Package</h1>
      <p class="muted">Add a new vacation package or religious tour to the agency catalog.</p>
    </div>

    <div class="card" style="max-width: 800px;">
      ${typeof error !== 'undefined' && error ? `<div class="alert alert-danger">${error}</div>` : ''}

      <form method="post" action="/admin/tours/new" enctype="multipart/form-data">
        <div class="form-group">
          <label for="title">Package Title</label>
          <input type="text" id="title" name="title" placeholder="e.g. 7-Day Swiss Alps & Paris Adventure" required class="form-control">
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="destination">Destination Region / Country</label>
            <input type="text" id="destination" name="destination" placeholder="e.g. Switzerland & France" required class="form-control">
          </div>
          <div class="form-group">
            <label for="duration_days">Duration (Days)</label>
            <input type="number" id="duration_days" name="duration_days" placeholder="7" min="1" required class="form-control">
          </div>
        </div>

        <div class="form-group">
          <label for="price_display">Price Per Person (${exchangeRates[activeCurrency]?.symbol || '$'} ${activeCurrency})</label>
          <input type="number" step="0.000001" id="price_display" name="price_display" placeholder="0.00" required class="form-control" oninput="convertPriceToUSD()">
          <input type="hidden" id="price" name="price">
          <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">1 USD = ${exchangeRates[activeCurrency]?.rate || 1} ${activeCurrency}</div>
        </div>

        <div class="form-row">
          <div class="form-group" style="flex: 2;">
            <label for="image_url">Image URL (optional)</label>
            <input type="text" id="image_url" name="image_url" placeholder="https://..." class="form-control">
          </div>
          <div class="form-group" style="flex: 2;">
            <label for="image_file">Or Upload Image (max 5MB)</label>
            <input type="file" id="image_file" name="image_file" accept="image/*" class="form-control" style="padding: 0.45rem;">
          </div>
        </div>

        <div class="form-group">
          <label for="description">Full Itinerary & Package Details</label>
          <textarea id="description" name="description" rows="4" placeholder="Describe hotel accommodation, inclusions, guided tours, and dining..." class="form-control"></textarea>
        </div>

        <!-- Confirmed Groups / Date Ranges -->
        <div style="margin-top: 1.5rem; padding: 1.25rem; background: #f8fafc; border-radius: var(--radius-md); border: 1px solid var(--border-light);">
          <h3 style="margin-bottom: 0.5rem;">Confirmed Groups (Date Ranges)</h3>
          <p class="muted" style="margin-bottom: 1rem; font-size: 0.85rem;">Add departure dates for this tour. Customers will select from these when booking.</p>
          <div id="dateRangeRows">
            <div class="date-range-row" style="display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 0.5rem; margin-bottom: 0.5rem; align-items: end;">
              <div>
                <label style="font-size: 0.78rem; font-weight: 600;">Label</label>
                <input type="text" name="dr_label[]" class="form-control" placeholder="e.g. First group">
              </div>
              <div>
                <label style="font-size: 0.78rem; font-weight: 600;">Start Date</label>
                <input type="date" name="dr_start[]" class="form-control">
              </div>
              <div>
                <label style="font-size: 0.78rem; font-weight: 600;">End Date</label>
                <input type="date" name="dr_end[]" class="form-control">
              </div>
              <div>
                <label style="font-size: 0.78rem; font-weight: 600;">Max</label>
                <input type="number" name="dr_capacity[]" class="form-control" min="1" placeholder="∞" style="width: 70px;">
              </div>
            </div>
          </div>
          <button type="button" onclick="addDateRangeRow()" class="btn btn-secondary btn-sm" style="margin-top: 0.5rem;">+ Add Another Group</button>
        </div>

        <div style="margin-top: 1.5rem; display: flex; gap: 1rem;">
          <button type="submit" class="btn btn-accent">Publish Tour Package</button>
          <a href="/admin/tours" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>

    <script>
      const EXCHANGE_RATES = ${JSON.stringify(exchangeRates)};
      const ACTIVE_CURRENCY = '${activeCurrency}';
      const rate = EXCHANGE_RATES[ACTIVE_CURRENCY]?.rate || 1;

      function convertPriceToUSD() {
        const localPrice = document.getElementById('price_display').value;
        const usd = (Number(localPrice) / rate).toFixed(6);
        document.getElementById('price').value = usd;
      }

      let drIndex = 1;
      function addDateRangeRow() {
        const container = document.getElementById('dateRangeRows');
        const row = document.createElement('div');
        row.className = 'date-range-row';
        row.style.cssText = 'display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 0.5rem; margin-bottom: 0.5rem; align-items: end;';
        row.innerHTML = '<div><input type="text" name="dr_label[]" class="form-control" placeholder="e.g. Second group"></div>' +
          '<div><input type="date" name="dr_start[]" class="form-control"></div>' +
          '<div><input type="date" name="dr_end[]" class="form-control"></div>' +
          '<div><input type="number" name="dr_capacity[]" class="form-control" min="1" placeholder="∞" style="width: 70px;"></div>';
        container.appendChild(row);
        drIndex++;
      }
    </script>
  ` }) %>
</body>
</html>
