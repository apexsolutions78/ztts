<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Zahabia Travel & Tourism</title>
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<body>
  <%- include('../../layout', { body: `
    <div style="margin-bottom: 2rem;">
      <a href="/admin/tours" class="btn btn-secondary btn-sm">← Back to Tours</a>
      <h1 style="margin-top: 0.5rem;">Edit Tour Package</h1>
      <p class="muted">Update package details, pricing, and status</p>
    </div>

    <div class="card" style="max-width: 800px;">
      ${typeof error !== 'undefined' && error ? '<div class="alert alert-danger">' + error + '</div>' : ''}

      <form method="post" action="/admin/tours/${package.id}/edit" enctype="multipart/form-data">
        <div class="form-group">
          <label for="title">Package Title</label>
          <input type="text" id="title" name="title" value="${package.title}" required class="form-control">
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="destination">Destination Region / Country</label>
            <input type="text" id="destination" name="destination" value="${package.destination}" required class="form-control">
          </div>
          <div class="form-group">
            <label for="duration_days">Duration (Days)</label>
            <input type="number" id="duration_days" name="duration_days" value="${package.duration_days}" min="1" required class="form-control">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="price">Price Per Person ($ USD)</label>
            <input type="number" step="0.01" id="price" name="price" value="${package.price}" required class="form-control">
          </div>
          <div class="form-group">
            <label for="status">Status</label>
            <select id="status" name="status">
              <option value="active" ${package.status === 'active' ? 'selected' : ''}>Active</option>
              <option value="draft" ${package.status === 'draft' ? 'selected' : ''}>Draft</option>
              <option value="archived" ${package.status === 'archived' ? 'selected' : ''}>Archived</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label for="description">Full Itinerary & Package Details</label>
          <textarea id="description" name="description" rows="4" class="form-control">${package.description || ''}</textarea>
        </div>

        ${package.image_url && package.image_url !== '/static/img/default_tour.jpg' ? `
        <div style="margin-bottom: 1rem;">
          <label style="font-size: 0.85rem; font-weight: 600;">Current Image</label>
          <div style="margin-top: 0.5rem;">
            <img src="${package.image_url}" alt="Current tour image" style="max-width: 200px; border-radius: var(--radius-sm); border: 1px solid var(--border-light);">
          </div>
        </div>
        ` : ''}

        <div class="form-row">
          <div class="form-group" style="flex: 2;">
            <label for="image_url">Image URL (optional)</label>
            <input type="text" id="image_url" name="image_url" value="${package.image_url || ''}" class="form-control">
          </div>
          <div class="form-group" style="flex: 2;">
            <label for="image_file">Or Upload New Image (max 5MB)</label>
            <input type="file" id="image_file" name="image_file" accept="image/*" class="form-control" style="padding: 0.45rem;">
          </div>
        </div>

        <div style="margin-top: 1.5rem; display: flex; gap: 1rem;">
          <button type="submit" class="btn btn-accent">Save Changes</button>
          <a href="/admin/tours" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  ` }) %>
</body>
</html>
