<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Zahabia Travel & Tourism</title>
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<body>
  <%- include('../../layout', { body: `
    <div style="margin-bottom: 2rem;">
      <a href="/admin/tours" class="btn btn-secondary btn-sm">← Back to Tours</a>
      <h1 style="margin-top: 0.5rem;">Edit Tour Package</h1>
      <p class="muted">Update package details, pricing, and status</p>
    </div>

    <div class="card" style="max-width: 800px;">
      ${typeof error !== 'undefined' && error ? '<div class="alert alert-danger">' + error + '</div>' : ''}

      <form method="post" action="/admin/tours/${package.id}/edit" enctype="multipart/form-data">
        <div class="form-group">
          <label for="title">Package Title</label>
          <input type="text" id="title" name="title" value="${package.title}" required class="form-control">
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="destination">Destination Region / Country</label>
            <input type="text" id="destination" name="destination" value="${package.destination}" required class="form-control">
          </div>
          <div class="form-group">
            <label for="duration_days">Duration (Days)</label>
            <input type="number" id="duration_days" name="duration_days" value="${package.duration_days}" min="1" required class="form-control">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="price_display">Price Per Person (${exchangeRates[activeCurrency]?.symbol || '$'} ${activeCurrency})</label>
            <input type="number" step="0.000001" id="price_display" value="${(package.price * (exchangeRates[activeCurrency]?.rate || 1)).toFixed(2)}" required class="form-control" oninput="convertPriceToUSD()">
            <input type="hidden" id="price" name="price" value="${package.price}">
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">1 USD = ${exchangeRates[activeCurrency]?.rate || 1} ${activeCurrency}</div>
          </div>
          <div class="form-group">
            <label for="status">Status</label>
            <select id="status" name="status">
              <option value="active" ${package.status === 'active' ? 'selected' : ''}>Active</option>
              <option value="draft" ${package.status === 'draft' ? 'selected' : ''}>Draft</option>
              <option value="archived" ${package.status === 'archived' ? 'selected' : ''}>Archived</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label for="description">Full Itinerary & Package Details</label>
          <textarea id="description" name="description" rows="4" class="form-control">${package.description || ''}</textarea>
        </div>

        <!-- Confirmed Groups / Date Ranges -->
        <div style="margin-top: 1.5rem; padding: 1.25rem; background: #f8fafc; border-radius: var(--radius-md); border: 1px solid var(--border-light);">
          <h3 style="margin-bottom: 0.5rem;">Confirmed Groups (Date Ranges)</h3>
          <p class="muted" style="margin-bottom: 1rem; font-size: 0.85rem;">Manage departure dates for this tour.</p>

          ${dateRanges.length > 0 ? '<div style="margin-bottom: 1rem;">' + dateRanges.map((r, i) => `
            <div style="display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.75rem; background: #fff; border-radius: var(--radius-sm); border: 1px solid var(--border-light); margin-bottom: 0.5rem;">
              <div style="flex: 1;">
                <strong>${r.label}</strong> — ${new Date(r.start_date).toLocaleDateString()} to ${new Date(r.end_date).toLocaleDateString()}
                ${r.max_capacity ? ' (Max: ' + r.max_capacity + ')' : ''}
              </div>
              <span class="badge badge-${r.status}">${r.status}</span>
              <form method="post" action="/admin/tours/${package.id}/daterange/${r.id}/delete" style="margin: 0;" onsubmit="return confirm('Delete this date range?')">
                <button type="submit" class="btn btn-sm" style="background: #c05621; color: #fff;">✕</button>
              </form>
            </div>
          `).join('') + '</div>' : '<p class="muted" style="margin-bottom: 1rem; font-size: 0.85rem;">No confirmed groups yet.</p>'}

          <h4 style="margin-bottom: 0.5rem; font-size: 0.9rem;">Add New Group</h4>
          <div id="dateRangeRows">
            <div class="date-range-row" style="display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 0.5rem; margin-bottom: 0.5rem; align-items: end;">
              <div>
                <label style="font-size: 0.78rem; font-weight: 600;">Label</label>
                <input type="text" name="dr_label[]" class="form-control" placeholder="e.g. First group">
              </div>
              <div>
                <label style="font-size: 0.78rem; font-weight: 600;">Start Date</label>
                <input type="date" name="dr_start[]" class="form-control">
              </div>
              <div>
                <label style="font-size: 0.78rem; font-weight: 600;">End Date</label>
                <input type="date" name="dr_end[]" class="form-control">
              </div>
              <div>
                <label style="font-size: 0.78rem; font-weight: 600;">Max</label>
                <input type="number" name="dr_capacity[]" class="form-control" min="1" placeholder="∞" style="width: 70px;">
              </div>
            </div>
          </div>
          <button type="button" onclick="addDateRangeRow()" class="btn btn-secondary btn-sm" style="margin-top: 0.5rem;">+ Add Another Group</button>
        </div>

        ${package.image_url && package.image_url !== '/static/img/default_tour.jpg' ? `
        <div style="margin-bottom: 1rem;">
          <label style="font-size: 0.85rem; font-weight: 600;">Current Image</label>
          <div style="margin-top: 0.5rem;">
            <img src="${package.image_url}" alt="Current tour image" style="max-width: 200px; border-radius: var(--radius-sm); border: 1px solid var(--border-light);">
          </div>
        </div>
        ` : ''}

        <div class="form-row">
          <div class="form-group" style="flex: 2;">
            <label for="image_url">Image URL (optional)</label>
            <input type="text" id="image_url" name="image_url" value="${package.image_url || ''}" class="form-control">
          </div>
          <div class="form-group" style="flex: 2;">
            <label for="image_file">Or Upload New Image (max 5MB)</label>
            <input type="file" id="image_file" name="image_file" accept="image/*" class="form-control" style="padding: 0.45rem;">
          </div>
        </div>

        <div style="margin-top: 1.5rem; display: flex; gap: 1rem;">
          <button type="submit" class="btn btn-accent">Save Changes</button>
          <a href="/admin/tours" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>

    <script>
      const EXCHANGE_RATES = ${JSON.stringify(exchangeRates)};
      const ACTIVE_CURRENCY = '${activeCurrency}';
      const rate = EXCHANGE_RATES[ACTIVE_CURRENCY]?.rate || 1;

      function convertPriceToUSD() {
        const localPrice = document.getElementById('price_display').value;
        const usd = (Number(localPrice) / rate).toFixed(6);
        document.getElementById('price').value = usd;
      }

      let drIndex = 1;
      function addDateRangeRow() {
        const container = document.getElementById('dateRangeRows');
        const row = document.createElement('div');
        row.className = 'date-range-row';
        row.style.cssText = 'display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 0.5rem; margin-bottom: 0.5rem; align-items: end;';
        row.innerHTML = '<div><input type="text" name="dr_label[]" class="form-control" placeholder="e.g. Second group"></div>' +
          '<div><input type="date" name="dr_start[]" class="form-control"></div>' +
          '<div><input type="date" name="dr_end[]" class="form-control"></div>' +
          '<div><input type="number" name="dr_capacity[]" class="form-control" min="1" placeholder="∞" style="width: 70px;"></div>';
        container.appendChild(row);
        drIndex++;
      }
    </script>
  ` }) %>
</body>
</html>
