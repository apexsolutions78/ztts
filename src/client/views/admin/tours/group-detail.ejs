<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Zahabia Travel & Tourism</title>
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<body>
  <%- include('../../layout', { body: `
    <div style="margin-bottom: 1.5rem;">
      <a href="/admin/tours/groups" class="btn btn-secondary btn-sm">← Back to Groups</a>
      <h1 style="margin-top: 0.5rem;">${group.title}</h1>
      <p class="muted">Group Tour Draft &amp; Configuration</p>
    </div>

    <!-- Status Badge + Finalize Button -->
    <div style="display: flex; gap: 0.5rem; align-items: center; margin-bottom: 1.5rem;">
      <span class="badge badge-${group.status}" style="padding: 0.5rem 1rem; font-size: 0.85rem; text-transform: uppercase;">${group.status}</span>
      ${group.guide_name ? '<span style="background: #edf4f2; padding: 0.5rem 1rem; border-radius: var(--radius-sm); font-size: 0.82rem;">Guide: <strong>' + group.guide_name + '</strong></span>' : ''}
      ${group.tour_destination ? '<span style="background: #edf4f2; padding: 0.5rem 1rem; border-radius: var(--radius-sm); font-size: 0.82rem;">📍 ' + group.tour_destination + '</span>' : ''}
      ${group.status === 'draft' ? '<form method="post" action="/admin/tours/group/' + group.id + '/finalize" style="margin-left: auto;"><button type="submit" class="btn btn-accent" onclick="return confirm(\'Finalize this group? Milestones will become read-only.\')">Finalize Group Tour</button></form>' : ''}
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
      <!-- Left Column: Summary -->
      <div class="card">
        <h3>Tour Summary</h3>
        <div style="display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem;">
          <div>
            <span style="font-size: 0.72rem; text-transform: uppercase; color: var(--text-muted);">Package</span>
            <div style="font-weight: 700;">${group.tour_title}</div>
          </div>
          <div>
            <span style="font-size: 0.72rem; text-transform: uppercase; color: var(--text-muted);">Customer</span>
            <div style="font-weight: 700;">${group.customer_name || 'N/A'}</div>
          </div>
          <div>
            <span style="font-size: 0.72rem; text-transform: uppercase; color: var(--text-muted);">Travel Date</span>
            <div style="font-weight: 700;">${group.travel_date ? new Date(group.travel_date).toLocaleDateString() : 'TBD'}</div>
          </div>
          <div>
            <span style="font-size: 0.72rem; text-transform: uppercase; color: var(--text-muted);">Duration</span>
            <div style="font-weight: 700;">${group.duration_days} Days</div>
          </div>
          <div>
            <span style="font-size: 0.72rem; text-transform: uppercase; color: var(--text-muted);">Travelers in Booking</span>
            <div style="font-weight: 700;">${group.total_travelers} Person(s)</div>
          </div>
          <div>
            <span style="font-size: 0.72rem; text-transform: uppercase; color: var(--text-muted);">Total Amount</span>
            <div style="font-weight: 700; color: var(--primary);">${formatPrice(group.total_amount)}</div>
          </div>
        </div>
      </div>

      <!-- Right Column: Edit Form -->
      <div class="card">
        <h3>Edit Group Tour Draft</h3>
        <form method="post" action="/admin/tours/group/${group.id}/edit" style="display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem;">
          <div class="form-group">
            <label style="display: block; font-size: 0.82rem; font-weight: 700; margin-bottom: 0.3rem;">Title</label>
            <input type="text" name="title" class="form-control" value="${group.title}" required>
          </div>
          <div class="form-group">
            <label style="display: block; font-size: 0.82rem; font-weight: 700; margin-bottom: 0.3rem;">Status</label>
            <select name="status" class="form-control">
              <option value="draft" ${group.status === 'draft' ? 'selected' : ''}>Draft</option>
              <option value="finalized" ${group.status === 'finalized' ? 'selected' : ''}>Finalized</option>
              <option value="active" ${group.status === 'active' ? 'selected' : ''}>Active</option>
              <option value="completed" ${group.status === 'completed' ? 'selected' : ''}>Completed</option>
              <option value="cancelled" ${group.status === 'cancelled' ? 'selected' : ''}>Cancelled</option>
            </select>
          </div>
          <div class="form-group">
            <label style="display: block; font-size: 0.82rem; font-weight: 700; margin-bottom: 0.3rem;">Assigned Guide</label>
            <select name="assigned_guide_user_id" class="form-control">
              <option value="">-- None --</option>
              ${users.map(u => '<option value="' + u.id + '" ' + (group.assigned_guide_user_id == u.id ? 'selected' : '') + '>' + u.name + ' (' + u.role + ')</option>').join('')}
            </select>
          </div>
          <div class="form-group">
            <label style="display: block; font-size: 0.82rem; font-weight: 700; margin-bottom: 0.3rem;">Expected Group Size</label>
            <input type="number" name="group_size_expected" class="form-control" min="1" value="${group.group_size_expected || ''}">
          </div>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
            <div class="form-group">
              <label style="display: block; font-size: 0.82rem; font-weight: 700; margin-bottom: 0.3rem;">Start Date & Time</label>
              <input type="datetime-local" name="start_at" class="form-control" value="${group.start_at ? new Date(group.start_at).toISOString().slice(0, 16) : ''}">
            </div>
            <div class="form-group">
              <label style="display: block; font-size: 0.82rem; font-weight: 700; margin-bottom: 0.3rem;">End Date & Time</label>
              <input type="datetime-local" name="end_at" class="form-control" value="${group.end_at ? new Date(group.end_at).toISOString().slice(0, 16) : ''}">
            </div>
          </div>
          <div class="form-group">
            <label style="display: block; font-size: 0.82rem; font-weight: 700; margin-bottom: 0.3rem;">Welcome Message</label>
            <textarea name="welcome_message" class="form-control" rows="3">${group.welcome_message || ''}</textarea>
          </div>
          <div class="form-group">
            <label style="display: block; font-size: 0.82rem; font-weight: 700; margin-bottom: 0.3rem;">Emergency Instructions</label>
            <textarea name="emergency_instructions" class="form-control" rows="3">${group.emergency_instructions || ''}</textarea>
          </div>
          <button type="submit" class="btn btn-primary">Save Changes</button>
        </form>
      </div>
    </div>

    <!-- Milestones Section -->
    <div class="card" style="margin-top: 1.5rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h3 style="margin: 0;">Itinerary Milestones</h3>
        ${group.status === 'draft' ? '<span style="font-size: 0.82rem; color: var(--text-muted);">Editable while draft</span>' : '<span style="font-size: 0.82rem; color: var(--text-muted);">🔒 Read-only after finalization</span>'}
      </div>

      <!-- Milestone List -->
      ${milestones.length > 0 ? '<div style="display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1.5rem;">' + milestones.map(m => `
        <div style="display: flex; align-items: flex-start; gap: 0.75rem; padding: 0.75rem 1rem; background: #f8fafc; border-radius: var(--radius-sm); border-left: 4px solid ${m.status === 'completed' ? '#38a169' : '#d69e2e'};">
          <div style="flex: 1;">
            <div style="font-weight: 700; font-size: 0.9rem;">${m.title}</div>
            ${m.description ? '<div style="font-size: 0.82rem; color: var(--text-muted); margin-top: 0.25rem;">' + m.description + '</div>' : ''}
          </div>
          ${group.status === 'draft' ? '<div style="display: flex; gap: 0.5rem;"><form method="post" action="/admin/tours/group/' + group.id + '/milestone/' + m.id + '/delete" onsubmit="return confirm(\'Delete milestone?\')"><button type="submit" class="btn btn-sm" style="background: #e53e3e; color: #fff;">Delete</button></form></div>' : ''}
        </div>
      `).join('') + '</div>' : '<p class="muted" style="text-align: center; padding: 1.5rem; border: 1px dashed #e2e8f0; border-radius: var(--radius-sm); margin-bottom: 1.5rem;">No milestones yet. Define the group itinerary below.</p>'}

      <!-- Add Milestone Form (only when draft) -->
      ${group.status === 'draft' ? `
        <h4 style="margin-bottom: 0.75rem;">Add Milestone</h4>
        <form method="post" action="/admin/tours/group/${group.id}/milestone" style="display: grid; grid-template-columns: 1fr auto auto; gap: 0.5rem; align-items: end;">
          <div class="form-group" style="margin: 0;">
            <label style="display: block; font-size: 0.82rem; font-weight: 700; margin-bottom: 0.3rem;">Title</label>
            <input type="text" name="title" class="form-control" required placeholder="e.g. Airport Pickup">
          </div>
          <div class="form-group" style="margin: 0;">
            <label style="display: block; font-size: 0.82rem; font-weight: 700; margin-bottom: 0.3rem;">Sort</label>
            <input type="number" name="sort_order" class="form-control" value="0" style="width: 60px;">
          </div>
          <div class="form-group" style="margin: 0;">
            <label style="display: block; font-size: 0.82rem; font-weight: 700; margin-bottom: 0.3rem;">Description</label>
            <input type="text" name="description" class="form-control" placeholder="Optional details" style="width: 250px;">
          </div>
          <button type="submit" class="btn btn-accent" style="height: fit-content;">Add</button>
        </form>
      ` : ''}
    </div>
  ` }) %>
</body>
</html>
