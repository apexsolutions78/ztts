<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Zahabia Travel & Tourism</title>
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<body>
  <%- include('../../layout', { body: `
    <div style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
      <div>
        <a href="/admin/tours" class="btn btn-secondary btn-sm">← Back to Tours</a>
        <h1 style="margin-top: 0.5rem;">Tour Booking: ${booking.tour_title}</h1>
        <p class="muted">Reservation #${booking.id} — ${booking.customer_name}</p>
      </div>
      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; justify-content: flex-end;">
        <button id="shareBtn" onclick="generateShareLink(${booking.id})" class="btn btn-accent">🔗 Share Portal Link</button>
        ${booking.status !== 'cancelled' ? `
          <form method="post" action="/admin/tours/bookings/${booking.id}/cancel" style="margin: 0;" onsubmit="return confirm('Cancel this tour booking? This action cannot be undone.')">
            <button type="submit" class="btn btn-sm" style="background: #e53e3e; color: #fff;">✖ Cancel Booking</button>
          </form>
        ` : `<span class="badge" style="background: #fed7d7; color: #c53030; padding: 0.6rem 1.2rem; font-size: 0.9rem;">✖ CANCELLED</span>`}
      </div>
    </div>

    <!-- Share Link Box -->
    <div id="shareBox" style="display: none;" class="alert alert-success">
      <strong>Customer Portal Access Link Generated:</strong>
      <div style="margin-top: 0.5rem; display: flex; gap: 1rem; align-items: flex-start; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 250px;">
          <div style="display: flex; gap: 0.5rem;">
            <input type="text" id="shareUrlInput" readonly class="form-control" style="background: #fff;">
            <button onclick="copyShareUrl()" class="btn btn-secondary btn-sm">Copy Link</button>
            <a id="openPortalLink" href="#" target="_blank" class="btn btn-primary btn-sm">Open Portal →</a>
          </div>
        </div>
        <div style="text-align: center;">
          <img id="shareQR" src="" alt="Portal QR Code" style="width: 130px; height: 130px; border: 2px solid var(--primary); border-radius: 8px; padding: 4px; background: #fff; display: none;">
          <div style="font-size: 0.7rem; color: var(--text-muted); margin-top: 0.3rem;">Scan to open portal</div>
        </div>
      </div>
    </div>

    <!-- Tour Booking Card -->
    <div class="ticket-wrapper">
      <div class="ticket-header">
        <div class="ticket-airline-brand">
          <img src="/brand/LOGO123.png" alt="Zahabia Logo" style="height: 50px;" onerror="this.src='/brand/Golden_airplane_circling_globe_20260914222838.gif';">
          <div>
            <h2>ZAHABIA TOURISM</h2>
            <span style="font-size: 0.8rem; color: var(--accent-gold); text-transform: uppercase;">Tour Reservation Confirmation</span>
          </div>
        </div>
        <div style="text-align: right;">
          <span style="font-size: 0.8rem; text-transform: uppercase; color: #a0aec0;">Booking Reference</span>
          <div style="font-family: var(--font-heading); font-size: 2rem; font-weight: 800; color: var(--accent-gold);">TOUR-${booking.id}</div>
        </div>
      </div>

      <div class="ticket-body">
        <!-- Status Bar -->
        <div style="background: #edf4f2; padding: 0.85rem 1.25rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
          <div>
            <span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted);">BOOKING STATUS</span>
            <div style="font-weight: 800; font-size: 1.1rem; color: var(--primary);">
              STATUS: <span class="badge badge-${booking.status}">${booking.status.toUpperCase()}</span>
            </div>
          </div>
          <div style="display: flex; gap: 1.5rem; font-size: 0.88rem;">
            <div><strong>Destination:</strong> ${package ? package.destination : 'N/A'}</div>
            <div><strong>Duration:</strong> ${package ? package.duration_days + ' Days' : 'N/A'}</div>
          </div>
        </div>

        <!-- Tour Info Grid -->
        <div class="ticket-grid">
          <div class="ticket-field">
            <label>Tour Package</label>
            <val>${booking.tour_title}</val>
          </div>
          <div class="ticket-field">
            <label>Customer Name</label>
            <val>${booking.customer_name}</val>
          </div>
          <div class="ticket-field">
            <label>Customer Email</label>
            <val>${booking.customer_email || 'N/A'}</val>
          </div>
          <div class="ticket-field">
            <label>Customer Phone</label>
            <val>${booking.customer_phone || 'N/A'}</val>
          </div>
          <div class="ticket-field">
            <label>Travel Date</label>
            <val>${new Date(booking.travel_date).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}</val>
          </div>
          <div class="ticket-field">
            <label>Number of Travelers</label>
            <val>${booking.total_travelers}</val>
          </div>
          <div class="ticket-field">
            <label>Total Tour Cost</label>
            <val style="font-size: 1.3rem; color: var(--primary); font-weight: 800;">${formatPrice(booking.total_amount)}</val>
          </div>
          <div class="ticket-field">
            <label>Booking Date</label>
            <val>${new Date(booking.created_at).toLocaleDateString()}</val>
          </div>
        </div>

        <!-- QR Code Section -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1.5rem; padding: 1rem; background: #f0f4f8; border-radius: var(--radius-sm); border: 1px dashed #cbd5e0;">
          <div>
            <div style="font-size: 0.72rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted);">Customer Portal QR Code</div>
            <div style="font-family: monospace; font-size: 0.9rem; font-weight: 700; color: var(--primary);">TOUR-${booking.id}-ZAHABIA</div>
            <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.2rem;">Scan to open tour portal</div>
          </div>
          <img id="ticketQR" src="" alt="Portal QR Code" style="width: 110px; height: 110px; border: 2px solid var(--primary); border-radius: 8px; padding: 4px; background: #fff; display: none;">
          <div id="ticketQRPlaceholder" style="width: 110px; height: 110px; border: 2px dashed #cbd5e0; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; color: #a0aec0; text-align: center; padding: 0.5rem;">Click "Share Portal Link" to generate</div>
        </div>
      </div>
    </div>

    <!-- Payment Management -->
    <div class="card" style="margin-top: 2rem;" id="paymentSection">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h3>Payment Management</h3>
        ${booking.status !== 'cancelled' ? `<button onclick="togglePaymentForm()" class="btn btn-primary btn-sm" id="addPaymentBtn">+ Record Payment</button>` : ''}
      </div>

      <!-- Payment Summary -->
      <div id="paymentSummary" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
        <div style="background: #edf4f2; padding: 1rem; border-radius: var(--radius-sm); text-align: center;">
          <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Total Amount</div>
          <div style="font-size: 1.4rem; font-weight: 800; color: var(--primary);" id="payTotalAmount">--</div>
        </div>
        <div style="background: #edf7ed; padding: 1rem; border-radius: var(--radius-sm); text-align: center;">
          <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Paid</div>
          <div style="font-size: 1.4rem; font-weight: 800; color: #38a169;" id="payTotalPaid">--</div>
        </div>
        <div style="background: #fef3cd; padding: 1rem; border-radius: var(--radius-sm); text-align: center;">
          <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Balance Due</div>
          <div style="font-size: 1.4rem; font-weight: 800; color: #d69e2e;" id="payBalance">--</div>
        </div>
        <div style="background: #f0f4f8; padding: 1rem; border-radius: var(--radius-sm); text-align: center;">
          <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Status</div>
          <div style="font-size: 1.4rem; font-weight: 800;" id="payStatus">--</div>
        </div>
      </div>

      <!-- Add Payment Form -->
      <div id="paymentForm" style="display: none; background: #f8fafb; padding: 1.5rem; border-radius: var(--radius-md); margin-bottom: 1.5rem; border: 1px solid var(--border-light);">
        <h4 style="margin-bottom: 1rem;">Record New Payment</h4>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
          <div>
            <label style="font-size: 0.8rem; font-weight: 600; display: block; margin-bottom: 0.3rem;">Amount (${exchangeRates[activeCurrency]?.symbol || '$'} ${activeCurrency})</label>
            <input type="number" id="payAmount" step="0.01" min="0.01" class="form-control" placeholder="0.00" style="width: 100%;">
            <input type="hidden" id="payAmountUSD">
          </div>
          <div>
            <label style="font-size: 0.8rem; font-weight: 600; display: block; margin-bottom: 0.3rem;">Payment Method</label>
            <select id="payMethod" class="form-control" style="width: 100%;">
              <option value="cash">Cash</option>
              <option value="bank_transfer">Bank Deposit / Transfer</option>
              <option value="cheque">Cheque</option>
              <option value="credit_card">Credit Card</option>
              <option value="debit_card">Debit Card</option>
              <option value="online">Online Payment</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div>
            <label style="font-size: 0.8rem; font-weight: 600; display: block; margin-bottom: 0.3rem;">Reference / Cheque No.</label>
            <input type="text" id="payReference" class="form-control" placeholder="e.g. Cheque #12345, Transfer Ref" style="width: 100%;">
          </div>
          <div>
            <label style="font-size: 0.8rem; font-weight: 600; display: block; margin-bottom: 0.3rem;">Notes</label>
            <input type="text" id="payNotes" class="form-control" placeholder="Optional notes" style="width: 100%;">
          </div>
        </div>
        <div style="margin-top: 0.75rem; padding: 0.75rem 1rem; background: #f0f4f8; border-radius: var(--radius-sm); cursor: pointer;" onclick="document.getElementById('breakdownFields').style.display = document.getElementById('breakdownFields').style.display === 'none' ? 'block' : 'none'">
          <span style="font-size: 0.8rem; font-weight: 600; color: var(--primary);">Invoice Breakdown (Optional) — Base Fare, Taxes, Agency Fee</span>
        </div>
        <div id="breakdownFields" style="display: none; margin-top: 0.75rem;">
          <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
            <div>
              <label style="font-size: 0.8rem; font-weight: 600; display: block; margin-bottom: 0.3rem;">Base Fare ($)</label>
              <input type="number" step="0.01" id="payBaseFare" class="form-control" placeholder="0.00" style="width: 100%;">
            </div>
            <div>
              <label style="font-size: 0.8rem; font-weight: 600; display: block; margin-bottom: 0.3rem;">Taxes & Fees ($)</label>
              <input type="number" step="0.01" id="payTaxAmount" class="form-control" placeholder="0.00" style="width: 100%;">
            </div>
            <div>
              <label style="font-size: 0.8rem; font-weight: 600; display: block; margin-bottom: 0.3rem;">Agency Fee ($)</label>
              <input type="number" step="0.01" id="payAgencyFee" class="form-control" placeholder="0.00" style="width: 100%;">
            </div>
          </div>
        </div>
        <div style="margin-top: 1rem; display: flex; gap: 0.75rem;">
          <button onclick="submitPayment()" class="btn btn-primary" id="submitPayBtn">Save Payment</button>
          <button onclick="togglePaymentForm()" class="btn btn-secondary">Cancel</button>
        </div>
      </div>

      <!-- Payment History -->
      <h4 style="margin-bottom: 0.75rem;">Payment History</h4>
      <div class="table-responsive">
        <table class="data-table" id="paymentTable">
          <thead>
            <tr>
              <th>Date</th>
              <th>Invoice</th>
              <th>Method</th>
              <th>Reference</th>
              <th>Amount</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="paymentTableBody">
            <tr><td colspan="7" class="muted" style="text-align: center;">Loading payments...</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <script>
      const BOOKING_TYPE = 'tour';
      const BOOKING_ID = ${booking.id};
      const BOOKING_TOTAL = ${booking.total_amount};
      const EXCHANGE_RATES = ${JSON.stringify(exchangeRates)};
      const ACTIVE_CURRENCY = '${activeCurrency}';
      const CURRENCY_RATE = EXCHANGE_RATES[ACTIVE_CURRENCY]?.rate || 1;
      const PORTAL_TOKEN = ${portalToken ? "'" + portalToken + "'" : 'null'};

      function formatPrice(amount) {
        return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(amount || 0);
      }

      function toUSD(localAmount) {
        return (Number(localAmount) / CURRENCY_RATE).toFixed(2);
      }

      function fmtLocal(amountInUSD) {
        const curr = EXCHANGE_RATES[ACTIVE_CURRENCY] || { symbol: '$', rate: 1 };
        const converted = Number(amountInUSD || 0) * curr.rate;
        return curr.symbol + converted.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
      }

      async function generateShareLink(id) {
        try {
          const res = await fetch('/admin/tours/bookings/' + id + '/share');
          const data = await res.json();
          if (data.success) {
            document.getElementById('shareBox').style.display = 'block';
            document.getElementById('shareUrlInput').value = data.shareUrl;
            document.getElementById('openPortalLink').href = data.shareUrl;
            const qrImg = document.getElementById('shareQR');
            qrImg.src = '/t/' + data.token + '/qr';
            qrImg.style.display = 'block';
            const ticketQR = document.getElementById('ticketQR');
            const ticketQRPlaceholder = document.getElementById('ticketQRPlaceholder');
            if (ticketQR) {
              ticketQR.src = '/t/' + data.token + '/qr';
              ticketQR.style.display = 'block';
              ticketQRPlaceholder.style.display = 'none';
            }
          }
        } catch (err) {
          alert('Failed to generate portal link');
        }
      }

      function copyShareUrl() {
        const input = document.getElementById('shareUrlInput');
        input.select();
        document.execCommand('copy');
        alert('Copied link to clipboard!');
      }

      async function loadPayments() {
        try {
          const res = await fetch('/admin/payments/' + BOOKING_TYPE + '/' + BOOKING_ID + '/summary');
          const data = await res.json();
          if (!data.success) return;
          const s = data.data;
          document.getElementById('payTotalAmount').textContent = fmtLocal(s.totalAmount);
          document.getElementById('payTotalPaid').textContent = fmtLocal(s.totalPaid);
          document.getElementById('payBalance').textContent = fmtLocal(s.balance);
          const statusEl = document.getElementById('payStatus');
          if (s.isFullyPaid) {
            statusEl.textContent = 'PAID IN FULL';
            statusEl.style.color = '#38a169';
          } else if (s.paymentCount > 0) {
            statusEl.textContent = 'PARTIAL';
            statusEl.style.color = '#d69e2e';
          } else {
            statusEl.textContent = 'UNPAID';
            statusEl.style.color = '#e53e3e';
          }
          const tbody = document.getElementById('paymentTableBody');
          if (!s.payments || s.payments.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" class="muted" style="text-align: center;">No payments recorded yet.</td></tr>';
            return;
          }
          const methodLabels = { cash: 'Cash', bank_transfer: 'Bank Transfer', cheque: 'Cheque', credit_card: 'Credit Card', debit_card: 'Debit Card', online: 'Online', other: 'Other' };
          tbody.innerHTML = s.payments.map(p => '<tr>' +
            '<td>' + new Date(p.created_at).toLocaleDateString() + '</td>' +
            '<td><strong>' + (p.invoice_no || '-') + '</strong></td>' +
            '<td>' + (methodLabels[p.payment_method] || p.payment_method) + '</td>' +
            '<td>' + (p.payment_reference || '-') + '</td>' +
            '<td><strong style="color: var(--primary);">' + fmtLocal(p.amount) + '</strong></td>' +
            '<td><span class="badge badge-' + p.payment_status + '">' + p.payment_status.toUpperCase() + '</span></td>' +
            '<td><button onclick="voidPayment(' + p.id + ')" class="btn btn-sm" style="background: #e53e3e; color: #fff; padding: 0.3rem 0.6rem; font-size: 0.75rem;">Void</button></td>' +
            '</tr>').join('');
        } catch (err) {
          console.error('Failed to load payments:', err);
        }
      }

      function togglePaymentForm() {
        const form = document.getElementById('paymentForm');
        const isVisible = form.style.display !== 'none';
        form.style.display = isVisible ? 'none' : 'block';
        if (!isVisible) {
          const balance = parseFloat(document.getElementById('payBalance').textContent.replace(/[^0-9.-]/g, '')) || 0;
          const localBalance = (balance * CURRENCY_RATE).toFixed(2);
          const symbol = EXCHANGE_RATES[ACTIVE_CURRENCY]?.symbol || '$';
          const input = document.getElementById('payAmount');
          input.placeholder = symbol + localBalance + ' remaining';
          input.value = balance > 0 ? localBalance : '';
        }
      }

      async function submitPayment() {
        const localAmount = document.getElementById('payAmount').value;
        const payment_method = document.getElementById('payMethod').value;
        const payment_reference = document.getElementById('payReference').value;
        const notes = document.getElementById('payNotes').value;
        const base_fare = document.getElementById('payBaseFare').value;
        const tax_amount = document.getElementById('payTaxAmount').value;
        const agency_fee = document.getElementById('payAgencyFee').value;
        if (!localAmount || Number(localAmount) <= 0) { alert('Please enter a valid amount'); return; }
        const amount = toUSD(localAmount);
        const btn = document.getElementById('submitPayBtn');
        btn.textContent = 'Saving...'; btn.disabled = true;
        try {
          const res = await fetch('/admin/payments/' + BOOKING_TYPE + '/' + BOOKING_ID + '/record', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ amount, payment_method, payment_reference, notes, base_fare: base_fare || null, tax_amount: tax_amount || null, agency_fee: agency_fee || null })
          });
          const data = await res.json();
          if (data.success) {
            alert(data.message);
            document.getElementById('payAmount').value = '';
            document.getElementById('payReference').value = '';
            document.getElementById('payNotes').value = '';
            document.getElementById('payBaseFare').value = '';
            document.getElementById('payTaxAmount').value = '';
            document.getElementById('payAgencyFee').value = '';
            document.getElementById('breakdownFields').style.display = 'none';
            togglePaymentForm();
            loadPayments();
          } else {
            alert('Error: ' + (data.error || 'Unknown error'));
          }
        } catch (err) {
          alert('Failed to record payment');
        } finally {
          btn.textContent = 'Save Payment'; btn.disabled = false;
        }
      }

      async function voidPayment(paymentId) {
        if (!confirm('Void this payment? This cannot be undone.')) return;
        try {
          const res = await fetch('/admin/payments/record/' + paymentId, { method: 'DELETE' });
          const data = await res.json();
          if (data.success) { alert(data.message); loadPayments(); }
          else { alert('Error: ' + (data.error || 'Unknown error')); }
        } catch (err) { alert('Failed to void payment'); }
      }

      loadPayments();

      if (PORTAL_TOKEN) {
        const ticketQR = document.getElementById('ticketQR');
        const ticketQRPlaceholder = document.getElementById('ticketQRPlaceholder');
        if (ticketQR) {
          ticketQR.src = '/t/' + PORTAL_TOKEN + '/qr';
          ticketQR.style.display = 'block';
          ticketQRPlaceholder.style.display = 'none';
        }
      }
    </script>
  ` }) %>
</body>
</html>
