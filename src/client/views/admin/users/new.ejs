<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Zahabia Travel & Tourism</title>
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<body>
  <%- include('../../layout', { body: `
    <div style="margin-bottom: 2rem;">
      <a href="/admin/users" class="btn btn-secondary btn-sm">← Back to Users</a>
      <h1 style="margin-top: 0.5rem;">Create New User</h1>
      <p class="muted">Add a new admin, agent, or guide account</p>
    </div>

    <div class="card" style="max-width: 600px;">
      ${typeof error !== 'undefined' && error ? '<div class="alert alert-danger">' + error + '</div>' : ''}

      <form method="post" action="/admin/users/new">
        <div class="form-group">
          <label for="name">Full Name</label>
          <input type="text" id="name" name="name" required placeholder="e.g. John Smith" class="form-control">
        </div>

        <div class="form-group">
          <label for="email">Email Address</label>
          <input type="email" id="email" name="email" required placeholder="user@zahabiatravel.com" class="form-control">
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required minlength="6" class="form-control">
        </div>

        <div class="form-group">
          <label for="role">Role</label>
          <select id="role" name="role">
            <option value="agent">Agent</option>
            <option value="guide">Guide</option>
            <option value="admin">Admin</option>
          </select>
        </div>

        <div style="margin-top: 1.5rem; display: flex; gap: 1rem;">
          <button type="submit" class="btn btn-primary">Create User</button>
          <a href="/admin/users" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  ` }) %>
</body>
</html>
