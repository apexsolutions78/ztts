<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Zahabia Travel & Tourism</title>
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<body>
  <%- include('../layout', { body: `
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
      <div>
        <p class="eyebrow">Zahabia Operations Overview</p>
        <h1>Executive Dashboard</h1>
        <p class="muted">Live booking stats, revenue figures, and recent trip reservations.</p>
      </div>
      <div style="display: flex; gap: 0.75rem;">
        <a href="/admin/flights/new" class="btn btn-primary">+ Book New Flight</a>
        <a href="/admin/tours/new" class="btn btn-accent">+ Create Tour Package</a>
      </div>
    </div>

    <!-- Metrics Cards Grid -->
    <div class="metrics-grid">
      <div class="metric-card gold">
        <div class="metric-title">Total Platform Revenue</div>
        <div class="metric-value">${formatPrice(stats.totalRevenue)}</div>
        <div class="metric-sub">Displaying in ${activeCurrency}</div>
      </div>
      <div class="metric-card">
        <div class="metric-title">Flight Bookings</div>
        <div class="metric-value">${stats.flightBookingsCount}</div>
        <div class="metric-sub">${stats.ticketedFlightsCount} E-Tickets Issued</div>
      </div>
      ${stats.pendingFlightRequests > 0 ? `
      <div class="metric-card" style="border-left: 4px solid #d69e2e;">
        <div class="metric-title">Pending Flight Requests</div>
        <div class="metric-value" style="color: #d69e2e;">${stats.pendingFlightRequests}</div>
        <div class="metric-sub"><a href="/admin/flights/requests?status=pending" style="color: #d69e2e; text-decoration: underline;">Review Now</a></div>
      </div>
      ` : ''}
      <div class="metric-card">
        <div class="metric-title">Active Tour Packages</div>
        <div class="metric-value">${stats.activeToursCount}</div>
        <div class="metric-sub">${stats.recentTourBookings.length} Active Reservations</div>
      </div>
      ${groupStats && groupStats.total > 0 ? `
      <div class="metric-card" style="border-left: 4px solid #38a169;">
        <div class="metric-title">Group Tours</div>
        <div class="metric-value" style="color: #38a169;">${groupStats.total}</div>
        <div class="metric-sub">${groupStats.active} Active · ${groupStats.draft} Draft</div>
      </div>
      ` : ''}
      <div class="metric-card">
        <div class="metric-title">Registered Customers</div>
        <div class="metric-value">${stats.customersCount}</div>
        <div class="metric-sub">VIP Profiles</div>
      </div>
    </div>

    <!-- Main Content Split Grid -->
    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem;">
      
      <!-- Recent Flight Bookings Table -->
      <div class="card">
        <div class="card-header">
          <h2>Recent Flight Bookings</h2>
          <a href="/admin/flights" class="btn btn-secondary btn-sm">View All Flights</a>
        </div>
        
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>PNR / Ref</th>
                <th>Passenger</th>
                <th>Airline / Flight</th>
                <th>Route</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              ${stats.recentFlights.map(f => `
                <tr>
                  <td><strong>${f.booking_ref}</strong></td>
                  <td>${f.customer_name}</td>
                  <td>${f.airline} <br><span class="muted">${f.flight_number}</span></td>
                  <td><strong>${f.origin}</strong> → <strong>${f.destination}</strong></td>
                  <td><strong>${formatPrice(f.total_amount)}</strong></td>
                  <td><span class="badge badge-${f.ticket_status}">${f.ticket_status}</span></td>
                  <td><a href="/admin/flights/${f.id}" class="btn btn-secondary btn-sm">Details</a></td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>
      </div>


      <!-- Quick Actions Sidebar -->
      <div>
        <div class="card" style="margin-bottom: 1.5rem;">
          <h3>Quick Operator Actions</h3>
          <p class="muted" style="margin-bottom: 1rem; font-size: 0.85rem;">Fast-track frequent tasks:</p>
          <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            ${stats.pendingFlightRequests > 0 ? `<a href="/admin/flights/requests?status=pending" class="btn btn-sm" style="justify-content: flex-start; background: #fefcbf; color: #975a16; border: 1px solid #d69e2e;">⚠ ${stats.pendingFlightRequests} Pending Flight Request${stats.pendingFlightRequests > 1 ? 's' : ''}</a>` : ''}
            <a href="/admin/flights/requests" class="btn btn-secondary" style="justify-content: flex-start;">📋 View Flight Requests</a>
            <a href="/admin/flights/new" class="btn btn-secondary" style="justify-content: flex-start;">✈ Issue Airline Ticket</a>
            <a href="/admin/customers" class="btn btn-secondary" style="justify-content: flex-start;">👤 Register New Customer</a>
            <a href="/admin/tours" class="btn btn-secondary" style="justify-content: flex-start;">🌴 Book Tour Reservation</a>
            <a href="/api/stats" target="_blank" class="btn btn-secondary" style="justify-content: flex-start;">📊 Export JSON API Stats</a>
          </div>
        </div>

        <div class="card" style="background: linear-gradient(135deg, var(--bg-dark) 0%, var(--primary-dark) 100%); color: #fff;">
          <h3 style="color: var(--accent-gold);">Customer Itinerary Portal</h3>
          <p style="font-size: 0.85rem; margin: 0.5rem 0 1rem; color: #a0aec0;">Generate shareable self-service portal links for passengers to view and print their E-Tickets.</p>
          <a href="/t/demo-token-hamdan-ek201" target="_blank" class="btn btn-accent btn-sm">Preview Demo E-Ticket →</a>
        </div>
      </div>

    </div>

    <!-- Revenue Breakdown + Tour Bookings -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 1.5rem;">
      
      <!-- Revenue Breakdown Bar Chart -->
      <div class="card">
        <h3>Revenue Breakdown</h3>
        <p class="muted" style="margin: 0.3rem 0 1.5rem; font-size: 0.85rem;">Flight vs Tour revenue comparison</p>
        <div style="margin-bottom: 1.25rem;">
          <div style="display: flex; justify-content: space-between; margin-bottom: 0.4rem;">
            <span style="font-size: 0.85rem; font-weight: 700;">Flight Revenue</span>
            <span style="font-size: 0.85rem; font-weight: 700; color: var(--primary);">${flightPct}%</span>
          </div>
          <div style="background: #edf4f2; border-radius: 6px; height: 28px; overflow: hidden;">
            <div style="background: var(--primary); height: 100%; width: ${flightPct}%; border-radius: 6px; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 0.75rem; font-weight: 700; min-width: ${flightPct > 10 ? '0' : '40px'};">
              ${formatPrice(stats.totalFlightRevenue)}
            </div>
          </div>
        </div>
        <div>
          <div style="display: flex; justify-content: space-between; margin-bottom: 0.4rem;">
            <span style="font-size: 0.85rem; font-weight: 700;">Tour Revenue</span>
            <span style="font-size: 0.85rem; font-weight: 700; color: var(--accent-gold);">${tourPct}%</span>
          </div>
          <div style="background: #edf4f2; border-radius: 6px; height: 28px; overflow: hidden;">
            <div style="background: var(--accent-gold); height: 100%; width: ${tourPct}%; border-radius: 6px; display: flex; align-items: center; justify-content: center; color: var(--bg-dark); font-size: 0.75rem; font-weight: 700; min-width: ${tourPct > 10 ? '0' : '40px'};">
              ${formatPrice(stats.totalTourRevenue)}
            </div>
          </div>
        </div>
        <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--border-light); display: flex; justify-content: space-between;">
          <span style="font-weight: 700;">Total Revenue</span>
          <span style="font-family: var(--font-heading); font-weight: 800; font-size: 1.2rem; color: var(--primary);">${formatPrice(stats.totalRevenue)}</span>
        </div>
      </div>

      <!-- Recent Tour Bookings -->
      <div class="card">
        <div class="card-header">
          <h2>Recent Tour Bookings</h2>
          <a href="/admin/tours" class="btn btn-secondary btn-sm">View All Tours</a>
        </div>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Package</th>
                <th>Customer</th>
                <th>Date</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              ${stats.recentTourBookings.length > 0 ? stats.recentTourBookings.map(tb => `
                <tr>
                  <td><strong>${tb.tour_title || 'Tour'}</strong></td>
                  <td>${tb.customer_name}</td>
                  <td>${tb.travel_date}</td>
                  <td><strong>${formatPrice(tb.total_amount)}</strong></td>
                  <td><span class="badge badge-${tb.status}">${tb.status}</span></td>
                  <td><a href="/admin/tours/bookings/${tb.id}" class="btn btn-secondary btn-sm">Details</a></td>
                </tr>
              `).join('') : '<tr><td colspan="6" class="muted" style="text-align: center;">No tour bookings yet.</td></tr>'}
            </tbody>
          </table>
        </div>
      </div>

    </div>

    <!-- Group Tours Section -->
    ${recentGroups && recentGroups.length > 0 ? `
    <div class="card" style="margin-top: 1.5rem;">
      <div class="card-header">
        <h2>Recent Group Tours</h2>
        <a href="/admin/tours/groups" class="btn btn-secondary btn-sm">View All Groups</a>
      </div>
      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Group Name</th>
              <th>Tour Package</th>
              <th>Travel Date</th>
              <th>Members</th>
              <th>Guide</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            ${recentGroups.map(g => `
              <tr>
                <td><strong>${g.title}</strong></td>
                <td>${g.tour_title || 'N/A'}</td>
                <td>${g.start_at ? new Date(g.start_at).toLocaleDateString() : 'TBD'}</td>
                <td>${g.group_size_expected || '?'} expected</td>
                <td>${g.assigned_guide_user_id ? 'Guide #' + g.assigned_guide_user_id : '<span class="muted">Unassigned</span>'}</td>
                <td><span class="badge badge-${g.status}">${g.status}</span></td>
                <td><a href="/admin/tours/group/${g.id}" class="btn btn-primary btn-sm">Manage</a></td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>
    </div>
    ` : ''}
  ` }) %>
</body>
</html>
