<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Zahabia Travel & Tourism</title>
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<body>
  <%
    const isRequest = flight.ticket_status === 'pending';
    const isConfirmed = flight.ticket_status === 'confirmed';
    const isTicketed = flight.ticket_status === 'ticketed';
    const isCancelled = flight.ticket_status === 'cancelled';
    const pageTitle = isRequest ? 'Flight Request' : isTicketed ? 'Flight Reservation' : 'Flight Booking';
    const pageSubtitle = isRequest ? 'Customer Request — Awaiting Flight Selection & Payment' : isConfirmed ? 'Confirmed — Awaiting Ticket Issuance' : isTicketed ? 'Confirmed E-Ticket & PNR Details' : isCancelled ? 'Cancelled Request' : 'Flight Booking Details';
    const currentStage = flight.workflow_stage || 'legacy';
    const allowedStagesMap = {
      inquiry:                    ['search_details_complete', 'cancelled'],
      search_details_complete:    ['quote_prepared', 'cancelled'],
      quote_prepared:             ['quote_sent', 'cancelled'],
      quote_sent:                 ['customer_approved', 'cancelled'],
      customer_approved:          ['passenger_details_pending', 'cancelled'],
      passenger_details_pending:  ['passenger_details_complete', 'cancelled'],
      passenger_details_complete: ['reservation_pending', 'cancelled'],
      reservation_pending:        ['reserved', 'cancelled', 'customer_approved'],
      reserved:                   ['payment_pending', 'cancelled', 'customer_approved'],
      payment_pending:            ['payment_under_review', 'cancelled'],
      payment_under_review:       ['ready_for_ticketing', 'cancelled'],
      ready_for_ticketing:        ['ticketed', 'cancelled'],
      legacy:                     ['inquiry', 'cancelled']
    };
    const stageLabels = {
      inquiry: 'Inquiry Received', search_details_complete: 'Search Details Complete',
      quote_prepared: 'Quote Prepared', quote_sent: 'Quote Sent',
      customer_approved: 'Customer Approved', passenger_details_pending: 'Passenger Details Pending',
      passenger_details_complete: 'Passenger Details Complete', reservation_pending: 'Reservation Pending',
      reserved: 'Reserved', payment_pending: 'Payment Pending',
      payment_under_review: 'Payment Under Review', ready_for_ticketing: 'Ready for Ticketing',
      ticketed: 'Ticketed', completed: 'Completed', cancelled: 'Cancelled', legacy: 'Legacy'
    };
    const nextStages = (allowedStagesMap[currentStage] || []).filter(s => s !== 'cancelled');
    const canCancel = (allowedStagesMap[currentStage] || []).includes('cancelled');
    const hasPNR = !!flight.pnr;
    const hasDeadline = !!flight.ticketing_deadline;
    const deadlineUrgent = hasDeadline && (new Date(flight.ticketing_deadline) - new Date()) < 24 * 60 * 60 * 1000;
    const showPNRForm = !hasPNR && !isTicketed && !isCancelled && ['reserved', 'payment_pending', 'payment_under_review', 'ready_for_ticketing'].includes(currentStage);
  %>
  <%- include('../../layout', { body: `
    <div style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
      <div>
        <a href="/admin/flights" class="btn btn-secondary btn-sm">← Back to Flights</a>
        <h1 style="margin-top: 0.5rem;">${pageTitle}: ${isRequest ? 'REQ-' + flight.id : flight.booking_ref}</h1>
        <p class="muted">${pageSubtitle}</p>
      </div>

      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; justify-content: flex-end;">
        ${isTicketed ? `
          <button id="shareBtn" onclick="generateShareLink(${flight.id})" class="btn btn-accent">🔗 Share Portal Link</button>
          <button onclick="sendNotification(${flight.id}, 'email')" id="sendEmailBtn" class="btn btn-primary" style="background: #2563eb;">✉ Send E-Ticket</button>
          <button onclick="sendNotification(${flight.id}, 'whatsapp')" id="sendWhatsAppBtn" class="btn btn-primary" style="background: #25d366;">💬 Send WhatsApp</button>
          <a href="/admin/flights/${flight.id}/pdf" target="_blank" class="btn btn-primary" style="background: #805ad5;">📄 Download PDF</a>
        ` : isConfirmed ? `
          <form method="post" action="/admin/flights/${flight.id}/issue" style="display: flex; gap: 0.5rem; align-items: center; margin: 0;" onsubmit="return confirm('Issue this e-ticket?')">
            <input type="text" name="ticket_number" required placeholder="E-Ticket # from Amadeus" class="form-control" style="max-width: 200px; font-family: monospace; text-transform: uppercase;">
            <button type="submit" class="btn btn-primary">✔ Issue E-Ticket</button>
          </form>
          <button onclick="sendNotification(${flight.id}, 'email')" id="sendEmailBtn" class="btn btn-primary" style="background: #2563eb;">✉ Send Email</button>
        ` : isRequest ? `
          <button onclick="sendNotification(${flight.id}, 'email')" id="sendEmailBtn" class="btn btn-primary" style="background: #2563eb;">✉ Send Options to Customer</button>
          <form method="post" action="/admin/flights/${flight.id}/cancel" style="margin: 0;" onsubmit="return confirm('Cancel this flight request?')">
            <button type="submit" class="btn btn-sm" style="background: #e53e3e; color: #fff;">✕ Cancel Request</button>
          </form>
        ` : ''}
        <a href="/admin/flights/${flight.id}/edit" class="btn btn-secondary">✏ Edit</a>
        <form method="post" action="/admin/flights/${flight.id}/delete" style="margin: 0;" onsubmit="return confirm('Delete this flight record?')">
          <button type="submit" class="btn btn-sm" style="background: #e53e3e; color: #fff;">🗑 Delete</button>
        </form>
      </div>
    </div>

    <!-- Share Link Toast / Alert -->
    <div id="shareBox" style="display: none;" class="alert alert-success">
      <strong>Customer Portal Access Link Generated:</strong>
      <div style="margin-top: 0.5rem; display: flex; gap: 1rem; align-items: flex-start; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 250px;">
          <div style="display: flex; gap: 0.5rem;">
            <input type="text" id="shareUrlInput" readonly class="form-control" style="background: #fff;">
            <button onclick="copyShareUrl()" class="btn btn-secondary btn-sm">Copy Link</button>
            <a id="openPortalLink" href="#" target="_blank" class="btn btn-primary btn-sm">Open Portal →</a>
          </div>
        </div>
        <div style="text-align: center;">
          <img id="shareQR" src="" alt="Portal QR Code" style="width: 130px; height: 130px; border: 2px solid var(--primary); border-radius: 8px; padding: 4px; background: #fff; display: none;">
          <div style="font-size: 0.7rem; color: var(--text-muted); margin-top: 0.3rem;">Scan to open portal</div>
        </div>
      </div>
    </div>

    ${!isCancelled && !isTicketed && nextStages.length > 0 ? `
    <!-- ========== WORKFLOW STAGE PROGRESSION ========== -->
    <div class="card" style="padding: 1.25rem; margin-bottom: 1.5rem; background: linear-gradient(135deg, #f8fafb 0%, #edf4f2 100%);">
      <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
        <div>
          <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600; margin-bottom: 0.2rem;">Workflow Stage</div>
          <div style="font-size: 1.1rem; font-weight: 800; color: var(--primary);">${stageLabels[currentStage] || currentStage}</div>
        </div>
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
          ${nextStages.map(stage => `
            <form method="post" action="/admin/flights/${flight.id}/transition" style="margin: 0;">
              <input type="hidden" name="target_stage" value="${stage}">
              <button type="submit" class="btn btn-primary btn-sm" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">${stageLabels[stage] || stage} →</button>
            </form>
          `).join('')}
          ${canCancel ? `
            <form method="post" action="/admin/flights/${flight.id}/transition" style="margin: 0;">
              <input type="hidden" name="target_stage" value="cancelled">
              <button type="submit" class="btn btn-sm" style="background: #e53e3e; color: #fff; font-size: 0.8rem; padding: 0.4rem 0.8rem;" onclick="return confirm('Cancel this booking workflow?')">Cancel</button>
            </form>
          ` : ''}
        </div>
      </div>
    </div>
    ` : ''}

    ${hasPNR && !isTicketed && !isCancelled ? `
    <!-- ========== PNR RECORDED — TIME LIMIT DISPLAY ========== -->
    <div class="card" style="padding: 1.25rem; margin-bottom: 1.5rem; ${deadlineUrgent ? 'border: 2px solid #e53e3e; background: #fff5f5;' : 'background: #f0f4f8;'}">
      <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
        <div>
          <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Recorded PNR</div>
          <div style="font-size: 1.5rem; font-weight: 800; font-family: monospace; color: var(--primary);">${flight.pnr}</div>
        </div>
        ${hasDeadline ? `
        <div style="text-align: right;">
          <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Ticketing Deadline</div>
          <div style="font-size: 1rem; font-weight: 700; color: ${deadlineUrgent ? '#e53e3e' : 'var(--text-dark)'};">
            ${new Date(flight.ticketing_deadline).toLocaleString('en-US', { weekday: 'short', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })}
          </div>
          ${deadlineUrgent ? '<div style="font-size: 0.75rem; color: #e53e3e; font-weight: 600;">⚠ URGENT — Less than 24 hours remaining</div>' : ''}
        </div>
        ` : '<div><span style="color: var(--text-muted); font-size: 0.85rem;">No deadline set</span></div>'}
      </div>
    </div>
    ` : ''}

    ${showPNRForm ? `
    <!-- ========== RECORD PNR FORM ========== -->
    <div class="card" style="padding: 1.5rem; margin-bottom: 1.5rem; background: linear-gradient(135deg, #f8fafb 0%, #edf4f2 100%); border: 2px dashed var(--primary);">
      <h4 style="margin-bottom: 1rem; color: var(--primary);">Record PNR from Amadeus/GDS</h4>
      <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem;">Enter the PNR code and time limit received from the airline reservation system.</p>
      <form method="post" action="/admin/flights/${flight.id}/record-pnr">
        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 600;">PNR Code *</label>
            <input type="text" name="pnr" required placeholder="e.g. ABC123" class="form-control" style="text-transform: uppercase; font-family: monospace; font-size: 1.1rem; font-weight: 700;">
          </div>
          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 600;">Reservation Date</label>
            <input type="datetime-local" name="reservation_date" class="form-control">
          </div>
          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 600;">Ticketing Deadline</label>
            <input type="datetime-local" name="ticketing_deadline" class="form-control">
          </div>
        </div>
        <div style="margin-top: 1rem;">
          <button type="submit" class="btn btn-primary">Save PNR</button>
        </div>
      </form>
    </div>
    ` : ''}

    ${isRequest || isConfirmed ? `
    <!-- ========== REQUEST / CONFIRMED VIEW ========== -->
    <div class="card" style="padding: 2rem; margin-bottom: 1.5rem;">
      <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border-light);">
        <div style="width: 50px; height: 50px; border-radius: 12px; background: ${isConfirmed ? '#edf7ed' : '#fefcbf'}; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">
          ${isConfirmed ? '✅' : '📋'}
        </div>
        <div>
          <h2 style="margin: 0; font-size: 1.3rem;">${isConfirmed ? 'Flight Confirmed — Awaiting Ticket' : 'Customer Flight Request'}</h2>
          <p class="muted" style="margin: 0.2rem 0 0; font-size: 0.85rem;">Request #${flight.id} — Submitted ${new Date(flight.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</p>
        </div>
        <div style="margin-left: auto; display: flex; gap: 0.5rem; align-items: center;">
          ${flight.workflow_stage && flight.workflow_stage !== 'legacy' ? `<span style="font-size: 0.7rem; padding: 0.25rem 0.6rem; background: #e2e8f0; color: #4a5568; border-radius: 4px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.3px;">${flight.workflow_stage.replace(/_/g, ' ')}</span>` : ''}
          <span class="badge badge-${flight.ticket_status}" style="font-size: 0.85rem; padding: 0.4rem 1rem;">${flight.ticket_status.toUpperCase()}</span>
        </div>
      </div>

      ${isConfirmed ? `
      <div style="background: #edf7ed; border: 1px solid #c6f6d5; border-radius: var(--radius-sm); padding: 1rem; margin-bottom: 1.5rem;">
        <strong style="color: #22543d;">✅ Payment Confirmed — Ready for Ticket Issuance</strong>
        <p style="margin: 0.3rem 0 0; font-size: 0.85rem; color: #276749;">Click "Issue E-Ticket" above to generate the official PNR and e-ticket for this customer.</p>
      </div>
      ` : `
      <div style="background: #fefcbf; border: 1px solid #d69e2e; border-radius: var(--radius-sm); padding: 1rem; margin-bottom: 1.5rem;">
        <strong style="color: #975a16;">⏳ Awaiting Customer Selection & Payment</strong>
        <p style="margin: 0.3rem 0 0; font-size: 0.85rem; color: #975a16;">Share available flight options with the customer. Once they select and payment is received, confirm the booking and issue the e-ticket.</p>
      </div>
      `}

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
        <div>
          <h4 style="font-size: 0.78rem; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.5rem; letter-spacing: 0.5px;">Route</h4>
          <div style="font-size: 1.5rem; font-weight: 800; color: var(--primary);">${flight.origin} → ${flight.destination}</div>
        </div>
        <div>
          <h4 style="font-size: 0.78rem; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.5rem; letter-spacing: 0.5px;">Travel Date</h4>
          <div style="font-size: 1.1rem; font-weight: 600;">${new Date(flight.departure_date).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' })}</div>
        </div>
        <div>
          <h4 style="font-size: 0.78rem; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.5rem; letter-spacing: 0.5px;">Cabin Class</h4>
          <div style="font-size: 1rem; font-weight: 600;">${flight.cabin_class || 'Economy'}</div>
        </div>
        <div>
          <h4 style="font-size: 0.78rem; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.5rem; letter-spacing: 0.5px;">Passengers</h4>
          <div style="font-size: 1rem; font-weight: 600;">${flight.passengers || 1}</div>
        </div>
      </div>

      <div style="margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border-light);">
        <h4 style="font-size: 0.78rem; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.75rem; letter-spacing: 0.5px;">Customer Details</h4>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
          <div>
            <div style="font-size: 0.75rem; color: var(--text-muted);">Name</div>
            <div style="font-weight: 600;">${flight.customer_name || 'N/A'}</div>
          </div>
          <div>
            <div style="font-size: 0.75rem; color: var(--text-muted);">Email</div>
            <div style="font-weight: 600;">${flight.customer_email || 'N/A'}</div>
          </div>
          <div>
            <div style="font-size: 0.75rem; color: var(--text-muted);">Phone</div>
            <div style="font-weight: 600;">${flight.customer_phone || 'N/A'}</div>
          </div>
          <div>
            <div style="font-size: 0.75rem; color: var(--text-muted);">Nationality</div>
            <div style="font-weight: 600;">${flight.nationality || 'N/A'}</div>
          </div>
          <div>
            <div style="font-size: 0.75rem; color: var(--text-muted);">Passport</div>
            <div style="font-weight: 600;">${flight.passport_number || 'N/A'}</div>
          </div>
        </div>
      </div>

      ${flight.notes ? `
      <div style="margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border-light);">
        <h4 style="font-size: 0.78rem; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.5rem; letter-spacing: 0.5px;">Customer Notes / Preferred Airline</h4>
        <div style="background: #f8fafb; padding: 0.75rem 1rem; border-radius: var(--radius-sm); font-size: 0.9rem;">${flight.notes}</div>
      </div>
      ` : ''}

      <div style="margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border-light);">
        <h4 style="font-size: 0.78rem; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.5rem; letter-spacing: 0.5px;">Total Fare</h4>
        <div style="font-size: 1.8rem; font-weight: 800; color: var(--primary);">${flight.total_amount > 0 ? formatPrice(flight.total_amount) : '<span style="color: var(--text-muted); font-size: 1rem;">To be determined</span>'}</div>
      </div>
    </div>
    ` : isCancelled ? `
    <!-- ========== CANCELLED VIEW ========== -->
    <div class="card" style="padding: 2rem; margin-bottom: 1.5rem;">
      <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border-light);">
        <div style="width: 50px; height: 50px; border-radius: 12px; background: #fed7d7; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">&#10060;</div>
        <div>
          <h2 style="margin: 0; font-size: 1.3rem;">Flight Booking Cancelled</h2>
          <p class="muted" style="margin: 0.2rem 0 0; font-size: 0.85rem;">Request #${flight.id} — Cancelled</p>
        </div>
        <div style="margin-left: auto;"><span class="badge badge-cancelled" style="font-size: 0.85rem; padding: 0.4rem 1rem;">CANCELLED</span></div>
      </div>
      <div style="background: #fed7d7; border: 1px solid #fc8181; border-radius: var(--radius-sm); padding: 1rem; margin-bottom: 1.5rem;">
        <strong style="color: #9b2c2c;">This flight booking has been cancelled.</strong>
        <p style="margin: 0.3rem 0 0; font-size: 0.85rem; color: #9b2c2c;">The booking is no longer active. Edit or delete this record as needed.</p>
      </div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
        <div>
          <h4 style="font-size: 0.78rem; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.5rem; letter-spacing: 0.5px;">Route</h4>
          <div style="font-size: 1.5rem; font-weight: 800; color: var(--primary);">${flight.origin} &rarr; ${flight.destination}</div>
        </div>
        <div>
          <h4 style="font-size: 0.78rem; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.5rem; letter-spacing: 0.5px;">Customer</h4>
          <div style="font-size: 1rem; font-weight: 600;">${flight.customer_name || 'N/A'}</div>
        </div>
      </div>
    </div>
    ` : `
    <!-- ========== TICKETED / RESERVATION VIEW ========== -->
    <div class="ticket-wrapper">
      <div class="ticket-header">
        <div class="ticket-airline-brand">
          <img src="/brand/LOGO123.png" alt="Zahabia Logo" style="height: 50px;" onerror="this.src='/brand/Golden_airplane_circling_globe_20260914222838.gif';">
          <div>
            <h2>ZAHABIA AIR TICKETING</h2>
            <span style="font-size: 0.8rem; color: var(--accent-gold); text-transform: uppercase;">Official E-Ticket Receipt</span>
          </div>
        </div>

        <div style="text-align: right;">
          <span style="font-size: 0.8rem; text-transform: uppercase; color: #a0aec0;">PNR Reference</span>
          <div style="font-family: var(--font-heading); font-size: 2rem; font-weight: 800; color: var(--accent-gold);">${flight.booking_ref}</div>
          ${flight.ticket_number ? '<div style="font-size: 0.85rem; color: var(--accent-gold); font-family: monospace; margin-top: 0.3rem;">E-Ticket: ' + flight.ticket_number + '</div>' : ''}
        </div>
      </div>

      <div class="ticket-body">
        <div style="background: #edf4f2; padding: 0.85rem 1.25rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
          <div>
            <span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted);">LIVE FLIGHT TRACKER ENGINE</span>
            <div style="font-weight: 800; font-size: 1.1rem; color: var(--primary);">STATUS: <span class="badge badge-${liveStatus.statusClass}">${liveStatus.status}</span></div>
          </div>
          <div style="display: flex; gap: 1.5rem; font-size: 0.88rem;">
            <div><strong>Terminal:</strong> ${liveStatus.terminal}</div>
            <div><strong>Gate:</strong> ${liveStatus.gate}</div>
            <div><strong>Baggage Claim:</strong> ${liveStatus.baggage || 'TBA'}</div>
          </div>
        </div>

        <div class="flight-route">
          <div>
            <div class="airport-code">${flight.origin}</div>
            <div class="airport-name">Origin Departure</div>
          </div>
          <div class="route-divider">
            <div style="font-weight: 700; font-size: 0.9rem; color: var(--primary);">${flight.airline} (${flight.flight_number})</div>
            <div class="route-line"></div>
            <div style="font-size: 0.8rem; color: var(--text-muted);">${flight.cabin_class} Class</div>
          </div>
          <div style="text-align: right;">
            <div class="airport-code">${flight.destination}</div>
            <div class="airport-name">Destination Arrival</div>
          </div>
        </div>

        <div class="ticket-grid">
          <div class="ticket-field">
            <label>Passenger Name</label>
            <val>${flight.customer_name}</val>
          </div>
          <div class="ticket-field">
            <label>Passport Number</label>
            <val>${flight.passport_number || 'N/A'}</val>
          </div>
          <div class="ticket-field">
            <label>E-Ticket Number</label>
            <val style="font-family: monospace; font-weight: 700; color: var(--primary);">${flight.ticket_number || 'N/A'}</val>
          </div>
          <div class="ticket-field">
            <label>PNR Code</label>
            <val style="font-family: monospace;">${flight.pnr || flight.booking_ref}</val>
          </div>
          <div class="ticket-field">
            <label>Nationality</label>
            <val>${flight.nationality || 'N/A'}</val>
          </div>
          <div class="ticket-field">
            <label>Email</label>
            <val>${flight.customer_email || 'N/A'}</val>
          </div>
          <div class="ticket-field">
            <label>Phone</label>
            <val>${flight.customer_phone || 'N/A'}</val>
          </div>
          <div class="ticket-field">
            <label>Departure Time</label>
            <val>${new Date(flight.departure_date).toLocaleString()}</val>
          </div>
          <div class="ticket-field">
            <label>Arrival Time</label>
            <val>${flight.arrival_date ? new Date(flight.arrival_date).toLocaleString() : 'TBA'}</val>
          </div>
          <div class="ticket-field">
            <label>Total Fare</label>
            <val>${formatPrice(flight.total_amount)}</val>
          </div>
          <div class="ticket-field">
            <label>Ticket Status</label>
            <val><span class="badge badge-${flight.ticket_status}">${flight.ticket_status}</span></val>
          </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1.5rem; padding: 1rem; background: #f0f4f8; border-radius: var(--radius-sm); border: 1px dashed #cbd5e0;">
          <div>
            <div style="font-size: 0.72rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted);">Customer Portal QR Code</div>
            <div style="font-family: monospace; font-size: 0.9rem; font-weight: 700; color: var(--primary);">${flight.booking_ref}</div>
            <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.2rem;">Scan to open e-ticket portal</div>
          </div>
          <img id="ticketQR" src="" alt="Portal QR Code" style="width: 110px; height: 110px; border: 2px solid var(--primary); border-radius: 8px; padding: 4px; background: #fff; display: none;">
          <div id="ticketQRPlaceholder" style="width: 110px; height: 110px; border: 2px dashed #cbd5e0; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; color: #a0aec0; text-align: center; padding: 0.5rem;">Click "Share Portal Link" to generate</div>
        </div>
      </div>
    </div>
    `}

    <!-- Notification History -->
    <div class="card" style="margin-top: 2rem;">
      <h3 style="margin-bottom: 1rem;">Notification History</h3>
      <div id="notificationList" style="color: var(--text-muted); font-size: 0.9rem;">Loading...</div>
    </div>

    <!-- Payment Management -->
    <div class="card" style="margin-top: 2rem;" id="paymentSection">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h3>Payment Management</h3>
        <button onclick="togglePaymentForm()" class="btn btn-primary btn-sm" id="addPaymentBtn">+ Record Payment</button>
      </div>

      <div id="paymentSummary" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
        <div style="background: #edf4f2; padding: 1rem; border-radius: var(--radius-sm); text-align: center;">
          <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Total Amount</div>
          <div style="font-size: 1.4rem; font-weight: 800; color: var(--primary);" id="payTotalAmount">--</div>
        </div>
        <div style="background: #edf7ed; padding: 1rem; border-radius: var(--radius-sm); text-align: center;">
          <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Paid</div>
          <div style="font-size: 1.4rem; font-weight: 800; color: #38a169;" id="payTotalPaid">--</div>
        </div>
        <div style="background: #fef3cd; padding: 1rem; border-radius: var(--radius-sm); text-align: center;">
          <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Balance Due</div>
          <div style="font-size: 1.4rem; font-weight: 800; color: #d69e2e;" id="payBalance">--</div>
        </div>
        <div style="background: #f0f4f8; padding: 1rem; border-radius: var(--radius-sm); text-align: center;">
          <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Status</div>
          <div style="font-size: 1.4rem; font-weight: 800;" id="payStatus">--</div>
        </div>
      </div>

      <div id="paymentForm" style="display: none; background: #f8fafb; padding: 1.5rem; border-radius: var(--radius-md); margin-bottom: 1.5rem; border: 1px solid var(--border-light);">
        <h4 style="margin-bottom: 1rem;">Record Payment(s)</h4>
        <div id="paymentRows">
          <div class="payment-row" style="display: grid; grid-template-columns: 2fr 2fr 2fr 1fr; gap: 0.75rem; margin-bottom: 0.75rem; align-items: end;">
            <div>
              <label style="font-size: 0.75rem; font-weight: 600; display: block; margin-bottom: 0.2rem;">Amount (${activeCurrency})</label>
              <input type="number" step="0.01" min="0.01" class="form-control pay-amount" placeholder="0.00" style="width: 100%;">
            </div>
            <div>
              <label style="font-size: 0.75rem; font-weight: 600; display: block; margin-bottom: 0.2rem;">Method</label>
              <select class="form-control pay-method" style="width: 100%;">
                <option value="cash">Cash</option>
                <option value="bank_transfer">Bank Transfer</option>
                <option value="cheque">Cheque</option>
                <option value="credit_card">Credit Card</option>
                <option value="debit_card">Debit Card</option>
                <option value="online">Online</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div>
              <label style="font-size: 0.75rem; font-weight: 600; display: block; margin-bottom: 0.2rem;">Reference</label>
              <input type="text" class="form-control pay-reference" placeholder="Ref / Cheque #" style="width: 100%;">
            </div>
            <div>
              <label style="font-size: 0.75rem; font-weight: 600; display: block; margin-bottom: 0.2rem;">&nbsp;</label>
              <button onclick="removePaymentRow(this)" class="btn btn-sm" style="background: #e53e3e; color: #fff; width: 100%;" disabled title="Remove row">✕</button>
            </div>
          </div>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.75rem;">
          <button onclick="addPaymentRow()" class="btn btn-secondary btn-sm">+ Add Another Payment</button>
          <div style="text-align: right;">
            <div style="font-size: 0.8rem; color: var(--text-muted);">Allocated: <strong id="allocatedAmount" style="color: var(--primary);">$0.00</strong> / Balance: <strong id="balanceDisplay">--</strong></div>
          </div>
        </div>
        <div style="margin-top: 1rem; display: flex; gap: 0.75rem;">
          <button onclick="submitBatchPayments()" class="btn btn-primary" id="submitPayBtn">Save Payment(s)</button>
          <button onclick="togglePaymentForm()" class="btn btn-secondary">Cancel</button>
        </div>
      </div>

      <h4 style="margin-bottom: 0.75rem;">Payment History</h4>
      <div class="table-responsive">
        <table class="data-table" id="paymentTable">
          <thead>
            <tr>
              <th>Date</th>
              <th>Invoice</th>
              <th>Method</th>
              <th>Reference</th>
              <th>Amount</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="paymentTableBody">
            <tr><td colspan="7" class="muted" style="text-align: center;">Loading payments...</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <script>
      const BOOKING_TYPE = 'flight';
      const BOOKING_ID = ${flight.id};
      const BOOKING_TOTAL = ${flight.total_amount};
      const EXCHANGE_RATES = ${JSON.stringify(exchangeRates)};
      const ACTIVE_CURRENCY = '${activeCurrency}';
      const CURRENCY_RATE = EXCHANGE_RATES[ACTIVE_CURRENCY]?.rate || 1;
      const PORTAL_TOKEN = ${portalToken ? "'" + portalToken + "'" : 'null'};

      function formatPrice(amount) {
        return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(amount || 0);
      }

      function toUSD(localAmount) {
        return (Number(localAmount) / CURRENCY_RATE).toFixed(6);
      }

      function fmtLocal(amountInUSD) {
        const curr = EXCHANGE_RATES[ACTIVE_CURRENCY] || { symbol: '$', rate: 1 };
        const converted = Number(amountInUSD || 0) * curr.rate;
        const decimals = (ACTIVE_CURRENCY === 'PKR' || ACTIVE_CURRENCY === 'JPY') ? 0 : 2;
        const rounded = decimals === 0 ? Math.round(converted) : converted;
        return curr.symbol + rounded.toLocaleString('en-US', { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
      }

      async function generateShareLink(id) {
        try {
          const res = await fetch('/admin/flights/' + id + '/share', { method: 'POST' });
          const data = await res.json();
          if (data.success) {
            document.getElementById('shareBox').style.display = 'block';
            document.getElementById('shareUrlInput').value = data.shareUrl;
            document.getElementById('openPortalLink').href = data.shareUrl;
            const qrImg = document.getElementById('shareQR');
            qrImg.src = '/t/' + data.token + '/qr';
            qrImg.style.display = 'block';
            const ticketQR = document.getElementById('ticketQR');
            const ticketQRPlaceholder = document.getElementById('ticketQRPlaceholder');
            if (ticketQR) {
              ticketQR.src = '/t/' + data.token + '/qr';
              ticketQR.style.display = 'block';
              ticketQRPlaceholder.style.display = 'none';
            }
          }
        } catch (err) {
          alert('Failed to generate portal link');
        }
      }

      function copyShareUrl() {
        const input = document.getElementById('shareUrlInput');
        input.select();
        document.execCommand('copy');
        alert('Copied link to clipboard!');
      }

      async function sendNotification(flightId, channel) {
        const btn = channel === 'email' ? document.getElementById('sendEmailBtn') : document.getElementById('sendWhatsAppBtn');
        const originalText = btn.textContent;
        btn.textContent = 'Sending...';
        btn.disabled = true;
        try {
          const res = await fetch('/admin/flights/' + flightId + '/notify/' + channel, { method: 'POST' });
          const data = await res.json();
          if (data.success) {
            alert(data.message + (data.simulated ? ' (Simulated – SMTP/WhatsApp API not configured)' : ''));
            loadNotifications(flightId);
          } else {
            alert('Failed: ' + (data.message || data.error || 'Unknown error'));
          }
        } catch (err) {
          alert('Failed to send notification');
        } finally {
          btn.textContent = originalText;
          btn.disabled = false;
        }
      }

      async function loadNotifications(flightId) {
        try {
          const res = await fetch('/admin/flights/' + flightId + '/notifications');
          const data = await res.json();
          const container = document.getElementById('notificationList');
          if (!data.success || !data.data.length) {
            container.innerHTML = '<p>No notifications sent yet for this booking.</p>';
            return;
          }
          container.innerHTML = data.data.map(n => {
            const icon = n.channel === 'email' ? '✉' : '💬';
            const channelLabel = n.channel === 'email' ? 'Email' : 'WhatsApp';
            const statusColor = n.status === 'delivered' ? '#38a169' : '#e53e3e';
            return '<div style="display: flex; justify-content: space-between; align-items: center; padding: 0.6rem 0; border-bottom: 1px solid #e2e8f0;">' +
              '<div>' + icon + ' <strong>' + channelLabel + '</strong> → ' + n.recipient + '</div>' +
              '<div style="display: flex; gap: 1rem; align-items: center;">' +
                '<span style="font-size: 0.8rem; color: #718096;">' + new Date(n.created_at).toLocaleString() + '</span>' +
                '<span style="font-size: 0.75rem; font-weight: 700; color: ' + statusColor + '; text-transform: uppercase;">' + n.status + '</span>' +
              '</div>' +
            '</div>';
          }).join('');
        } catch (err) {
          document.getElementById('notificationList').innerHTML = '<p>Failed to load notifications.</p>';
        }
      }

      async function loadPayments() {
        try {
          const res = await fetch('/admin/payments/' + BOOKING_TYPE + '/' + BOOKING_ID + '/summary');
          const data = await res.json();
          if (!data.success) return;
          const s = data.data;
          document.getElementById('payTotalAmount').textContent = fmtLocal(s.totalAmount);
          document.getElementById('payTotalPaid').textContent = fmtLocal(s.totalPaid);
          document.getElementById('payBalance').textContent = fmtLocal(s.balance);
          const statusEl = document.getElementById('payStatus');
          if (s.isFullyPaid) {
            statusEl.textContent = 'PAID IN FULL';
            statusEl.style.color = '#38a169';
          } else if (s.paymentCount > 0) {
            statusEl.textContent = 'PARTIAL';
            statusEl.style.color = '#d69e2e';
          } else {
            statusEl.textContent = 'UNPAID';
            statusEl.style.color = '#e53e3e';
          }
          const tbody = document.getElementById('paymentTableBody');
          if (!s.payments || s.payments.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" class="muted" style="text-align: center;">No payments recorded yet.</td></tr>';
            return;
          }
          const methodLabels = { cash: 'Cash', bank_transfer: 'Bank Transfer', cheque: 'Cheque', credit_card: 'Credit Card', debit_card: 'Debit Card', online: 'Online', other: 'Other' };
          tbody.innerHTML = s.payments.map(p => '<tr>' +
            '<td>' + new Date(p.created_at).toLocaleDateString() + '</td>' +
            '<td><strong>' + (p.invoice_no || '-') + '</strong></td>' +
            '<td>' + (methodLabels[p.payment_method] || p.payment_method) + '</td>' +
            '<td>' + (p.payment_reference || '-') + '</td>' +
            '<td><strong style="color: var(--primary);">' + fmtLocal(p.amount) + '</strong></td>' +
            '<td><span class="badge badge-' + p.payment_status + '">' + p.payment_status.toUpperCase() + '</span></td>' +
            '<td><div style="display: flex; gap: 0.3rem;">' +
              (p.payment_status !== 'refunded' ? '<button onclick="refundPayment(' + p.id + ')" class="btn btn-sm btn-secondary" style="padding: 0.3rem 0.6rem; font-size: 0.75rem;">Refund</button>' : '') +
              '<a href="/admin/payments/record/' + p.id + '/receipt" target="_blank" class="btn btn-sm btn-secondary" style="padding: 0.3rem 0.6rem; font-size: 0.75rem;">Receipt</a>' +
              (p.payment_status !== 'refunded' ? '<button onclick="voidPayment(' + p.id + ')" class="btn btn-sm" style="background: #e53e3e; color: #fff; padding: 0.3rem 0.6rem; font-size: 0.75rem;">Delete</button>' : '') +
            '</div></td>' +
            '</tr>').join('');
        } catch (err) {
          console.error('Failed to load payments:', err);
        }
      }

      function togglePaymentForm() {
        const form = document.getElementById('paymentForm');
        const isVisible = form.style.display !== 'none';
        form.style.display = isVisible ? 'none' : 'block';
        if (!isVisible) {
          const balance = parseFloat(document.getElementById('payBalance').textContent.replace(/[^0-9.-]/g, '')) || 0;
          const localBalance = (balance * CURRENCY_RATE).toFixed(2);
          const symbol = EXCHANGE_RATES[ACTIVE_CURRENCY]?.symbol || '$';
          const firstAmount = document.querySelector('.pay-amount');
          if (firstAmount) {
            firstAmount.placeholder = symbol + localBalance + ' remaining';
            firstAmount.value = '';
          }
          document.getElementById('balanceDisplay').textContent = symbol + localBalance;
          document.getElementById('allocatedAmount').textContent = symbol + '0.00';
        }
      }

      function addPaymentRow() {
        const container = document.getElementById('paymentRows');
        const row = document.createElement('div');
        row.className = 'payment-row';
        row.style.cssText = 'display: grid; grid-template-columns: 2fr 2fr 2fr 1fr; gap: 0.75rem; margin-bottom: 0.75rem; align-items: end;';
        row.innerHTML = '<div><input type="number" step="0.01" min="0.01" class="form-control pay-amount" placeholder="0.00" style="width: 100%;"></div>' +
          '<div><select class="form-control pay-method" style="width: 100%;"><option value="cash">Cash</option><option value="bank_transfer">Bank Transfer</option><option value="cheque">Cheque</option><option value="credit_card">Credit Card</option><option value="debit_card">Debit Card</option><option value="online">Online</option><option value="other">Other</option></select></div>' +
          '<div><input type="text" class="form-control pay-reference" placeholder="Ref / Cheque #" style="width: 100%;"></div>' +
          '<div><button onclick="removePaymentRow(this)" class="btn btn-sm" style="background: #e53e3e; color: #fff; width: 100%;">✕</button></div>';
        container.appendChild(row);
        updateAllocatedAmount();
      }

      function removePaymentRow(btn) {
        const rows = document.querySelectorAll('.payment-row');
        if (rows.length <= 1) return;
        btn.closest('.payment-row').remove();
        updateAllocatedAmount();
      }

      function updateAllocatedAmount() {
        const amounts = document.querySelectorAll('.pay-amount');
        let total = 0;
        amounts.forEach(input => { total += Number(input.value) || 0; });
        const symbol = EXCHANGE_RATES[ACTIVE_CURRENCY]?.symbol || '$';
        document.getElementById('allocatedAmount').textContent = symbol + total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      }

      document.addEventListener('input', function(e) {
        if (e.target.classList.contains('pay-amount')) updateAllocatedAmount();
      });

      async function submitBatchPayments() {
        const rows = document.querySelectorAll('.payment-row');
        const payments = [];
        rows.forEach(row => {
          const amt = row.querySelector('.pay-amount').value;
          const method = row.querySelector('.pay-method').value;
          const ref = row.querySelector('.pay-reference').value;
          if (amt && Number(amt) > 0) {
            payments.push({ amount: toUSD(amt), payment_method: method, payment_reference: ref || null });
          }
        });
        if (payments.length === 0) { alert('Please enter at least one payment amount'); return; }
        const btn = document.getElementById('submitPayBtn');
        btn.textContent = 'Saving...'; btn.disabled = true;
        try {
          const res = await fetch('/admin/payments/' + BOOKING_TYPE + '/' + BOOKING_ID + '/record-batch', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ payments })
          });
          const data = await res.json();
          if (data.success) {
            alert(data.message);
            document.getElementById('paymentRows').innerHTML = '';
            addPaymentRow();
            togglePaymentForm();
            loadPayments();
          } else {
            alert('Error: ' + (data.error || 'Unknown error'));
          }
        } catch (err) {
          alert('Failed to record payments');
        } finally {
          btn.textContent = 'Save Payment(s)'; btn.disabled = false;
        }
      }

      async function voidPayment(paymentId) {
        if (!confirm('Permanently DELETE this payment? This cannot be undone.')) return;
        try {
          const res = await fetch('/admin/payments/record/' + paymentId, { method: 'DELETE' });
          const data = await res.json();
          if (data.success) { alert(data.message); loadPayments(); }
          else { alert('Error: ' + (data.error || 'Unknown error')); }
        } catch (err) { alert('Failed to delete payment'); }
      }

      async function refundPayment(paymentId) {
        const reason = prompt('Reason for refund (optional):');
        if (reason === null) return;
        try {
          const res = await fetch('/admin/payments/record/' + paymentId + '/refund', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ reason: reason || null })
          });
          const data = await res.json();
          if (data.success) { alert(data.message); loadPayments(); }
          else { alert('Error: ' + (data.error || 'Unknown error')); }
        } catch (err) { alert('Failed to process refund'); }
      }

      loadPayments();
      loadNotifications(${flight.id});

      if (PORTAL_TOKEN) {
        const ticketQR = document.getElementById('ticketQR');
        const ticketQRPlaceholder = document.getElementById('ticketQRPlaceholder');
        if (ticketQR) {
          ticketQR.src = '/t/' + PORTAL_TOKEN + '/qr';
          ticketQR.style.display = 'block';
          ticketQRPlaceholder.style.display = 'none';
        }
      }
    </script>
  ` }) %>
</body>
</html>
