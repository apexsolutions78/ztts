<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Zahabia Travel & Tourism</title>
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<body>
  <%- include('../../layout', { body: `
    <div style="margin-bottom: 2rem;">
      <a href="/admin/flights/${flight.id}" class="btn btn-secondary btn-sm">← Back to Flight</a>
      <h1 style="margin-top: 0.5rem;">Edit Flight Booking: ${flight.booking_ref}</h1>
      <p class="muted">Update flight reservation details</p>
    </div>

    <div class="card" style="max-width: 900px;">
      ${typeof error !== 'undefined' && error ? '<div class="alert alert-danger">' + error + '</div>' : ''}

      <form method="post" action="/admin/flights/${flight.id}/edit">
        <div class="form-group">
          <label for="customer_id">Passenger / Customer</label>
          <select id="customer_id" name="customer_id">
            <option value="">-- No Customer --</option>
            ${customers.map(c => '<option value="' + c.id + '" ' + (c.id === flight.customer_id ? 'selected' : '') + '>' + c.full_name + ' (' + (c.email || c.phone || 'No contact') + ')</option>').join('')}
          </select>
        </div>

        <h4 style="margin: 1.5rem 0 0.75rem; font-size: 0.95rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-light);">Trip Details</h4>

        <div class="form-row">
          <div class="form-group">
            <label for="origin">Origin (IATA Code)</label>
            <input type="text" id="origin" name="origin" value="${flight.origin}" required maxlength="3" class="form-control" style="text-transform: uppercase;">
          </div>
          <div class="form-group">
            <label for="destination">Destination (IATA Code)</label>
            <input type="text" id="destination" name="destination" value="${flight.destination}" required maxlength="3" class="form-control" style="text-transform: uppercase;">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="trip_type">Trip Type</label>
            <select id="trip_type" name="trip_type" onchange="toggleReturnDate()">
              <option value="one_way" ${flight.trip_type === 'one_way' ? 'selected' : ''}>One Way</option>
              <option value="round_trip" ${flight.trip_type === 'round_trip' ? 'selected' : ''}>Round Trip</option>
              <option value="multi_city" ${flight.trip_type === 'multi_city' ? 'selected' : ''}>Multi-City</option>
            </select>
          </div>
          <div class="form-group">
            <label for="departure_date">Departure Date & Time</label>
            <input type="datetime-local" id="departure_date" name="departure_date" value="${flight.departure_date ? new Date(flight.departure_date).toISOString().slice(0, 16) : ''}" class="form-control">
          </div>
        </div>

        <div class="form-row" id="returnDateRow" style="${flight.trip_type === 'round_trip' ? 'display: flex;' : 'display: none;'}">
          <div class="form-group">
            <label for="return_date">Return Date & Time</label>
            <input type="datetime-local" id="return_date" name="return_date" value="${flight.return_date ? new Date(flight.return_date).toISOString().slice(0, 16) : ''}" class="form-control">
          </div>
          <div class="form-group"></div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="adults">Adults (12+)</label>
            <input type="number" id="adults" name="adults" value="${flight.adults || 1}" min="1" max="9" class="form-control">
          </div>
          <div class="form-group">
            <label for="children">Children (2–11)</label>
            <input type="number" id="children" name="children" value="${flight.children || 0}" min="0" max="9" class="form-control">
          </div>
          <div class="form-group">
            <label for="infants">Infants (&lt;2)</label>
            <input type="number" id="infants" name="infants" value="${flight.infants || 0}" min="0" max="4" class="form-control">
          </div>
        </div>

        <h4 style="margin: 1.5rem 0 0.75rem; font-size: 0.95rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-light);">Flight Details</h4>

        <div class="form-row">
          <div class="form-group">
            <label for="cabin_class">Cabin Class</label>
            <select id="cabin_class" name="cabin_class">
              <option value="Economy" ${flight.cabin_class === 'Economy' ? 'selected' : ''}>Economy</option>
              <option value="Premium Economy" ${flight.cabin_class === 'Premium Economy' ? 'selected' : ''}>Premium Economy</option>
              <option value="Business" ${flight.cabin_class === 'Business' ? 'selected' : ''}>Business</option>
              <option value="First" ${flight.cabin_class === 'First' ? 'selected' : ''}>First</option>
            </select>
          </div>
          <div class="form-group">
            <label for="preferred_airline">Preferred Airline</label>
            <input type="text" id="preferred_airline" name="preferred_airline" value="${flight.preferred_airline || ''}" class="form-control">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="airline">Confirmed Airline</label>
            <input type="text" id="airline" name="airline" value="${flight.airline || ''}" class="form-control">
          </div>
          <div class="form-group">
            <label for="flight_number">Flight Number</label>
            <input type="text" id="flight_number" name="flight_number" value="${flight.flight_number || ''}" class="form-control">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="arrival_date">Arrival Date & Time</label>
            <input type="datetime-local" id="arrival_date" name="arrival_date" value="${flight.arrival_date ? new Date(flight.arrival_date).toISOString().slice(0, 16) : ''}" class="form-control">
          </div>
          <div class="form-group">
            <label for="direct_transit">Direct / Transit</label>
            <select id="direct_transit" name="direct_transit">
              <option value="any" ${flight.direct_transit === 'any' ? 'selected' : ''}>Any</option>
              <option value="direct" ${flight.direct_transit === 'direct' ? 'selected' : ''}>Direct Only</option>
              <option value="transit_ok" ${flight.direct_transit === 'transit_ok' ? 'selected' : ''}>Transit OK</option>
            </select>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group" style="display: flex; align-items: center; gap: 1rem; padding-top: 1.5rem;">
            <label style="display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
              <input type="checkbox" id="flexible_dates" name="flexible_dates" value="1" ${flight.flexible_dates ? 'checked' : ''}> Flexible Dates
            </label>
            <label style="display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
              <input type="checkbox" id="baggage_priority" name="baggage_priority" value="1" ${flight.baggage_priority ? 'checked' : ''}> Extra Baggage
            </label>
          </div>
          <div class="form-group">
            <label for="budget">Budget (${exchangeRates[activeCurrency]?.symbol || '$'} ${activeCurrency})</label>
            <input type="number" step="0.01" id="budget" name="budget" value="${flight.budget ? (flight.budget * (exchangeRates[activeCurrency]?.rate || 1)).toFixed(2) : ''}" class="form-control">
            <input type="hidden" id="budget_usd" name="budget_usd">
            <p class="muted" style="margin-top: 0.3rem; font-size: 0.8rem;">Exchange rate: 1 USD = ${exchangeRates[activeCurrency]?.rate || 1} ${activeCurrency}</p>
          </div>
        </div>

        <div class="form-group">
          <label for="customer_notes">Internal Notes / Customer Requirements</label>
          <textarea id="customer_notes" name="customer_notes" rows="3" class="form-control">${flight.customer_notes || ''}</textarea>
        </div>

        <div style="background: #f8fafb; padding: 1.25rem; border-radius: var(--radius-md); border: 1px solid var(--border-light); margin-top: 1rem;">
          <h4 style="margin-bottom: 0.75rem; font-size: 0.95rem;">Fare Breakdown (per-passenger pricing)</h4>
          <div class="form-row">
            <div class="form-group">
              <label for="price_per_adult">Price per Adult (${exchangeRates[activeCurrency]?.symbol || '$'} ${activeCurrency})</label>
              <input type="number" step="0.01" id="price_per_adult" name="price_per_adult" value="${flight.price_per_adult ? (flight.price_per_adult * (exchangeRates[activeCurrency]?.rate || 1)).toFixed(2) : ''}" class="form-control" oninput="calcTotal()">
            </div>
            <div class="form-group">
              <label for="price_per_child">Price per Child (${exchangeRates[activeCurrency]?.symbol || '$'} ${activeCurrency})</label>
              <input type="number" step="0.01" id="price_per_child" name="price_per_child" value="${flight.price_per_child ? (flight.price_per_child * (exchangeRates[activeCurrency]?.rate || 1)).toFixed(2) : ''}" class="form-control" oninput="calcTotal()">
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="price_per_infant">Price per Infant (${exchangeRates[activeCurrency]?.symbol || '$'} ${activeCurrency})</label>
              <input type="number" step="0.01" id="price_per_infant" name="price_per_infant" value="${flight.price_per_infant ? (flight.price_per_infant * (exchangeRates[activeCurrency]?.rate || 1)).toFixed(2) : ''}" class="form-control" oninput="calcTotal()">
            </div>
            <div class="form-group">
              <label for="baggage_fee">Extra Baggage Fee (${exchangeRates[activeCurrency]?.symbol || '$'} ${activeCurrency})</label>
              <input type="number" step="0.01" id="baggage_fee" name="baggage_fee" value="${flight.baggage_fee ? (flight.baggage_fee * (exchangeRates[activeCurrency]?.rate || 1)).toFixed(2) : ''}" class="form-control" oninput="calcTotal()">
            </div>
          </div>
          <div style="margin-top: 0.75rem; padding: 0.75rem; background: #edf4f2; border-radius: var(--radius-sm); display: flex; justify-content: space-between; align-items: center;">
            <span style="font-weight: 700; font-size: 0.9rem;">Calculated Total:</span>
            <span id="calcTotalDisplay" style="font-weight: 800; font-size: 1.1rem; color: var(--primary);">${exchangeRates[activeCurrency]?.symbol || '$'} 0</span>
          </div>
          <input type="hidden" id="total_amount" name="total_amount">
          <input type="hidden" id="total_amount_usd" name="total_amount_usd">

          <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border-light);">
            <div class="form-row">
              <div class="form-group">
                <label for="pnr">PNR Code</label>
                <input type="text" id="pnr" name="pnr" value="${flight.pnr || ''}" placeholder="e.g. ABC123" class="form-control">
              </div>
              <div class="form-group"></div>
            </div>
          </div>
        </div>

        <div style="margin-top: 1.5rem; display: flex; gap: 1rem;">
          <button type="submit" class="btn btn-primary">Save Changes</button>
          <a href="/admin/flights/${flight.id}" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>

    <script>
      const EXCHANGE_RATES = ${JSON.stringify(exchangeRates)};
      const ACTIVE_CURRENCY = '${activeCurrency}';
      const CURRENCY_RATE = EXCHANGE_RATES[ACTIVE_CURRENCY]?.rate || 1;
      const CURRENCY_SYMBOL = EXCHANGE_RATES[ACTIVE_CURRENCY]?.symbol || '$';

      function toUSD(localAmount) {
        return (Number(localAmount) / CURRENCY_RATE).toFixed(6);
      }

      function calcTotal() {
        const adults = Number(document.getElementById('adults')?.value) || 0;
        const children = Number(document.getElementById('children')?.value) || 0;
        const infants = Number(document.getElementById('infants')?.value) || 0;
        const ppa = Number(document.getElementById('price_per_adult')?.value) || 0;
        const ppch = Number(document.getElementById('price_per_child')?.value) || 0;
        const ppin = Number(document.getElementById('price_per_infant')?.value) || 0;
        const bg = Number(document.getElementById('baggage_fee')?.value) || 0;
        const total = (adults * ppa) + (children * ppch) + (infants * ppin) + bg;
        document.getElementById('calcTotalDisplay').textContent = CURRENCY_SYMBOL + ' ' + total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        document.getElementById('total_amount').value = total > 0 ? total : '';
      }

      function toggleReturnDate() {
        const tripType = document.getElementById('trip_type').value;
        document.getElementById('returnDateRow').style.display = tripType === 'round_trip' ? 'flex' : 'none';
      }

      document.querySelector('form').addEventListener('submit', function() {
        const amt = document.getElementById('total_amount').value;
        if (amt) document.getElementById('total_amount_usd').value = toUSD(amt);
        const budget = document.getElementById('budget').value;
        if (budget) document.getElementById('budget_usd').value = toUSD(budget);
      });

      calcTotal();
    </script>
  ` }) %>
</body>
</html>
