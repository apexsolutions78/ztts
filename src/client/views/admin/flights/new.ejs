<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Zahabia Travel & Tourism</title>
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<body>
  <%- include('../../layout', { body: `
    <div style="margin-bottom: 2rem;">
      <a href="/admin/flights" class="btn btn-secondary btn-sm">← Back to Flights</a>
      <h1 style="margin-top: 0.5rem;">New Flight Booking</h1>
      <p class="muted">Enter flight itinerary and passenger details to reserve PNR.</p>
    </div>

    <div class="card" style="max-width: 800px;">
      ${typeof error !== 'undefined' && error ? `<div class="alert alert-danger">${error}</div>` : ''}

      <form method="post" action="/admin/flights/new">
        <div class="form-group">
          <label for="customer_id">Select Passenger / Customer</label>
          <select id="customer_id" name="customer_id" required>
            <option value="">-- Choose Existing Customer --</option>
            ${customers.map(c => `<option value="${c.id}">${c.full_name} (${c.passport_number || 'No Passport'}) - ${c.nationality || ''}</option>`).join('')}
          </select>
          <p class="muted" style="margin-top: 0.3rem; font-size: 0.8rem;">Don't see the customer? <a href="/admin/customers">Register customer in CRM first</a>.</p>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="airline">Airline Carrier</label>
            <input type="text" id="airline" name="airline" placeholder="e.g. Emirates, Qatar Airways, Flydubai" required class="form-control">
          </div>
          <div class="form-group">
            <label for="flight_number">Flight Number</label>
            <input type="text" id="flight_number" name="flight_number" placeholder="e.g. EK-201" required class="form-control">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="origin">Origin Airport (3-Letter Code)</label>
            <input type="text" id="origin" name="origin" placeholder="DXB" maxlength="3" required class="form-control" style="text-transform: uppercase;">
          </div>
          <div class="form-group">
            <label for="destination">Destination Airport (3-Letter Code)</label>
            <input type="text" id="destination" name="destination" placeholder="JFK" maxlength="3" required class="form-control" style="text-transform: uppercase;">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="departure_date">Departure Date & Time</label>
            <input type="datetime-local" id="departure_date" name="departure_date" required class="form-control">
          </div>
          <div class="form-group">
            <label for="arrival_date">Arrival Date & Time</label>
            <input type="datetime-local" id="arrival_date" name="arrival_date" required class="form-control">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="cabin_class">Cabin Class</label>
            <select id="cabin_class" name="cabin_class">
              <option value="Economy">Economy Class</option>
              <option value="Premium Economy">Premium Economy</option>
              <option value="Business">Business Class</option>
              <option value="First">First Class</option>
            </select>
          </div>
          <div class="form-group">
            <label for="total_amount">Total Ticket Amount (${exchangeRates[activeCurrency]?.symbol || '$'} ${activeCurrency})</label>
            <input type="number" step="0.01" id="total_amount" name="total_amount" placeholder="0.00" required class="form-control">
            <input type="hidden" id="total_amount_usd" name="total_amount_usd">
            <p class="muted" style="margin-top: 0.3rem; font-size: 0.8rem;">Exchange rate: 1 USD = ${exchangeRates[activeCurrency]?.rate || 1} ${activeCurrency} • Stored as USD</p>
          </div>
        </div>

        <div style="background: #f8fafb; padding: 1.25rem; border-radius: var(--radius-md); border: 1px solid var(--border-light); margin-top: 1rem;">
          <h4 style="margin-bottom: 0.75rem; font-size: 0.95rem;">Initial Payment (Optional)</h4>
          <div class="form-row">
            <div class="form-group">
              <label for="pay_now">Record Payment Now?</label>
              <select id="pay_now" name="pay_now" onchange="togglePayFields()">
                <option value="no">No — Record Later</option>
                <option value="cash">Yes — Cash</option>
                <option value="bank_transfer">Yes — Bank Deposit / Transfer</option>
                <option value="cheque">Yes — Cheque</option>
                <option value="credit_card">Yes — Credit Card</option>
                <option value="debit_card">Yes — Debit Card</option>
                <option value="online">Yes — Online Payment</option>
                <option value="other">Yes — Other</option>
              </select>
            </div>
            <div class="form-group" id="payAmountGroup" style="display: none;">
              <label for="pay_amount">Amount Paid (${exchangeRates[activeCurrency]?.symbol || '$'} ${activeCurrency})</label>
              <input type="number" step="0.01" id="pay_amount" name="pay_amount" placeholder="0.00" class="form-control">
              <input type="hidden" id="pay_amount_usd" name="pay_amount_usd">
            </div>
          </div>
          <div class="form-row" id="payRefRow" style="display: none;">
            <div class="form-group">
              <label for="pay_reference">Reference / Cheque No.</label>
              <input type="text" id="pay_reference" name="pay_reference" placeholder="e.g. Cheque #12345, Transfer Ref" class="form-control">
            </div>
            <div class="form-group">
              <label for="pay_notes">Payment Notes</label>
              <input type="text" id="pay_notes" name="pay_notes" placeholder="Optional" class="form-control">
            </div>
          </div>
        </div>

        <div style="margin-top: 1.5rem; display: flex; gap: 1rem;">
          <button type="submit" class="btn btn-primary">Create Booking & Reserve PNR</button>
          <a href="/admin/flights" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>

    <script>
      const EXCHANGE_RATES = ${JSON.stringify(exchangeRates)};
      const ACTIVE_CURRENCY = '${activeCurrency}';
      const rate = EXCHANGE_RATES[ACTIVE_CURRENCY]?.rate || 1;

      function toUSD(localAmount) {
        return (Number(localAmount) / rate).toFixed(6);
      }

      function togglePayFields() {
        const method = document.getElementById('pay_now').value;
        const show = method !== 'no';
        document.getElementById('payAmountGroup').style.display = show ? 'block' : 'none';
        document.getElementById('payRefRow').style.display = show ? 'flex' : 'none';
      }

      document.querySelector('form[action="/admin/flights/new"]').addEventListener('submit', function() {
        document.getElementById('total_amount_usd').value = toUSD(document.getElementById('total_amount').value);
        const payAmt = document.getElementById('pay_amount').value;
        if (payAmt) document.getElementById('pay_amount_usd').value = toUSD(payAmt);
      });
    </script>
  ` }) %>
</body>
</html>
