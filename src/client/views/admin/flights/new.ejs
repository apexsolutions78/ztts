<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Zahabia Travel & Tourism</title>
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<body>
  <%- include('../../layout', { body: `
    <div style="margin-bottom: 2rem;">
      <a href="/admin/flights" class="btn btn-secondary btn-sm">← Back to Flights</a>
      <h1 style="margin-top: 0.5rem;">New Flight Booking</h1>
      <p class="muted">Create a flight inquiry or confirmed booking.</p>
    </div>

    <div class="card" style="max-width: 800px;">
      ${typeof error !== 'undefined' && error ? '<div class="alert alert-danger">' + error + '</div>' : ''}

      <form method="post" action="/admin/flights/new">

        <div class="form-group">
          <label for="customer_id">Select Passenger / Customer</label>
          <select id="customer_id" name="customer_id">
            <option value="">-- Choose Existing Customer (Optional) --</option>
            ${customers.map(c => '<option value="' + c.id + '">' + c.full_name + ' (' + (c.passport_number || 'No Passport') + ') - ' + (c.nationality || '') + '</option>').join('')}
          </select>
          <p class="muted" style="margin-top: 0.3rem; font-size: 0.8rem;">Don't see the customer? <a href="/admin/customers">Register customer in CRM first</a>.</p>
        </div>

        <h4 style="margin: 1.5rem 0 0.75rem; font-size: 0.95rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-light);">Trip Details</h4>

        <div class="form-row">
          <div class="form-group">
            <label for="origin">Origin Airport (3-Letter Code)</label>
            <input type="text" id="origin" name="origin" placeholder="DXB" maxlength="3" required class="form-control" style="text-transform: uppercase;">
          </div>
          <div class="form-group">
            <label for="destination">Destination Airport (3-Letter Code)</label>
            <input type="text" id="destination" name="destination" placeholder="JFK" maxlength="3" required class="form-control" style="text-transform: uppercase;">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="trip_type">Trip Type</label>
            <select id="trip_type" name="trip_type" onchange="toggleReturnDate()">
              <option value="one_way">One Way</option>
              <option value="round_trip">Round Trip</option>
              <option value="multi_city">Multi-City</option>
            </select>
          </div>
          <div class="form-group">
            <label for="departure_date">Departure Date & Time</label>
            <input type="datetime-local" id="departure_date" name="departure_date" required class="form-control">
          </div>
        </div>

        <div class="form-row" id="returnDateRow" style="display: none;">
          <div class="form-group">
            <label for="return_date">Return Date & Time</label>
            <input type="datetime-local" id="return_date" name="return_date" class="form-control">
          </div>
          <div class="form-group"></div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="adults">Adults (12+)</label>
            <input type="number" id="adults" name="adults" value="1" min="1" max="9" class="form-control">
          </div>
          <div class="form-group">
            <label for="children">Children (2–11)</label>
            <input type="number" id="children" name="children" value="0" min="0" max="9" class="form-control">
          </div>
          <div class="form-group">
            <label for="infants">Infants (&lt;2)</label>
            <input type="number" id="infants" name="infants" value="0" min="0" max="4" class="form-control">
          </div>
        </div>

        <h4 style="margin: 1.5rem 0 0.75rem; font-size: 0.95rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-light);">Flight Details (Optional at Inquiry Stage)</h4>

        <div class="form-row">
          <div class="form-group">
            <label for="cabin_class">Cabin Class</label>
            <select id="cabin_class" name="cabin_class">
              <option value="Economy">Economy Class</option>
              <option value="Premium Economy">Premium Economy</option>
              <option value="Business">Business Class</option>
              <option value="First">First Class</option>
            </select>
          </div>
          <div class="form-group">
            <label for="preferred_airline">Preferred Airline</label>
            <input type="text" id="preferred_airline" name="preferred_airline" placeholder="e.g. Emirates, Qatar Airways" class="form-control">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="airline">Confirmed Airline</label>
            <input type="text" id="airline" name="airline" placeholder="Leave blank if not yet confirmed" class="form-control">
          </div>
          <div class="form-group">
            <label for="flight_number">Flight Number</label>
            <input type="text" id="flight_number" name="flight_number" placeholder="e.g. EK-201" class="form-control">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="arrival_date">Arrival Date & Time</label>
            <input type="datetime-local" id="arrival_date" name="arrival_date" class="form-control">
          </div>
          <div class="form-group">
            <label for="direct_transit">Direct / Transit</label>
            <select id="direct_transit" name="direct_transit">
              <option value="any">Any</option>
              <option value="direct">Direct Only</option>
              <option value="transit_ok">Transit OK</option>
            </select>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group" style="display: flex; align-items: center; gap: 1rem; padding-top: 1.5rem;">
            <label style="display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
              <input type="checkbox" id="flexible_dates" name="flexible_dates" value="1"> Flexible Dates
            </label>
            <label style="display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
              <input type="checkbox" id="baggage_priority" name="baggage_priority" value="1"> Extra Baggage
            </label>
          </div>
          <div class="form-group">
            <label for="budget">Budget (${exchangeRates[activeCurrency]?.symbol || '$'} ${activeCurrency})</label>
            <input type="number" step="0.01" id="budget" name="budget" placeholder="0.00" class="form-control">
            <input type="hidden" id="budget_usd" name="budget_usd">
            <p class="muted" style="margin-top: 0.3rem; font-size: 0.8rem;">Stored as USD. Exchange rate: 1 USD = ${exchangeRates[activeCurrency]?.rate || 1} ${activeCurrency}</p>
          </div>
        </div>

        <div class="form-group">
          <label for="customer_notes">Internal Notes / Customer Requirements</label>
          <textarea id="customer_notes" name="customer_notes" rows="3" placeholder="Visa requirements, special requests, connecting flights, etc." class="form-control"></textarea>
        </div>

        <div style="background: #f8fafb; padding: 1.25rem; border-radius: var(--radius-md); border: 1px solid var(--border-light); margin-top: 1rem;">
          <h4 style="margin-bottom: 0.75rem; font-size: 0.95rem;">Fare Breakdown (per-passenger pricing)</h4>
          <div class="form-row">
            <div class="form-group">
              <label for="price_per_adult">Price per Adult (${exchangeRates[activeCurrency]?.symbol || '$'} ${activeCurrency})</label>
              <input type="number" step="0.01" id="price_per_adult" name="price_per_adult" placeholder="0.00" class="form-control" oninput="calcTotal()">
            </div>
            <div class="form-group">
              <label for="price_per_child">Price per Child (${exchangeRates[activeCurrency]?.symbol || '$'} ${activeCurrency})</label>
              <input type="number" step="0.01" id="price_per_child" name="price_per_child" placeholder="0.00" class="form-control" oninput="calcTotal()">
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="price_per_infant">Price per Infant (${exchangeRates[activeCurrency]?.symbol || '$'} ${activeCurrency})</label>
              <input type="number" step="0.01" id="price_per_infant" name="price_per_infant" placeholder="0.00" class="form-control" oninput="calcTotal()">
            </div>
            <div class="form-group">
              <label for="baggage_fee">Extra Baggage Fee (${exchangeRates[activeCurrency]?.symbol || '$'} ${activeCurrency})</label>
              <input type="number" step="0.01" id="baggage_fee" name="baggage_fee" placeholder="0.00" class="form-control" oninput="calcTotal()">
            </div>
          </div>
          <div style="margin-top: 0.75rem; padding: 0.75rem; background: #edf4f2; border-radius: var(--radius-sm); display: flex; justify-content: space-between; align-items: center;">
            <span style="font-weight: 700; font-size: 0.9rem;">Calculated Total:</span>
            <span id="calcTotalDisplay" style="font-weight: 800; font-size: 1.1rem; color: var(--primary);">${exchangeRates[activeCurrency]?.symbol || '$'} 0</span>
          </div>
          <input type="hidden" id="total_amount" name="total_amount">
          <input type="hidden" id="total_amount_usd" name="total_amount_usd">
          <p class="muted" style="margin-top: 0.5rem; font-size: 0.78rem;">Total auto-calculates from per-passenger prices. Or enter a manual total above.</p>
        </div>

        <div style="background: #f8fafb; padding: 1.25rem; border-radius: var(--radius-md); border: 1px solid var(--border-light); margin-top: 1rem;">
          <h4 style="margin-bottom: 0.75rem; font-size: 0.95rem;">Initial Payment (Optional)</h4>
          <div class="form-row">
            <div class="form-group">
              <label for="pay_now">Record Payment Now?</label>
              <select id="pay_now" name="pay_now" onchange="togglePayFields()">
                <option value="no">No — Record Later</option>
                <option value="cash">Yes — Cash</option>
                <option value="bank_transfer">Yes — Bank Deposit / Transfer</option>
                <option value="cheque">Yes — Cheque</option>
                <option value="credit_card">Yes — Credit Card</option>
                <option value="debit_card">Yes — Debit Card</option>
                <option value="online">Yes — Online Payment</option>
                <option value="other">Yes — Other</option>
              </select>
            </div>
            <div class="form-group" id="payAmountGroup" style="display: none;">
              <label for="pay_amount">Amount Paid (${exchangeRates[activeCurrency]?.symbol || '$'} ${activeCurrency})</label>
              <input type="number" step="0.01" id="pay_amount" name="pay_amount" placeholder="0.00" class="form-control">
              <input type="hidden" id="pay_amount_usd" name="pay_amount_usd">
            </div>
          </div>
          <div class="form-row" id="payRefRow" style="display: none;">
            <div class="form-group">
              <label for="pay_reference">Reference / Cheque No.</label>
              <input type="text" id="pay_reference" name="pay_reference" placeholder="e.g. Cheque #12345, Transfer Ref" class="form-control">
            </div>
            <div class="form-group">
              <label for="pay_notes">Payment Notes</label>
              <input type="text" id="pay_notes" name="pay_notes" placeholder="Optional" class="form-control">
            </div>
          </div>
        </div>

        <div style="margin-top: 1.5rem; display: flex; gap: 1rem;">
          <button type="submit" class="btn btn-primary">Create Booking</button>
          <a href="/admin/flights" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>

    <script>
      const EXCHANGE_RATES = ${JSON.stringify(exchangeRates)};
      const ACTIVE_CURRENCY = '${activeCurrency}';
      const rate = EXCHANGE_RATES[ACTIVE_CURRENCY]?.rate || 1;
      const CURRENCY_SYMBOL = EXCHANGE_RATES[ACTIVE_CURRENCY]?.symbol || '$';

      function toUSD(localAmount) {
        return (Number(localAmount) / rate).toFixed(6);
      }

      function calcTotal() {
        const adults = Number(document.getElementById('adults')?.value) || 0;
        const children = Number(document.getElementById('children')?.value) || 0;
        const infants = Number(document.getElementById('infants')?.value) || 0;
        const ppa = Number(document.getElementById('price_per_adult')?.value) || 0;
        const ppch = Number(document.getElementById('price_per_child')?.value) || 0;
        const ppin = Number(document.getElementById('price_per_infant')?.value) || 0;
        const bg = Number(document.getElementById('baggage_fee')?.value) || 0;
        const total = (adults * ppa) + (children * ppch) + (infants * ppin) + bg;
        document.getElementById('calcTotalDisplay').textContent = CURRENCY_SYMBOL + ' ' + total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        document.getElementById('total_amount').value = total > 0 ? total : '';
      }

      function toggleReturnDate() {
        const tripType = document.getElementById('trip_type').value;
        document.getElementById('returnDateRow').style.display = tripType === 'round_trip' ? 'flex' : 'none';
      }

      function togglePayFields() {
        const method = document.getElementById('pay_now').value;
        const show = method !== 'no';
        document.getElementById('payAmountGroup').style.display = show ? 'block' : 'none';
        document.getElementById('payRefRow').style.display = show ? 'flex' : 'none';
      }

      document.querySelector('form[action="/admin/flights/new"]').addEventListener('submit', function() {
        const amt = document.getElementById('total_amount').value;
        if (amt) document.getElementById('total_amount_usd').value = toUSD(amt);
        const budget = document.getElementById('budget').value;
        if (budget) document.getElementById('budget_usd').value = toUSD(budget);
        const payAmt = document.getElementById('pay_amount').value;
        if (payAmt) document.getElementById('pay_amount_usd').value = toUSD(payAmt);
      });
    </script>
  ` }) %>
</body>
</html>
