<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Operator Login | Zahabia Travel</title>
  <link rel="icon" type="image/png" href="/brand/LOGO123.png">
  <link rel="stylesheet" href="/static/css/app.css">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Plus Jakarta Sans', sans-serif; min-height: 100vh; display: flex; align-items: center; justify-content: center; background: #060d18; padding: 1rem; overflow: hidden; position: relative; }

    /* Dark tech background */
    .admin-bg { position: absolute; inset: 0; z-index: 0; overflow: hidden; }
    .admin-bg::before {
      content: ''; position: absolute; inset: 0;
      background:
        radial-gradient(ellipse 60% 50% at 50% 0%, rgba(5,68,59,0.25) 0%, transparent 60%),
        radial-gradient(ellipse 40% 40% at 80% 80%, rgba(212,175,55,0.06) 0%, transparent 50%);
    }
    .admin-bg .grid-lines {
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(8,107,94,0.06) 1px, transparent 1px),
        linear-gradient(90deg, rgba(8,107,94,0.06) 1px, transparent 1px);
      background-size: 60px 60px;
      mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 30%, transparent 70%);
    }
    .admin-bg .glow { position: absolute; width: 600px; height: 600px; border-radius: 50%; filter: blur(120px); opacity: 0.15; }
    .admin-bg .glow-1 { background: #05443b; top: -30%; left: -10%; animation: gFloat 15s ease-in-out infinite; }
    .admin-bg .glow-2 { background: rgba(212,175,55,0.4); bottom: -25%; right: -5%; animation: gFloat 18s ease-in-out infinite reverse; }
    @keyframes gFloat { 0%,100%{transform:translate(0,0)} 50%{transform:translate(20px,-15px)} }

    /* Card */
    .admin-wrapper { position: relative; z-index: 1; width: 100%; max-width: 400px; }
    .admin-card {
      background: rgba(6,18,30,0.8); backdrop-filter: blur(30px); -webkit-backdrop-filter: blur(30px);
      border: 1px solid rgba(8,107,94,0.18); border-radius: 20px;
      overflow: hidden; box-shadow: 0 25px 60px rgba(0,0,0,0.5);
    }

    /* Header */
    .admin-header {
      padding: 2.5rem 2rem 1.5rem; text-align: center;
      background: linear-gradient(180deg, rgba(212,175,55,0.06) 0%, transparent 100%);
    }
    .admin-avatar {
      width: 80px; height: 80px; border-radius: 50%; margin: 0 auto 1.2rem;
      position: relative; display: flex; align-items: center; justify-content: center;
    }
    .admin-avatar-ring {
      position: absolute; inset: -3px; border-radius: 50%;
      border: 2px solid transparent;
      border-top-color: #d4af37; border-bottom-color: #d4af37;
      border-left-color: rgba(212,175,55,0.2); border-right-color: rgba(212,175,55,0.2);
      animation: ringSpin 4s linear infinite;
    }
    @keyframes ringSpin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    .admin-avatar-inner {
      width: 100%; height: 100%; border-radius: 50%;
      background: linear-gradient(135deg, #0b192c 0%, #05443b 100%);
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 0 25px rgba(212,175,55,0.1);
    }
    .admin-avatar-inner svg { width: 36px; height: 36px; }

    .admin-badge {
      display: inline-flex; align-items: center; gap: 0.4rem;
      padding: 0.3rem 0.9rem; border-radius: 9999px;
      background: rgba(212,175,55,0.1); border: 1px solid rgba(212,175,55,0.2);
      font-size: 0.68rem; font-weight: 700; color: #d4af37;
      text-transform: uppercase; letter-spacing: 1.5px; margin-top: 1rem;
    }
    .admin-badge .dot { width: 5px; height: 5px; border-radius: 50%; background: #d4af37; animation: pulse 2s infinite; }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }

    .admin-card-title { font-family: 'Outfit', sans-serif; font-size: 1.4rem; font-weight: 700; color: #e8f0ed; margin-top: 0.8rem; }
    .admin-card-subtitle { font-size: 0.85rem; color: #5c7370; margin-top: 0.2rem; }

    /* Form */
    .admin-form { padding: 1.5rem 2rem 2rem; }
    .admin-form .form-group { margin-bottom: 1.1rem; }
    .admin-form label { display: block; font-size: 0.72rem; font-weight: 600; color: #5c7370; margin-bottom: 0.4rem; text-transform: uppercase; letter-spacing: 1px; }
    .admin-form .form-control {
      width: 100%; padding: 0.75rem 1rem;
      background: rgba(6,13,24,0.6); border: 1.5px solid rgba(8,107,94,0.2);
      border-radius: 10px; font-size: 0.9rem; font-family: inherit;
      color: #e8f0ed; transition: all 0.25s;
    }
    .admin-form .form-control::placeholder { color: #3a5c52; }
    .admin-form .form-control:focus { outline: none; border-color: #d4af37; box-shadow: 0 0 0 3px rgba(212,175,55,0.08); }
    .admin-form .btn-submit {
      width: 100%; padding: 0.8rem; font-size: 0.92rem; font-weight: 700;
      background: linear-gradient(135deg, #d4af37 0%, #b89628 100%);
      color: #060d18; border: none; border-radius: 10px; cursor: pointer;
      transition: all 0.3s; font-family: inherit; margin-top: 0.5rem;
    }
    .admin-form .btn-submit:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(212,175,55,0.3); }
    .admin-error { background: rgba(229,62,62,0.08); color: #fc8181; padding: 0.65rem 1rem; border-radius: 10px; font-size: 0.82rem; margin-bottom: 1rem; border-left: 3px solid #e53e3e; }
    .admin-success { background: rgba(56,161,105,0.08); color: #68d391; padding: 0.65rem 1rem; border-radius: 10px; font-size: 0.82rem; margin-bottom: 1rem; border-left: 3px solid #38a169; }
    .code-input { font-size: 1.8rem; text-align: center; letter-spacing: 10px; font-weight: bold; padding: 0.85rem !important; }
    .back-link { display: inline-flex; align-items: center; gap: 0.3rem; margin-top: 1rem; color: #5c7370; font-size: 0.82rem; text-decoration: none; cursor: pointer; transition: color 0.2s; }
    .back-link:hover { color: #d4af37; }

    .admin-footer { text-align: center; padding: 1rem 2rem; border-top: 1px solid rgba(8,107,94,0.1); }
    .admin-footer p { font-size: 0.75rem; color: #3a5c52; }
    .admin-footer a { color: #5c7370; text-decoration: none; transition: color 0.2s; }
    .admin-footer a:hover { color: #d4af37; }
  </style>
</head>
<body>
  <!-- Background -->
  <div class="admin-bg">
    <div class="grid-lines"></div>
    <div class="glow glow-1"></div>
    <div class="glow glow-2"></div>
  </div>

  <div class="admin-wrapper">
    <div class="admin-card">
      <!-- Header with Avatar -->
      <div class="admin-header">
        <div class="admin-avatar">
          <div class="admin-avatar-ring"></div>
          <div class="admin-avatar-inner">
            <svg viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2L2 7l10 5 10-5-10-5z"/>
              <path d="M2 17l10 5 10-5"/>
              <path d="M2 12l10 5 10-5"/>
            </svg>
          </div>
        </div>
        <div class="admin-badge"><span class="dot"></span> Operator Portal</div>
        <h1 class="admin-card-title">Operations Center</h1>
        <p class="admin-card-subtitle">Sign in to manage bookings & flights</p>
      </div>

      <!-- Form -->
      <div class="admin-form">
        <% if (error) { %>
          <div class="admin-error"><%= error %></div>
        <% } %>
        <% if (message) { %>
          <div class="admin-success"><%= message %></div>
        <% } %>

        <% if (step === 'email') { %>
          <form method="post" action="/auth/login">
            <input type="hidden" name="next" value="<%= next %>">
            <div class="form-group">
              <label>Email Address</label>
              <input type="email" id="email" name="email" class="form-control" placeholder="operator@zahabiatravel.com" required autocomplete="email" value="<%= email %>">
            </div>
            <button type="submit" class="btn-submit">Continue →</button>
          </form>

        <% } else if (step === 'password') { %>
          <form method="post" action="/auth/login">
            <input type="hidden" name="next" value="<%= next %>">
            <input type="hidden" name="email" value="<%= email %>">
            <div class="form-group">
              <label>Password</label>
              <input type="password" id="password" name="password" class="form-control" placeholder="Enter your password" required autocomplete="current-password">
            </div>
            <button type="submit" class="btn-submit">Sign In</button>
          </form>
          <a class="back-link" onclick="history.back()">← Use a different email</a>

        <% } else if (step === 'code') { %>
          <form method="post" action="/auth/verify">
            <input type="hidden" name="next" value="<%= next %>">
            <input type="hidden" name="email" value="<%= email %>">
            <div class="form-group">
              <label>Verification Code</label>
              <input type="text" id="code" name="code" class="form-control code-input" placeholder="000000" required maxlength="6" pattern="[0-9]{6}" inputmode="numeric" autocomplete="one-time-code">
            </div>
            <button type="submit" class="btn-submit">Verify Code</button>
          </form>
          <a class="back-link" onclick="history.back()">← Use a different email</a>

        <% } else if (step === 'create-password') { %>
          <form method="post" action="/auth/create-password">
            <input type="hidden" name="next" value="<%= next %>">
            <input type="hidden" name="email" value="<%= email %>">
            <input type="hidden" name="code" value="<%= code %>">
            <div class="form-group">
              <label>Create Password</label>
              <input type="password" id="password" name="password" class="form-control" placeholder="Min 6 characters" required minlength="6">
            </div>
            <div class="form-group">
              <label>Confirm Password</label>
              <input type="password" id="confirm_password" name="confirm_password" class="form-control" placeholder="Re-enter password" required minlength="6">
            </div>
            <button type="submit" class="btn-submit">Create Password & Sign In</button>
          </form>
        <% } %>
      </div>

      <div class="admin-footer">
        <p><a href="/">← Zahabia Travel Home</a></p>
      </div>
    </div>
  </div>
</body>
</html>
