<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Zahabia Travel & Tourism | Premium Air Ticketing & Tour Packages</title>
  <meta name="description" content="Zahabia Travel & Tourism — Premium air ticketing, luxury tour packages, Umrah trips, and vacation experiences. Book with Apex Solutions.">
  <link rel="icon" type="image/png" href="/brand/LOGO123.png">
  <link rel="stylesheet" href="/static/css/app.css">
  <style>
    .hero {
      background: linear-gradient(135deg, #ffffff 0%, #f4f7f6 50%, #e8f0ed 100%);
      color: #102a27;
      padding: 4rem 2rem;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute;
      top: -50%;
      left: -25%;
      width: 150%;
      height: 200%;
      background: radial-gradient(ellipse, rgba(212,175,55,0.05) 0%, transparent 70%);
      pointer-events: none;
    }
    .hero h1 { font-size: 3rem; color: #102a27; margin-bottom: 0.5rem; }
    .hero .gold { color: var(--accent-gold); }
    .hero p { font-size: 1.15rem; color: #5c7370; max-width: 600px; margin: 0.5rem auto 2rem; }
    .hero-img { height: 100px; border-radius: 16px; margin-bottom: 1.5rem; }
    .section { max-width: 1100px; margin: 3rem auto; padding: 0 1.5rem; }
    .section-title { text-align: center; margin-bottom: 2rem; }
    .tour-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; }
    .tour-card {
      display: flex;
      flex-direction: column;
      border-radius: var(--radius-lg);
      overflow: hidden;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      border: 1px solid var(--border-light);
      background: #fff;
    }
    .tour-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    }
    .tour-card .tour-img {
      height: 260px;
      background: linear-gradient(135deg, #e2ece9 0%, #c5d8d2 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 4rem;
      overflow: hidden;
      position: relative;
    }
    .tour-card .tour-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
    .tour-card:hover .tour-img img { transform: scale(1.05); }
    .tour-card .tour-img .duration-badge {
      position: absolute;
      top: 1rem;
      right: 1rem;
      background: rgba(16,42,39,0.85);
      color: #fff;
      padding: 0.4rem 0.8rem;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 700;
      backdrop-filter: blur(4px);
    }
    .tour-card .tour-body { padding: 1.5rem; flex: 1; display: flex; flex-direction: column; }
    .tour-card .tour-dest {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      font-size: 0.8rem;
      color: var(--accent-gold);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 0.5rem;
    }
    .tour-card .tour-body h3 {
      font-size: 1.2rem;
      margin: 0 0 0.5rem;
      line-height: 1.3;
      color: var(--primary-dark);
    }
    .tour-card .tour-desc {
      font-size: 0.88rem;
      color: var(--text-muted);
      line-height: 1.6;
      flex: 1;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
      margin-bottom: 1rem;
    }
    .tour-card .tour-footer {
      padding-top: 1rem;
      border-top: 1px solid var(--border-light);
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
    }
    .tour-card .tour-price-label {
      font-size: 0.7rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .tour-card .tour-price {
      font-family: var(--font-heading);
      font-size: 1.5rem;
      font-weight: 800;
      color: var(--primary);
      line-height: 1.2;
    }
    .tour-card .tour-per {
      font-size: 0.75rem;
      color: var(--text-muted);
    }
    .tour-card .tour-book-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0.6rem 1.2rem;
      background: var(--primary);
      color: #fff;
      border: none;
      border-radius: var(--radius-sm);
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      transition: background 0.2s;
    }
    .tour-card .tour-book-btn:hover { background: var(--primary-dark); }
    .features { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; margin-top: 2rem; }
    .feature-card { text-align: center; padding: 2rem 1.5rem; }
    .feature-icon { font-size: 2.5rem; margin-bottom: 1rem; }
    .cta-section {
      background: linear-gradient(135deg, var(--primary-dark) 0%, var(--bg-dark) 100%);
      color: #fff;
      padding: 3rem 2rem;
      text-align: center;
      border-radius: var(--radius-lg);
      margin: 3rem auto;
      max-width: 800px;
    }
    .cta-section h2 { color: #fff; margin-bottom: 0.5rem; }
    .cta-section p { color: #a0aec0; margin-bottom: 1.5rem; }
    .footer-public {
      background: var(--bg-dark);
      color: #a0aec0;
      padding: 2rem;
      text-align: center;
      font-size: 0.85rem;
    }
    .footer-public a { color: var(--accent-gold); text-decoration: none; }
    @media (max-width: 860px) {
      .hero h1 { font-size: 2rem; }
      .hero p { font-size: 1rem; }
    }
  </style>
</head>
<body>
  <!-- Hero Section -->
  <div class="hero">
    <img src="/brand/Golden_airplane_circling_globe_20260914222838.gif" alt="Zahabia Travel" class="hero-img" onerror="this.src='/brand/LOGO123.png';">
    <h1><span class="gold">ZAHABIA</span> TRAVEL & TOURISM</h1>
    <p>Premium air ticketing, luxury tour packages, Umrah pilgrimages, and unforgettable vacation experiences — powered by Apex Solutions.</p>
    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
      <a href="/auth/login" class="btn btn-accent" style="padding: 0.85rem 2rem; font-size: 1rem;">Operator Login →</a>
      <a href="#packages" class="btn btn-secondary" style="padding: 0.85rem 2rem; font-size: 1rem; background: rgba(0,0,0,0.05); color: #102a27;">View Packages ↓</a>
    </div>
  </div>

  <!-- Features Section -->
  <div class="section">
    <div class="section-title">
      <p class="eyebrow">Why Choose Zahabia</p>
      <h2>World-Class Travel Services</h2>
    </div>
    <div class="features">
      <div class="card feature-card">
        <div class="feature-icon">✈</div>
        <h3>Air Ticketing</h3>
        <p class="muted">Economy, Business, and First Class tickets with Emirates, Qatar Airways, Flydubai, and more. Instant e-ticket issuance.</p>
      </div>
      <div class="card feature-card">
        <div class="feature-icon">🌴</div>
        <h3>Luxury Tour Packages</h3>
        <p class="muted">Desert safaris, Maldives overwater villas, European adventures — curated experiences with 5-star accommodations.</p>
      </div>
      <div class="card feature-card">
        <div class="feature-icon">🕌</div>
        <h3>Umrah & Hajj</h3>
        <p class="muted">Premium Umrah packages with 5-star clock tower hotels in Makkah and front-row Madinah accommodations.</p>
      </div>
      <div class="card feature-card">
        <div class="feature-icon">📱</div>
        <h3>Digital E-Tickets</h3>
        <p class="muted">Receive your e-ticket via email and WhatsApp. View, print, or share your itinerary with a secure portal link.</p>
      </div>
    </div>
  </div>

  <!-- Tour Packages Section -->
  <div class="section" id="packages">
    <div class="section-title">
      <p class="eyebrow">Featured Packages</p>
      <h2>Explore Our Tour Collection</h2>
    </div>
    <div class="tour-grid">
      <% if (typeof packages !== 'undefined' && packages.length > 0) { %>
        <% packages.forEach(p => { %>
          <div class="card tour-card">
            <div class="tour-img">
              <% if (p.image_url && p.image_url !== '/static/img/default_tour.jpg') { %>
                <img src="<%= p.image_url %>" alt="<%= p.title %>">
              <% } else { %>
                🌴
              <% } %>
              <span class="duration-badge"><%= p.duration_days %> Days</span>
            </div>
            <div class="tour-body">
              <span class="tour-dest">📍 <%= p.destination %></span>
              <h3><%= p.title %></h3>
              <p class="tour-desc"><%= p.description || 'An amazing travel experience curated by Zahabia Travel & Tourism.' %></p>
              <div class="tour-footer">
                <div>
                  <div class="tour-price-label">Starting from</div>
                  <div class="tour-price"><%= formatPrice(p.price) %></div>
                  <div class="tour-per">per person</div>
                </div>
                <a href="#packages" class="tour-book-btn">View Details →</a>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="card" style="grid-column: 1 / -1; text-align: center; padding: 3rem;">
          <h3> Tours Coming Soon</h3>
          <p class="muted">We're curating amazing travel experiences. Check back soon!</p>
        </div>
      <% } %>
    </div>
  </div>

  <!-- CTA Section -->
  <div class="section">
    <div class="cta-section">
      <h2>Ready to Book Your Journey?</h2>
      <p>Contact our team or log in to the operator portal to manage your bookings.</p>
      <a href="mailto:support@zahabiatravel.com" class="btn btn-accent">Contact Support</a>
    </div>
  </div>

  <!-- Footer -->
  <div class="footer-public">
    <p>&copy; 2026 Zahabia Travel & Tourism. All rights reserved. Powered by <a href="#">Apex Solutions</a>.</p>
    <p style="margin-top: 0.5rem;">📧 support@zahabiatravel.com | ✈ Premium Air Ticketing & Tour Management</p>
  </div>
</body>
</html>
